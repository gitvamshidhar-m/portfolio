{
  "rewrites": [
    { "source": "/api/agentic/stt", "destination": "/api/agentic?sub=stt" },
    { "source": "/api/agentic/tts", "destination": "/api/agentic?sub=tts" },
    { "source": "/api/agentic/follow", "destination": "/api/agentic?sub=follow" },
    { "source": "/api/agentic/section", "destination": "/api/agentic?sub=section" },
    { "source": "/api/agentic/pdf", "destination": "/api/agentic?sub=pdf" }
  ],
  "redirects": [
    {
      "source": "/(.*\\.html)/",
      "destination": "/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:css|js|woff2|woff|ttf|svg|png|jpg|jpeg|webp|avif|ico|txt|xml|json))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
