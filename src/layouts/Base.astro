---
import '../styles/global.css';
import Search from '../components/Search.astro';
import LivePulse from '../components/LivePulse.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  variant?: 'index' | 'sub';
  active?: string;
  mixin?: boolean;
}

const {
  title, description, canonical, ogImage = '/og.png',
  variant = 'index', active = '', mixin = true,
} = Astro.props;

const site = 'https://vamshidharm.vercel.app';
const url = canonical.startsWith('http') ? canonical : site + canonical;
const pagePath = '/' + canonical.replace(/^https?:\/\/[^\/]+/, '').replace(/^\//, '');
const isBlogPage = Boolean(canonical.match(/\/blog\/.+/));

const indexLinks = [
  ['about.html', 'About'], ['blog.html', 'Blog'], ['projects.html', 'Projects'], ['hire.html', 'Hire Me'], ['contact.html', 'Contact'],
];
const indexMore = [
  ['projects.html#demos', 'Demos'], ['experience.html', 'Experience'], ['skills.html', 'Skills'],
  ['faq.html', 'FAQ'], ['#insights', 'ROI'], ['/one-pager.html', 'One-pagers'], ['/changelog.html', 'Changelog'],
];
const subLinks = [
  ['/', 'Home'], ['/about.html', 'About'], ['/blog.html', 'Blog'], ['/projects.html', 'Projects'],
  ['/projects.html#demos', 'Demos'], ['/skills.html', 'Skills'], ['/experience.html', 'Experience'], ['/faq.html', 'FAQ'], ['/hire.html', 'Hire Me'], ['/changelog.html', 'Changelog'], ['/contact.html', 'Contact'],
];
const links = variant === 'index' ? indexLinks : subLinks;
const moreLinks = variant === 'index' ? indexMore : [];
const toolsLinks = [
  ['/audit.html', 'Audit campaign'], ['/case-study.html', 'Case study'], ['/projects.html#demos', 'Live demos'],
];
const agentsLinks = [
  ['/agentic-ai.html', '⚡ Hive'], ['/grapevine.html', '🛎 Grapevine'], ['/content.html', '📝 Content Engine'], ['/gtm.html', '🚀 GTM Agent'],
];

// Breadcrumb trail for sub pages
const crumbLabel = (() => {
  if (isBlogPage) return 'Blog';
  if (/blog\.html$/.test(canonical)) return 'Blog';
  if (/admin\.html$/.test(canonical)) return 'Dashboard';
  if (/resume\.html$/.test(canonical)) return 'Resume';
  const map = { about: 'About', projects: 'Projects', skills: 'Skills', experience: 'Experience', faq: 'FAQ', contact: 'Contact', hire: 'Hire Me', changelog: 'Changelog', content: 'Content Engine' };
  const key = canonical.match(/\/([a-z-]+)\.html$/);
  return (key && map[key[1]]) || title;
})();

const crumbItems = variant === 'sub' ? [
  { label: 'Home', url: site + '/' },
  ...(isBlogPage ? [{ label: 'Blog', url: site + '/blog.html' }] : []),
  { label: crumbLabel, url }
] : [];

const breadcrumbLd = variant === 'sub' && crumbItems.length > 0
  ? JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: crumbItems.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.url }))
    })
  : '';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Person',
  name: 'Vamshidhar Reddy M', url: site + '/',
  jobTitle: 'Performance Marketer & AI Tool Builder',
  email: 'geovamshidhar@gmail.com', telephone: '+91-7981719085',
  address: { '@type': 'PostalAddress', addressLocality: 'Hyderabad', addressCountry: 'IN' },
  sameAs: ['https://linkedin.com/in/vamshidharreddym', 'https://github.com/gitvamshidhar-m'],
});
const ogUrl = ogImage
  ? site + ogImage
  : site + '/api/og?t=' + encodeURIComponent(title) + '&d=' + encodeURIComponent(description);

