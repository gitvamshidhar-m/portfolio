{
  mixin && (
    <script is:inline>
      const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;      const tb = document.getElementById('themeBtn'), html = document.documentElement;
      function toggleTheme() { const d = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'; html.setAttribute('data-theme', d); if (tb) tb.textContent = d === 'dark' ? '🌙' : '☀️'; try { localStorage.setItem('don-theme', d); } catch (e) {} }
      if (tb) { tb.addEventListener('click', toggleTheme); tb.textContent = html.getAttribute('data-theme') === 'dark' ? '🌙' : '☀️'; }
      const mb = document.getElementById('menuBtn'), mm = document.getElementById('mmenu');
      if (mb && mm) { mb.addEventListener('click', () => { const on = mm.classList.toggle('on'); mb.textContent = on ? '✕' : '☰'; mb.setAttribute('aria-label', on ? 'Close menu' : 'Open menu'); }); mm.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { mm.classList.remove('on'); mb.textContent = '☰'; mb.setAttribute('aria-label', 'Open menu'); })); }
      if (!window.__navMoreInit) {
        window.__navMoreInit = true;
        document.addEventListener('click', function (e) {
          const btn = e.target.closest('.nav-more-btn');
          if (btn) {
            const nm = btn.closest('.nav-more');
            if (nm) { e.stopPropagation(); const on = nm.classList.toggle('open'); btn.setAttribute('aria-expanded', on ? 'true' : 'false'); return; }
          }
          if (!e.target.closest('.nav-more')) {
            document.querySelectorAll('.nav-more.open').forEach(function (n) { n.classList.remove('open'); const b = n.querySelector('.nav-more-btn'); if (b) b.setAttribute('aria-expanded', 'false'); });
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { document.querySelectorAll('.nav-more.open').forEach(function (n) { n.classList.remove('open'); const b = n.querySelector('.nav-more-btn'); if (b) b.setAttribute('aria-expanded', 'false'); }); }
        });
      }
      const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('on'); e.target.querySelectorAll('.count').forEach(c => { if (!c.dataset.done) { c.dataset.done = 1; countUp(c); } }); e.target.querySelectorAll('.bar i').forEach(b => { b.style.width = b.dataset.w + '%'; }); io.unobserve(e.target); } }), { threshold: .15 });
      document.querySelectorAll('.reveal').forEach(x => io.observe(x));
      function countUp(c) { const t = +(c.dataset.target), suf = c.dataset.suffix || ''; let n = 0; const step = Math.max(1, t / 60); const iv = setInterval(() => { n += step; if (n >= t) { n = t; clearInterval(iv); } c.textContent = Math.floor(n) + (suf || ''); }, 24); }
      document.querySelectorAll('.status-badge').forEach(b => { fetch(b.dataset.url, { method: 'HEAD', mode: 'no-cors', cache: 'no-store' }).then(() => { b.className = 'status-badge live'; b.innerHTML = '<span class="sdot"></span>Live'; }).catch(() => { b.className = 'status-badge down'; b.innerHTML = '<span class="sdot"></span>Unreachable'; }); });
      function ea(name, label) { try { if (window.va) { window.va('event', { name: name, label: label || '' }); } } catch (e) {} }
      document.querySelectorAll('a[href^="tel:"]').forEach(ph => { ph.addEventListener('click', function () { ea('phone_tap', ''); const n = ph.getAttribute('href').replace('tel:', ''); if (!/(iPhone|iPad|iPod|Android)/i.test(navigator.userAgent) && navigator.clipboard) { navigator.clipboard.writeText(n).then(() => { const old = ph.innerHTML; ph.innerHTML = '📋 Copied ' + n; setTimeout(() => { ph.innerHTML = old; }, 1600); }).catch(() => {}); } }); });
      document.querySelectorAll('a[href^="https://mail.google.com/mail/"]').forEach(g => g.addEventListener('click', () => ea('gmail', 'compose')));
      document.querySelectorAll('a[aria-label="LinkedIn"]').forEach(x => x.addEventListener('click', () => ea('social', 'linkedin')));
      document.querySelectorAll('a[aria-label="GitHub"]').forEach(x => x.addEventListener('click', () => ea('social', 'github')));
      function clock2() { const t = new Date().toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour12: true }); const e = document.getElementById('clock2'); if (e) e.textContent = t; const c = document.getElementById('clock'); if (c) c.textContent = '⏱ ' + t; } clock2(); setInterval(clock2, 1000);
      const prog = document.getElementById('progress');
      if (prog && !window.__hasProgress) {
        window.__hasProgress = true;
        const onScroll = () => { const h = document.documentElement, st = h.scrollTop, doc = h.scrollHeight - h.clientHeight; prog.style.width = (doc > 0 ? (st / doc) * 100 : 0) + '%'; };
        addEventListener('scroll', onScroll, { passive: true }); onScroll();
      }
      if ('serviceWorker' in navigator && !window.__swRegistered) {
        window.__swRegistered = true;
        addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
      }
      if (!window.__analyticsFired) {
        window.__analyticsFired = true;
        fetch('/api/analytics', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: location.pathname, referrer: document.referrer, ua: navigator.userAgent }) }).catch(() => {});
      }
      /* ---- newsletter open + submit ---- */
      (function () {
        const openBtn = document.getElementById('newsletterOpen');
        const cap = document.getElementById('exitCapture');
        if (openBtn && cap) openBtn.addEventListener('click', function () { showCap('newsletter'); });
        const f = document.getElementById('capForm');
        if (f) f.addEventListener('submit', function (e) {
          e.preventDefault();
          const msg = document.getElementById('capMsg'); if (!msg) return;
          const btn = f.querySelector('button[type=submit]'); if (btn) btn.disabled = true;
          const body = {}; new FormData(f).forEach(function (v, k) { if (v) body[k] = v; });
          fetch('/api/capture', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
            .then(function (r) { return r.json(); })
            .then(function (j) {
              if (j && j.captured) { msg.hidden = false; msg.className = 'formmsg ok'; msg.textContent = 'Got it — check your inbox shortly. Talk soon.'; f.querySelector('input[type=email]').value = ''; }
              else { msg.hidden = false; msg.className = 'formmsg err'; msg.textContent = 'Something went wrong — email geovamshidhar@gmail.com directly.'; }
            })
            .catch(function () { msg.hidden = false; msg.className = 'formmsg err'; msg.textContent = 'Could not save — email geovamshidhar@gmail.com directly.'; })
            .then(function () { if (btn) btn.disabled = false; });
        });
      })();
      /* ---- exit-intent / scroll-depth capture ---- */
      function showCap(src) {
        const cap = document.getElementById('exitCapture'); if (!cap) return;
        try { localStorage.setItem('capShown', '1'); } catch (e) {}
        cap.hidden = false; cap.setAttribute('aria-hidden', 'false');
        const srcIn = cap.querySelector('input[name=source]'); if (srcIn) srcIn.value = src;
      }
      (function () {
        const cap = document.getElementById('exitCapture'); if (!cap) return;
        let shown = false;
        try { if (localStorage.getItem('capShown')) shown = true; } catch (e) {}
        if (shown) return;
        const closeBtn = document.getElementById('capClose');
        if (closeBtn) closeBtn.addEventListener('click', function () { cap.hidden = true; });
        cap.addEventListener('click', function (e) { if (e.target === cap) cap.hidden = true; });
        let scrolled = false;
        addEventListener('scroll', function () {
          if (scrolled || shown) return;
          const h = document.documentElement, st = h.scrollTop, doc = h.scrollHeight - h.clientHeight;
          if (doc > 0 && (st / doc) > 0.7) { scrolled = true; shown = true; setTimeout(function () { showCap('scroll-capture'); }, 600); }
        }, { passive: true });
        document.addEventListener('mouseout', function (e) {
          if (shown || scrolled) return;
          if (!e.relatedTarget && e.clientY <= 0) { shown = true; setTimeout(function () { showCap('exit-capture'); }, 200); }
        });
      })();
    </script>
  )
}
<script is:inline>
  (function () {
    if (window.__footerLive) return;
    window.__footerLive = true;
    /* currently working on (latest commit) */
    (function () {
      var el = document.getElementById('nowStatus');
      if (!el) return;
      try {
        var k = 'nowStatus:' + new Date().toISOString().slice(0, 10);
        var cached = localStorage.getItem(k);
        if (cached) { el.textContent = 'Currently: ' + cached; return; }
        fetch('/api/github', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (j) {
          var c = (j && j.commits && j.commits[0] && j.commits[0].message) || '';
          if (c) { el.textContent = 'Currently: ' + c; try { localStorage.setItem(k, c); } catch (e) {} }
        }).catch(function () {});
      } catch (e) {}
    })();
    /* live GitHub pulse (pushes today) */
    (function () {
      var el = document.getElementById('ghPulse');
      if (!el) return;
      fetch('/api/pulse', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (j) {
        var n = (j && j.pushesToday) || 0;
        el.textContent = '· ' + n + (n === 1 ? ' push' : ' pushes') + ' today';
        el.classList.add('on');
      }).catch(function () {});
    })();
    /* AI "this week I shipped" summary */
    (function () {
      var el = document.getElementById('shipNote');
      if (!el) return;
      fetch('/api/ship', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (j) {
        if (j && j.summary) el.textContent = '🤖 What I shipped this week: ' + j.summary;
      }).catch(function () {});
    })();
  })();
</script>
{variant !== 'index' && <Search />}
<script is:inline>
  (function () {
    function va(name, label) { try { if (window.va) window.va('event', { name: name, label: label || '' }); } catch (e) {} }
    document.querySelectorAll('a[download]').forEach(function (a) {
      a.addEventListener('click', function () { va('file_download', (a.getAttribute('download') || 'file').replace(/\.\w+$/, '')); });
    });
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (f && f.id) va('form_submit', f.id);
    }, true);
  }());
</script>
