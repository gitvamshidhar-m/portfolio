      .date, .mini { color:var(--muted); }
      .date { font-size:12.5px; font-weight:600; }
      .company { font-size:13.5px; font-weight:600; }
      ul { margin:6px 0 0; padding-left:18px; }
      li { margin-bottom:3px; }
      .stats { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0 2px; }
      .stats span { padding:6px 10px; border:1px solid #dfe3ff; border-radius:8px; background:#eef0ff; color:var(--accent); font-size:12px; font-weight:700; }
      .grid { display:grid; grid-template-columns:1fr 1fr; gap:0 28px; }
      .print { position:fixed; top:16px; right:16px; padding:10px 16px; border:0; border-radius:9px; background:var(--accent); color:#fff; cursor:pointer; font-size:13px; font-weight:700; }
      .foot { margin-top:26px; color:var(--muted); font-size:12px; text-align:center; }
      @media (max-width:640px) { .page { padding:26px 18px; } header { flex-direction:column; } .contact { text-align:left; } .grid { grid-template-columns:1fr; } }
      @media print { body { background:#fff; } .page { max-width:100%; padding:8mm 6mm; box-shadow:none; } .print { display:none; } }
    </style>
