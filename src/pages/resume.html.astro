      .role { margin-top:2px; color:var(--accent); font-weight:600; }
      .contact { color:var(--muted); font-size:12.5px; line-height:1.6; text-align:right; }
      .job { margin-bottom:14px; }
      .job-head { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:8px; }
