---
import Base from '../layouts/Base.astro';

const op = {
  title: "Projects — Vamshidhar Reddy | AI Products Built Solo",
  description: "Projects by Vamshidhar Reddy — Hook AI, Creative Predictor and an AI Growth Strategy Generator, all designed, built and launched solo.",
  canonical: "https://vamshidharm.vercel.app/projects.html",
  ogImage: "",
  variant: 'sub',
  active: "projects.html",
};
const body = "<section>\n\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Projects</span>\n      <h1>Built with Code &amp; Marketing Instinct</h1>\n      <p>Three live products I designed, built, and launched solo. Run them yourself — health badges check them in real time.</p>\n    </div>\n    <div class=\"pgrid\">\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Growth SaaS · built solo</div><div class=\"ico\">🎯</div>\n        <h3>Hook AI — Marketing Copy Engine</h3>\n        <p>An AI engine that writes conversion-ready hooks, headlines, and ad copy across 15+ niches — with its own full SEO program, email flows, and A/B hero testing.</p>\n        <div class=\"chips\"><span>Next.js</span><span>Supabase</span><span>TypeScript</span><span>Razorpay</span><span>Groq AI</span><span>Vercel</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://hook-ai-marketing-engine.vercel.app\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://hook-ai-marketing-engine.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a><a href=\"https://github.com/gitvamshidhar-m/hook-ai-marketing-engine\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a></div>\n      </div>\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Paid Media &amp; CRO suite · v13.0</div><div class=\"ico\">📈</div>\n        <h3>Creative Predictor</h3>\n        <p>Paste any ad creative and get predicted CTR, engagement &amp; conversion, plus 20+ modules — quality score, A/B testing, competitor decoder, landing-page analyzer.</p>\n        <div class=\"chips\"><span>Groq Llama 3.3</span><span>OpenAI</span><span>HuggingFace</span><span>hf.space</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a></div>\n      </div>\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Growth Strategy · funnel-based</div><div class=\"ico\">🚀</div>\n        <h3>AI Growth Strategy Generator</h3>\n        <p>Answer a quick wizard — industry, budget, KPI targets (CPA/ROAS) — and get a personalized, budget-optimized, effort-vs-impact-scored marketing plan.</p>\n        <div class=\"chips\"><span>Next.js</span><span>Guided Wizard</span><span>Vercel</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://strategy-generator-kwdf-beta.vercel.app\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://strategy-generator-kwdf-beta.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a></div>\n      </div>\n    </div>\n    <div class=\"receipts reveal\">\n      <span class=\"tag\">Receipts</span>\n      <h3>Proof of work, not promises</h3>\n      <div class=\"receipt-grid\">\n        <div class=\"r-item\"><b>Rs.1,100 → Rs.770</b><span>cost-per-lead</span><small>client PPC account · 2024–25</small></div>\n        <div class=\"r-item\"><b>3.2x → 5.5x</b><span>client ROAS</span><small>same budget · case study below</small></div>\n        <div class=\"r-item\"><b>40+ → 8</b><span>ad groups consolidated</span><small>paid-media restructure</small></div>\n        <div class=\"r-item\"><b>+15%</b><span>organic traffic</span><small>Autozilla · since May 2023</small></div>\n        <div class=\"r-item\"><b>70+</b><span>qualified leads / mo</span><small>Autozilla · current</small></div>\n        <div class=\"r-item\"><b>Rs.2L+</b><span>ad budget managed</span><small>monthly, hands-on</small></div>\n      </div>\n      <p class=\"r-cta\"><a href=\"https://vamshidharm.vercel.app/blog/case-study-restructuring-paid-media-cut-cpl-30.html\">Read the full case study →</a> &nbsp;·&nbsp; <a href=\"https://vamshidharm.vercel.app/blog/case-study-organic-traffic-15-percent-combined-with-paid.html\">Organic SEO case study →</a> &nbsp;·&nbsp; <a href=\"https://vamshidharm.vercel.app/blog.html\">More on the blog →</a></p>\n    </div>\n  </div>\n\n</section>";
---
<Base {...op}>
  <Fragment set:html={body} />
  
</Base>
