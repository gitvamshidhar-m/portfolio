---
import Base from '../layouts/Base.astro';

const op = {
  title: "Projects — Vamshidhar Reddy | AI Products Built Solo",
  description: "Projects by Vamshidhar Reddy — Hook AI, Creative Predictor and an AI Growth Strategy Generator, all designed, built and launched solo. Run all three live, embedded right on this page.",
  canonical: "https://vamshidharm.vercel.app/projects.html",
  ogImage: "",
  variant: 'sub',
  active: "projects.html",
};
const body = "<section>\n\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Projects</span>\n      <h1>Built with Code &amp; Marketing Instinct</h1>\n      <p>Three live products I designed, built, and launched solo. Run them yourself — health badges check them in real time.</p>\n    </div>\n    <div class=\"pgrid\">\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Growth SaaS · built solo</div><div class=\"ico\">🎯</div>\n        <h3>Hook AI — Marketing Copy Engine</h3>\n        <p>An AI engine that writes conversion-ready hooks, headlines, and ad copy across 15+ niches — with its own full SEO program, email flows, and A/B hero testing.</p>\n        <div class=\"chips\"><span>Next.js</span><span>Supabase</span><span>TypeScript</span><span>Razorpay</span><span>Groq AI</span><span>Vercel</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://hook-ai-marketing-engine.vercel.app\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://hook-ai-marketing-engine.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a><a href=\"https://github.com/gitvamshidhar-m/hook-ai-marketing-engine\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a></div>\n      </div>\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Paid Media &amp; CRO suite · v13.0</div><div class=\"ico\">📈</div>\n        <h3>Creative Predictor</h3>\n        <p>Paste any ad creative and get predicted CTR, engagement &amp; conversion, plus 20+ modules — quality score, A/B testing, competitor decoder, landing-page analyzer.</p>\n        <div class=\"chips\"><span>Groq Llama 3.3</span><span>OpenAI</span><span>HuggingFace</span><span>hf.space</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a></div>\n      </div>\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Growth Strategy · funnel-based</div><div class=\"ico\">🚀</div>\n        <h3>AI Growth Strategy Generator</h3>\n        <p>Answer a quick wizard — industry, budget, KPI targets (CPA/ROAS) — and get a personalized, budget-optimized, effort-vs-impact-scored marketing plan.</p>\n        <div class=\"chips\"><span>Next.js</span><span>Guided Wizard</span><span>Vercel</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://strategy-generator-kwdf-beta.vercel.app\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://strategy-generator-kwdf-beta.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a></div>\n      </div>\n    <div class=\"demo-lab reveal\">\n      <div class=\"sec-head\" style=\"margin-bottom:6px\">\n        <span class=\"tag\">Live Demos</span>\n        <h2 style=\"margin-top:10px\">Demos Are Live, Not Screenshots</h2>\n        <p>Hit launch and the real product runs in this panel — same servers, same data, no simulation.</p>\n      </div>\n      <div class=\"demo-tabs\" role=\"tablist\" aria-label=\"Product demos\">\n        <button type=\"button\" class=\"demo-tab on\" data-tab=\"hook\" aria-selected=\"true\">🎯 Hook AI</button>\n        <button type=\"button\" class=\"demo-tab\" data-tab=\"predictor\" aria-selected=\"false\">📈 Creative Predictor</button>\n        <button type=\"button\" class=\"demo-tab\" data-tab=\"strategy\" aria-selected=\"false\">🚀 Strategy Generator</button>\n      </div>\n      <div class=\"demo-stage\" id=\"demoLab\">\n        <div class=\"demo-pane on\" data-pane=\"hook\">\n          <div class=\"demo-launch\">\n            <span class=\"demo-label\">Hook AI — Marketing Copy Engine</span>\n            <p>Conversion-ready hooks, angles and ad copy across 15+ niches, with its SEO program and A/B testing built in.</p>\n            <button type=\"button\" class=\"btn primary\" data-run=\"https://hook-ai-marketing-engine.vercel.app\" data-pane=\"hook\">▶ Launch Hook AI</button>\n            <small>Runs in this panel. Prefer a tab? <a class=\"demo-out\" href=\"https://hook-ai-marketing-engine.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Open full site →</a></small>\n          </div>\n          <iframe class=\"demo-frame\" data-src=\"https://hook-ai-marketing-engine.vercel.app\" loading=\"lazy\" title=\"Hook AI live demo\"></iframe>\n        </div>\n        <div class=\"demo-pane\" data-pane=\"predictor\">\n          <div class=\"demo-launch\">\n            <span class=\"demo-label\">Creative Predictor</span>\n            <p>Paste any ad creative and get predicted CTR, engagement &amp; conversion — plus a full quality-score suite.</p>\n            <button type=\"button\" class=\"btn primary\" data-run=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\" data-pane=\"predictor\">▶ Launch Creative Predictor</button>\n            <small>Prefer a tab? <a class=\"demo-out\" href=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\" target=\"_blank\" rel=\"noopener noreferrer\">Open full site →</a></small>\n          </div>\n          <iframe class=\"demo-frame\" data-src=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\" loading=\"lazy\" title=\"Creative Predictor live demo\"></iframe>\n        </div>\n        <div class=\"demo-pane\" data-pane=\"strategy\">\n          <div class=\"demo-launch\">\n            <span class=\"demo-label\">AI Growth Strategy Generator</span>\n            <p>A guided wizard — industry, budget, KPI targets (CPA / ROAS) — turns inputs into an effort-vs-impact-scored marketing plan.</p>\n            <button type=\"button\" class=\"btn primary\" data-run=\"https://strategy-generator-kwdf-beta.vercel.app\" data-pane=\"strategy\">▶ Launch Strategy Generator</button>\n            <small>Prefer a tab? <a class=\"demo-out\" href=\"https://strategy-generator-kwdf-beta.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Open full site →</a></small>\n          </div>\n          <iframe class=\"demo-frame\" data-src=\"https://strategy-generator-kwdf-beta.vercel.app\" loading=\"lazy\" title=\"AI Growth Strategy Generator live demo\"></iframe>\n        </div>\n      </div>\n    </div>\n    <div class=\"receipts reveal\">\n      <span class=\"tag\">Receipts</span>\n      <h3>Proof of work, not promises</h3>\n      <div class=\"receipt-grid\">\n        <div class=\"r-item\"><b>Rs.1,100 → Rs.770</b><span>cost-per-lead</span><small>client PPC account · 2024–25</small></div>\n        <div class=\"r-item\"><b>3.2x → 5.5x</b><span>client ROAS</span><small>same budget · case study below</small></div>\n        <div class=\"r-item\"><b>40+ → 8</b><span>ad groups consolidated</span><small>paid-media restructure</small></div>\n        <div class=\"r-item\"><b>+15%</b><span>organic traffic</span><small>Autozilla · since May 2023</small></div>\n        <div class=\"r-item\"><b>70+</b><span>qualified leads / mo</span><small>Autozilla · current</small></div>\n        <div class=\"r-item\"><b>Rs.2L+</b><span>ad budget managed</span><small>monthly, hands-on</small></div>\n      </div>\n      <p class=\"r-cta\"><a href=\"https://vamshidharm.vercel.app/blog/case-study-restructuring-paid-media-cut-cpl-30.html\">Read the full case study →</a> &nbsp;·&nbsp; <a href=\"https://vamshidharm.vercel.app/blog/case-study-organic-traffic-15-percent-combined-with-paid.html\">Organic SEO case study →</a> &nbsp;·&nbsp; <a href=\"https://vamshidharm.vercel.app/blog.html\">More on the blog →</a></p>\n    </div>\n  </div>\n\n</section>";
---
<Base {...op}>
  <Fragment set:html={body} />
  <script is:inline>
    (function () {
      var lab = document.getElementById('demoLab');
      if (!lab) return;
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.demo-tab'));
      var panes = Array.prototype.slice.call(document.querySelectorAll('.demo-pane'));
      function show(k) {
        panes.forEach(function (p) { p.classList.toggle('on', p.getAttribute('data-pane') === k); });
        tabs.forEach(function (t) { var on = t.getAttribute('data-tab') === k; t.classList.toggle('on', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-tab')); }); });
      document.querySelectorAll('.demo-launch [data-run]').forEach(function (b) {
        b.addEventListener('click', function () {
          var pane = document.getElementById('demoLab').querySelector('.demo-pane[data-pane="' + b.getAttribute('data-pane') + '"]');
          var frame = pane ? pane.querySelector('.demo-frame') : null;
          if (frame && !frame.getAttribute('src')) frame.setAttribute('src', frame.getAttribute('data-src'));
          if (pane) pane.classList.add('launched');
          try { window.fetch('/api/analytics', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: '/demo/' + b.getAttribute('data-pane') }), keepalive: true }); } catch (e) {}
        });
      });
    })();
  </script>
</Base>
