let palSel=0,palItems=[];
function palOpen(){
  pal.classList.add('open');palSel=0;palIn.value='';palFilter('');palIn.focus();
}
function palClose(){pal.classList.remove('open');palIn.blur();}
function palGo(cmd){
  palClose();
  if(cmd.act)cmd.act();
  else if(cmd.href){const el=document.getElementById(cmd.href.slice(1));if(el)el.scrollIntoView({behavior:RM?'auto':'smooth'});}
  if(cmd.label.indexOf('CV')>-1||cmd.label.indexOf('vcf')>-1)loadTraction();
}
function palFilter(q){
  q=(q||'').toLowerCase();
  palItems=COMMANDS.filter(c=>c.label.toLowerCase().indexOf(q)>-1);
  renderPal();
}
function renderPal(){
  if(!palItems.length){palList.innerHTML='<div class="pal-empty">No matches</div>';return;}
  palList.innerHTML=palItems.slice(0,12).map((c,i)=>'<div class="pal-item'+(i===palSel?' sel':'')+'" data-i="'+i+'"><span>'+(c.icon||'→')+' '+c.label+'</span><span class="pk">↵</span></div>').join('');
  palList.querySelectorAll('.pal-item').forEach(el=>el.addEventListener('click',()=>palSel=+el.dataset.i&&palGo(palItems[+el.dataset.i])));
  const sel=palList.querySelector('.sel');if(sel)sel.scrollIntoView({block:'nearest'});
}
addEventListener('keydown',e=>{
  if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();pal.classList.contains('open')?palClose():palOpen();return;}
  const comp=document.activeElement;
  if(pal.classList.contains('open')){
    if(e.key==='Escape'){e.preventDefault();palClose();}
    else if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();palSel=(palSel+(e.key==='ArrowDown'?1:-1)+COMMANDS.length)%COMMANDS.length;renderPal();}
    else if(e.key==='Enter'){e.preventDefault();const c=palItems[palSel];if(c)palGo(c);}
  }
});
