      'Attention: a '+n+' brand that grew 15% without burning budget. Interest: it started with sharper copy. Desire: results you can copy. Action: '+o+' before the calendar fills.',
      'Most '+n+' ads fail at "Attention". This one starts with it. Read on — the offer is genuinely worth 5 minutes.'],
    bab=['Before: scattered '+n+' campaigns, no pipeline. After: one clear offer, 70+ leads a month, a dashboard you trust. The bridge is a marketer who builds — starting with '+o+'.',
      'Before, your '+n+' spend was a black box. After, every rupee maps to revenue. The difference isn\'t more budget — it\'s '+o+'.',
      'Your competitors started exactly where you are. Their "after" is a '+n+' playbook you can steal — claim '+o+' and build yours.'],
    proof=['#1-rated '+n+' growth system, used by 3 brands this quarter. Don\'t take my word — run '+o+' and read the numbers yourself.',
      'Trusted by operators managing Rs.2L+ monthly budgets — the same math that grows brands in '+n+'. '+o+' is how you audit it risk-free.',
      'One client cut cost-per-lead by 30% in 60 days. Same niche, same ads, better message. Your turn: '+o+'.'],
    gap=['The 3-word question every '+n+' marketer gets wrong (and why it\'s costing you 6 figures). '+o+' shows you the fix.',
      'Your competitors don\'t want you to see this '+n+' playbook. The best part? It starts with '+o+'.',
      'There\'s a reason your '+n+' ads plateau at 2% CTR — and it\'s embarrassingly fixable. '+o+'.'],
    num=['Rs.'+(Math.floor(Math.random()*90+30))+'0 → Rs.'+(Math.floor(Math.random()*40+20))+'0: what a 30% CPL cut looks like in '+n+'. Start with '+o+'.',
      '+15% traffic, +70 leads, 3.2x ROAS — in '+n+', that\'s not luck, it\'s a system. '+o+' is step one.',
      '40 ad groups → 8. CPL 1,100 → 770. Same spend, more pipeline, in '+n+'. The blueprint starts with '+o+'.'];
  let hooks=pas,key='pas';
  if(ANGLE.value.indexOf('AIDA')>-1){hooks=aida;key='aida';}
  else if(ANGLE.value.indexOf('BAB')>-1){hooks=bab;key='bab';}
  else if(ANGLE.value.indexOf('Proof')>-1){hooks=proof;key='prob';}
  else if(ANGLE.value.indexOf('Curiosity')>-1){hooks=gap;key='gap';}
  else if(ANGLE.value.indexOf('Numbers')>-1){hooks=num;key='num';}
  const tagLabel={pas:'PAS',aida:'AIDA',bab:'BAB',prob:'SOCIAL PROOF',gap:'CURIOSITY GAP',num:'NUMBERS'}[key];
  HO.innerHTML='';
  hooks.forEach((h,i)=>{
    setTimeout(()=>{
      const x=document.createElement('div');x.className='hook';
      x.innerHTML='<small>'+tagLabel+' · '+NICHE.value+'</small>'+h;
      HO.appendChild(x);requestAnimationFrame(()=>x.classList.add('show'));
      HO.scrollTop=HO.scrollHeight;
    },i*180);
  });
}
document.getElementById('genBtn').addEventListener('click',genHooks);

/* ---------- clocks ---------- */
function clock(){
  const t=new Date().toLocaleTimeString('en-IN',{timeZone:'Asia/Kolkata',hour12:true});
  const clockEl=document.getElementById('clock'), footerClockEl=document.getElementById('clock2');
  if(clockEl)clockEl.textContent='⏱ '+t;
  if(footerClockEl)footerClockEl.textContent=t;
}
clock();setInterval(clock,1000);

/* ---------- keyboard + easter egg ---------- */
const help=document.getElementById('help');
let buf='';
addEventListener('keydown',e=>{
  const k=e.key.toLowerCase();
  if(e.key==='Escape'){help.classList.remove('on');mm.classList.remove('on');mb.textContent='☰';mb.setAttribute('aria-label','Open menu');return;}
  if(e.target.tagName==='INPUT'||e.target.tagName==='SELECT'||e.target.tagName==='TEXTAREA')return;
  if(k==='?'){e.preventDefault();help.classList.toggle('on');return;}
  if(k==='t')toggleTheme();
  const secs={a:'#about',p:'#projects',h:'#hooklab',e:'#experience',s:'#skills',i:'#insights',c:'#contact'};
  if(secs[k])document.querySelector(secs[k]).scrollIntoView();
  buf=(buf+k).slice(-12);
  if(buf==='vamshidhar')confetti();
});
help.addEventListener('click',e=>{if(e.target===help)help.classList.remove('on');});

/* ---------- confetti ---------- */
const COLORS=['#6d5bff','#2ff3c0','#ff8a4c','#ff6b81','#ffd93d'];
function confetti(){
  if(RM)return;
  for(let i=0;i<60;i++){
    const s=document.createElement('div');s.className='confetti';
    s.style.left=Math.random()*100+'vw';
    s.style.background=COLORS[Math.floor(Math.random()*COLORS.length)];
    s.style.animationDuration=(Math.random()*1.6+1.2)+'s';
    s.style.animationDelay=(Math.random()*.6)+'s';
    s.style.transform='rotate('+Math.random()*360+'deg)';
    document.body.appendChild(s);
    setTimeout(()=>s.remove(),3200);
  }
}

/* ---------- ROI calc ---------- */
function inr(n){return '₹'+Math.round(n).toLocaleString('en-IN');}
function fmt(n){return Math.round(n).toLocaleString('en-IN');}
function calc(){
  const visits=+document.getElementById('visits').value;
  const cr=+document.getElementById('conv').value;
  const rev=+document.getElementById('rev').value;
  const ads=+document.getElementById('ads').value;
  const leads=Math.round(visits*(cr/100));
  const traffic=Math.round(visits*0.15);
  const croGain=Math.round(leads*rev*0.12);
  const roasGain=Math.round(ads*0.25);
  const total=croGain+roasGain;
  document.getElementById('calcOut').innerHTML=
    '<div class="co-row"><span>Organic traffic lift (15%)</span><b>+'+fmt(traffic)+'</b></div>'+
    '<div class="co-row"><span>Additional leads / month</span><b>+'+fmt(leads)+'</b></div>'+
    '<div class="co-row"><span>CRO uplift (+12% conversion)</span><b>'+inr(croGain)+'</b></div>'+
    '<div class="co-row"><span>Paid ads ROAS gain (+25%)</span><b>'+inr(roasGain)+'</b></div>'+
    '<div class="co-row big"><span>Total monthly impact</span><b>'+inr(total)+'</b></div>';
}
document.getElementById('visits').addEventListener('input',function(){document.getElementById('mv').textContent=fmt(this.value);calc();});
document.getElementById('conv').addEventListener('input',function(){document.getElementById('cr').textContent=this.value+'%';calc();});
document.getElementById('rev').addEventListener('input',function(){document.getElementById('rv').textContent=inr(this.value);calc();});
document.getElementById('ads').addEventListener('input',function(){document.getElementById('pb').textContent=inr(this.value);calc();});
calc();</script>
