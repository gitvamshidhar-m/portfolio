/* ---------- particles (network) ---------- */
const cv=document.getElementById('particles'),ctx=cv.getContext('2d');let P=[],W,H;
function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}resize();addEventListener('resize',resize);
for(let i=0;i<34;i++)P.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.4+.3,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35});
function part(){
  ctx.clearRect(0,0,W,H);
  for(let i=0;i<P.length;i++){
    const p=P[i];p.x+=p.vx;p.y+=p.vy;
    if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1;
    ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle='rgba(120,120,255,.5)';ctx.fill();
    for(let j=i+1;j<P.length;j++){
      const q=P[j],dx=p.x-q.x,dy=p.y-q.y,d=dx*dx+dy*dy;
      if(d<110*110){ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.strokeStyle='rgba(120,120,255,'+(.16*(1-d/(110*110)))+')';ctx.stroke();}
    }
  }
  if(!RM)requestAnimationFrame(part);
}
part();

