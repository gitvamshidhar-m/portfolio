const body = "<div id=\"progress\"></div>\n<div id=\"glow\"></div>\n\n<header class=\"hero\">\n  <div class=\"hero-grid-bg\" aria-hidden=\"true\"></div>\n  <canvas id=\"particles\" aria-hidden=\"true\"></canvas>\n  <div class=\"blob b1\" aria-hidden=\"true\"></div><div class=\"blob b2\" aria-hidden=\"true\"></div><div class=\"blob b3\" aria-hidden=\"true\"></div>\n  <div class=\"wrap hero-inner\" id=\"heroInner\">\n    <span class=\"tag\">⚡ Performance Marketing · SEO · AI-Augmented. Hunting: a team that wants both. <span id=\"refNote\" class=\"refnote\"></span></span>\n    <h1>Vamshidhar<br/><span>Reddy M</span></h1>\n    <div class=\"type-wrap\"><span id=\"type\"></span><span class=\"cursor\"></span></div>\n    <p id=\"heroRole\">10+ years in performance marketing. I don't just run campaigns — I build the AI tools that run them better, and ship the proof (ROAS 3.2x → 5.5x, CPL −30%, 3 products solo).</p>\n    <div class=\"role-switch\" role=\"tablist\" aria-label=\"View my experience by role\">\n      <button data-role=\"ppc\" class=\"on\" id=\"rolePpc\">Performance / PPC</button>\n      <button data-role=\"ai\">AI Marketing Tools</button>\n      <button data-role=\"seo\">SEO</button>\n    </div>\n    <div class=\"ticker\"><span class=\"live\">LIVE</span><span id=\"tickText\">Fetching metrics…</span></div>\n    <div class=\"views\" id=\"views\" hidden>👀 Profile viewed <b>…</b> times</div>\n    <div class=\"traction\" id=\"traction\" hidden>\n      <span><span class=\"livepulse\"></span><i>Traction live</i></span>\n      <span>👀 <b id=\"trViews\">…</b> views</span>\n      <span>📄 <b id=\"trResume\">…</b> CV grabs</span>\n      <span>✉️ <b id=\"trMsg\">…</b> messages</span>\n      <span>🛡️ <b id=\"trSpam\">…</b> spam AI-blocked</span>\n    </div>\n    <div class=\"socials\">\n      <a href=\"https://linkedin.com/in/vamshidharreddym\" aria-label=\"LinkedIn\" target=\"_blank\" rel=\"noopener noreferrer\"><svg viewBox=\"0 0 24 24\"><path d=\"M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45z\"/></svg></a>\n      <a href=\"https://github.com/gitvamshidhar-m\" aria-label=\"GitHub\" target=\"_blank\" rel=\"noopener noreferrer\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.91c.58.11.79-.25.79-.56v-2.03c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z\"/></svg></a>\n      <a href=\"https://mail.google.com/mail/?view=cm&fs=1&to=geovamshidhar@gmail.com&su=Hello%20Vamshidhar\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Email via Gmail\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z\"/></svg></a>\n      <a href=\"tel:+917981719085\" aria-label=\"Phone\"><svg viewBox=\"0 0 24 24\"><path d=\"M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1L6.6 10z\"/></svg></a>\n    </div>\n    <div class=\"cta-row\">\n      <a class=\"btn primary btn-lg\" href=\"#contact\">Hire Me →</a>\n      <a class=\"btn link-secondary\" href=\"#hooklab\">Try the Hook Lab</a>\n    </div>\n  </div>\n  <div class=\"mouse\"><span></span></div>\n</header>\n\n<div class=\"impact\" aria-label=\"Proven results\">\n  <div class=\"impact-item\"><b>−30%</b><span>Cost-per-lead</span><small>Rs.1,100 → Rs.770</small></div>\n  <div class=\"impact-item\"><b>3.2x → 5.5x</b><span>Client ROAS</span><small>same budget</small></div>\n  <div class=\"impact-item\"><b>+15%</b><span>Organic traffic</span><small>audits + technical SEO</small></div>\n  <div class=\"impact-item\"><b>70+</b><span>Leads / month</span><small>qualified, measurable</small></div>\n</div>\n\n<div class=\"wrap\">\n  <div class=\"stats reveal\">\n    <div class=\"stat\"><b class=\"count\" data-target=\"10\" data-suffix=\"+\">0</b><i>Years Experience</i></div>\n    <div class=\"stat\"><b class=\"count\" data-target=\"15\" data-suffix=\"%\">0</b><i>Organic Traffic Growth</i></div>\n    <div class=\"stat\"><b class=\"count\" data-target=\"70\">0</b><i>Qualified Leads / Mo</i></div>\n    <div class=\"stat\"><b>Rs.2L+</b><i>Monthly Ad Budget</i></div>\n    <div class=\"stat\"><b class=\"count\" data-target=\"3\">0</b><i>Live AI Products</i></div>\n  </div>\n  <div class=\"mini-cta reveal\"><span>Hiring? The <a href=\"#for-you\">roles I'm built for</a> are mapped below — pick yours, then send 3 lines.</span></div>\n</div>\n\n<section id=\"about\">\n  <div class=\"wrap grid2\">\n    <div class=\"reveal\">\n      <span class=\"tag\">About Me</span>\n      <h2>From QA Engineer to a Marketer Who Builds</h2>\n      <p style=\"margin-top:18px;color:var(--muted)\">My career started in software testing — which taught me to break things down, find the root cause, and fix it. That same muscle now drives every campaign. I moved into digital marketing in 2015, managed budgets north of Rs.2L/month, then taught myself to code so I could stop waiting on developers and ship my own marketing tools.</p>\n      <p style=\"margin-top:12px;color:var(--muted)\">Today I sit in a rare middle lane: I plan the strategy with the CMO <b style=\"color:var(--txt)\">and</b> build the tool that executes it.</p>\n      <div class=\"how\">\n        <div class=\"step\"><span class=\"num\">01</span><div><b>Data-First</b><p>Every decision starts with real numbers — campaigns and budgets backed by GA4, Looker, and live dashboards.</p></div></div>\n        <div class=\"step\"><span class=\"num\">02</span><div><b>AI-Augmented</b><p>If a task repeats, I automate it. I build AI tools that cut hours of work into seconds.</p></div></div>\n        <div class=\"step\"><span class=\"num\">03</span><div><b>End-to-End</b><p>Strategy, execution, tracking, optimization — I own the full cycle until the result is proven.</p></div></div>\n        <div class=\"step\"><span class=\"num\">04</span><div><b>ROI Over Activity</b><p>More work doesn't mean better results. Every action has a measurable target.</p></div></div>\n      </div>\n    </div>\n    <div class=\"reveal\">\n      <div id=\"terminal\">\n        <div class=\"term-bar\">\n          <span class=\"dot\" style=\"background:#ff5f56\"></span>\n          <span class=\"dot\" style=\"background:#ffbd2e\"></span>\n          <span class=\"dot\" style=\"background:#27c93f\"></span>\n          <span style=\"margin-left:10px;color:var(--muted);font-size:12.5px;font-family:ui-monospace\">vamshidhar@portfolio: ~ — tap a question (or press ?)</span>\n        </div>\n        <div class=\"term-body\" id=\"termBody\">\n          <div class=\"out\"><span class=\"c3\">➜</span> welcome to my portfolio. ask me anything 👇</div>\n        </div>\n        <div class=\"qs\">\n          <button data-q=\"what\">What do you do?</button>\n          <button data-q=\"ppc\">Show a PPC win</button>\n          <button data-q=\"ai\">Your AI tools</button>\n          <button data-q=\"edge\">The edge</button>\n          <button data-q=\"hire\">Why hire you?</button>\n          <button data-q=\"role\">Match a role</button>\n        </div>\n        <div class=\"term-input\">\n          <input id=\"chatIn\" type=\"text\" placeholder='type \"seo\", \"ppc\", \"hire\"…' aria-label=\"Ask me anything\" autocomplete=\"off\">\n          <button id=\"micBtn\" aria-label=\"Ask with your voice\" title=\"Ask with your voice\" hidden>🎙️</button>\n          <button id=\"chatSend\" aria-label=\"Send message\">➤</button>\n        </div>\n        <div class=\"chat-tools\" id=\"chatTools\">\n          <button id=\"btCopy\">📋 Copy last Q&A</button>\n          <button id=\"btEmail\">📧 Email me this chat</button>\n        </div>\n        <div class=\"ragnote\">⚡ Live RAG — answers are grounded in my real documents (<b>api/kb.js</b>), then answered by an LLM.</div>\n      </div>\n      <div style=\"margin-top:22px\">\n        <span class=\"tag\">My journey</span>\n        <div class=\"tl\">\n          <div class=\"titem\"><span class=\"range\">2007–2014</span><h3>Software Test Engineering</h3><p style=\"color:var(--muted);font-size:14px\">Ainslee Software &amp; Corbz Data — built the analytical rigor behind every decision.</p></div>\n          <div class=\"titem\"><span class=\"range\">2015–2022</span><h3>SEO → PPC → Strategy</h3><p style=\"color:var(--muted);font-size:14px\">From SEO Executive to Campaign Specialist across four companies.</p></div>\n          <div class=\"titem\"><span class=\"range\">2023–Present</span><h3>AI-Powered Marketing</h3><p style=\"color:var(--muted);font-size:14px\">Managing Rs.2L+ ad budgets, 15% organic growth, and shipping AI products.</p></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<div class=\"marquee\"><div class=\"roll\" id=\"marq\"></div></div>\n\n<section id=\"projects\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Projects</span>\n      <h2>Built with Code &amp; Marketing Instinct</h2>\n      <p>Three live products I designed, built, and launched solo. Run them yourself — health badges check them in real time.</p>\n    </div>\n    <div class=\"pgrid\">\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Growth SaaS · built solo</div><div class=\"ico\">🎯</div>\n        <h3>Hook AI — Marketing Copy Engine</h3>\n        <p>An AI engine that writes conversion-ready hooks, headlines, and ad copy across 15+ niches — with its own full SEO program, email flows, and A/B hero testing.</p>\n        <div class=\"chips\"><span>Next.js</span><span>Supabase</span><span>TypeScript</span><span>Razorpay</span><span>Groq AI</span><span>Vercel</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://hook-ai-marketing-engine.vercel.app\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://hook-ai-marketing-engine.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a><a href=\"https://github.com/gitvamshidhar-m/hook-ai-marketing-engine\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a></div>\n      </div>\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Paid Media &amp; CRO suite · v13.0</div><div class=\"ico\">📈</div>\n        <h3>Creative Predictor</h3>\n        <p>Paste any ad creative and get predicted CTR, engagement &amp; conversion, plus 20+ modules — quality score, A/B testing, competitor decoder, landing-page analyzer.</p>\n        <div class=\"chips\"><span>Groq Llama 3.3</span><span>OpenAI</span><span>HuggingFace</span><span>hf.space</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a></div>\n      </div>\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Growth Strategy · funnel-based</div><div class=\"ico\">🚀</div>\n        <h3>AI Growth Strategy Generator</h3>\n        <p>Answer a quick wizard — industry, budget, KPI targets (CPA/ROAS) — and get a personalized, budget-optimized, effort-vs-impact-scored marketing plan.</p>\n        <div class=\"chips\"><span>Next.js</span><span>Guided Wizard</span><span>Vercel</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://strategy-generator-kwdf-beta.vercel.app\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://strategy-generator-kwdf-beta.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a></div>\n      </div>\n    </div>\n    <div class=\"receipts reveal\">\n      <span class=\"tag\">Receipts</span>\n      <h3>Proof of work, not promises</h3>\n      <div class=\"receipt-grid\">\n        <div class=\"r-item\"><b>Rs.1,100 → Rs.770</b><span>cost-per-lead</span><small>client PPC account · 2024–25</small></div>\n        <div class=\"r-item\"><b>3.2x → 5.5x</b><span>client ROAS</span><small>same budget · case study below</small></div>\n        <div class=\"r-item\"><b>40+ → 8</b><span>ad groups consolidated</span><small>paid-media restructure</small></div>\n        <div class=\"r-item\"><b>+15%</b><span>organic traffic</span><small>Autozilla · since May 2023</small></div>\n        <div class=\"r-item\"><b>70+</b><span>qualified leads / mo</span><small>Autozilla · current</small></div>\n        <div class=\"r-item\"><b>Rs.2L+</b><span>ad budget managed</span><small>monthly, hands-on</small></div>\n      </div>\n      <p class=\"r-cta\"><a href=\"https://vamshidharm.vercel.app/blog/case-study-restructuring-paid-media-cut-cpl-30.html\">Read the full case study →</a> &nbsp;·&nbsp; <a href=\"https://vamshidharm.vercel.app/blog/case-study-organic-traffic-15-percent-combined-with-paid.html\">Organic SEO case study →</a> &nbsp;·&nbsp; <a href=\"https://vamshidharm.vercel.app/blog.html\">More on the blog →</a></p>\n    </div>\n  </div>\n</section>\n\n<section id=\"live\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Live from GitHub</span>\n      <h2>Ship logs — pulled in real time</h2>\n      <p>My repos, fetched live from the GitHub API. No fake data here — this section updates itself.</p>\n    </div>\n    <div class=\"ghgrid reveal\" id=\"ghbox\">\n      <div class=\"skel\"><span style=\"width:55%\"></span><span style=\"width:85%\"></span><span style=\"width:40%\"></span></div>\n      <div class=\"skel\"><span style=\"width:50%\"></span><span style=\"width:80%\"></span><span style=\"width:42%\"></span></div>\n      <div class=\"skel\"><span style=\"width:60%\"></span><span style=\"width:75%\"></span><span style=\"width:38%\"></span></div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"hooklab\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Live Widget</span>\n      <h2>Hook Lab — Ship It, Don't Say It</h2>\n      <p>This is the kind of thing I build. Pick a niche and an angle, and watch conversion hooks generate instantly — a lightweight preview of my Hook AI engine.</p>\n    </div>\n    <div class=\"hooklab reveal\">\n      <div class=\"hlab-form\">\n        <div>\n          <label>Niche <b id=\"nicheLabel\">Fitness &amp; Wellness</b></label>\n          <select id=\"niche\">\n            <option>Fitness &amp; Wellness</option>\n            <option>SaaS / B2B Software</option>\n            <option>E-commerce / D2C</option>\n            <option>Real Estate</option>\n            <option>EdTech / Courses</option>\n            <option>Local Services</option>\n            <option>Agency / Consulting</option>\n            <option>Finance / Insurance</option>\n          </select>\n        </div>\n        <div>\n          <label>Your Offer</label>\n          <input id=\"offer\" type=\"text\" value=\"Free 30-min growth audit for your store\" placeholder=\"e.g. Free trial, 20% off, free audit\">\n        </div>\n        <div>\n          <label>Angle</label>\n          <select id=\"angle\">\n            <option>PAS — Problem, Agitate, Solve</option>\n            <option>AIDA — Attention, Interest, Desire, Action</option>\n            <option>BAB — Before, After, Bridge</option>\n            <option>Social Proof</option>\n            <option>Curiosity Gap</option>\n            <option>Plain Old Hard Numbers</option>\n          </select>\n        </div>\n        <button class=\"btn primary\" id=\"genBtn\">⚡ Generate 3 Hooks</button>\n        <a class=\"btn\" href=\"https://hook-ai-marketing-engine.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"text-align:center\">Run the full engine on Hook AI →</a>\n      </div>\n      <div class=\"hook-out\" id=\"hookOut\">\n        <div class=\"hook\"><small>Press generate</small>Pick a niche + angle and generate conversion hooks you could run today.</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"experience\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Experience</span>\n      <h2>Professional Journey</h2>\n      <p>10+ years, from QA to AI-Powered Marketing specialist.</p>\n    </div>\n    <div class=\"grid2\" style=\"grid-template-columns:1.1fr .9fr;gap:26px\">\n      <div class=\"tl\">\n        <div class=\"titem reveal\"><span class=\"range\">May 2023 — Present</span><h3>Digital Marketing Specialist</h3><div class=\"co\">Autozilla Software Solutions</div><ul><li>Grew organic traffic <b style=\"color:var(--accent2)\">15%</b> via SEO audits &amp; technical fixes</li><li>Generated <b style=\"color:var(--accent2)\">70+ leads/mo</b></li><li>Managed <b style=\"color:var(--accent2)\">Rs.2L+</b> monthly ad spend</li></ul></div>\n        <div class=\"titem reveal\"><span class=\"range\">Jun 2022 — May 2023</span><h3>Campaign Specialist</h3><div class=\"co\">Pranathi Software Services</div><ul><li>LinkedIn Ads for B2B lead generation</li><li>Optimized bids to lift ROAS &amp; cut wasted spend</li></ul></div>\n        <div class=\"titem reveal\"><span class=\"range\">Feb 2021 — May 2022</span><h3>Digital Marketing Executive</h3><div class=\"co\">FAMA Technologies</div><ul><li>Integrated SEO, PPC &amp; content; A/B and CRO</li></ul></div>\n        <div class=\"titem reveal\"><span class=\"range\">Jun 2019 — Sep 2020</span><h3>Digital Marketing Executive</h3><div class=\"co\">E-Rad Imaging</div><ul><li>End-to-end SEO campaigns</li></ul></div>\n        <div class=\"titem reveal\"><span class=\"range\">Nov 2017 — May 2019</span><h3>SEO &amp; SMO Expert</h3><div class=\"co\">Promantra Synergies</div><ul><li>SEO + social, competitor benchmarking</li></ul></div>\n        <div class=\"titem reveal\"><span class=\"range\">Jan 2015 — Nov 2017</span><h3>SEO Executive</h3><div class=\"co\">Digital Way Soft</div><ul><li>Technical SEO, on-page, link building</li></ul></div>\n        <div class=\"titem reveal\"><span class=\"range\">May 2007 — Sep 2014</span><h3>Software / Junior Test Engineer</h3><div class=\"co\">Ainslee Software &amp; Corbz Data</div><ul><li>QA — the analytical foundation</li></ul></div>\n      </div>\n      <div class=\"reveal\">\n        <span class=\"tag\">The edge</span>\n        <div class=\"step\"><b style=\"color:var(--accent2)\">Both sides</b><p style=\"color:var(--muted)\">Most marketers can't code. Most developers don't understand funnels. I do both — so I ship what I plan.</p></div>\n        <div class=\"step\" style=\"margin-top:14px\"><b style=\"color:var(--accent2)\">My standard</b><p style=\"color:var(--muted)\">\"I don't just run reports — I build the pipelines that generate them.\"</p></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"voices\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Said about the work</span>\n      <h2>What people on the other side of the funnel say</h2>\n    </div>\n    <div class=\"vox reveal\" id=\"vox\">\n      <div class=\"v-item placeholder\">\n        <p>References and project testimonials available on request — I'd rather connect you with a real manager than paste a quote. Ask in the contact form (or just email me) and I'll share contacts from the teams above.</p>\n        <div class=\"v-who\"><b>Verifiable references</b><i>managers &amp;