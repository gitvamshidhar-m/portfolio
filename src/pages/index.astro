function responder(k){
  const r=k.toLowerCase();
  if(/\b(hi|hello|hey)\b/.test(r))return answers.greeting;
  if(/seo manager|ppc specialist|google ads|performance marketing|product marketing|role|match|hiring for|job fit|resume match/.test(r))return roleMatch(r);
  if(/email|contact|reach|message/.test(r))return answers.contact;
  if(/\bseo\b|organic|traffic/.test(r))return answers.seo;
  if(/ppc|ads|roas|cost|per|lead|cpl/.test(r))return answers.ppc;
  if(/budget|media|spend|kpi|analytics/.test(r))return answers.media;
  if(/experience|career|job|work|history|years|resume/.test(r))return answers.experience;
  if(/why|hire|offer|apply|recruit/.test(r))return answers.hire;
  if(/\bai\b|tool|build|product|built/.test(r))return answers.ai;
  if(/edge|unique|different/.test(r))return answers.edge;
  if(/tech|stack|site|website|made|how/.test(r))return answers.tech;
  return "Hmm, I might not have that offline. Try asking about SEO, PPC, my AI tools, or hire me — or email geovamshidhar@gmail.com.";
}
