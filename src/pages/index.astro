    line:"10+ years growing organic traffic ~15%: technical audits, E-E-A-T, keyword & content strategy. This site is itself a technical SEO proof — inspect the source.",
    impact:[['+15%','Organic traffic','audits + technical SEO'],['#1','Google rankings','high-value terms'],['70+','Leads / month','qualified, measurable'],['Rs.2L+','Budget managed','monthly ad spend']]
  },
