  <script is:inline>(function(){
  var box=document.getElementById('ghbox');if(!box)return;
  fetch('/api/github',{cache:'no-store'}).then(function(r){return r.json();}).then(function(j){
    if(!j||!j.repos||!j.repos.length){
      box.innerHTML='<p class="gh-empty">GitHub API is rate-limited right now — see <a href="https://github.com/gitvamshidhar-m" target="_blank" rel="noopener noreferrer">github.com/gitvamshidhar-m</a>.</p>';
      return;
    }
    box.innerHTML='<a class="gh-user" href="'+j.html_url+'" target="_blank" rel="noopener noreferrer"><b>@'+j.login+'</b><span>'+(j.public_repos||j.repos.length)+' public repos'+(j.bio?' · '+j.bio:'')+'</span></a>'+
      j.repos.map(function(r){
        return '<a class="gh-repo" href="'+r.html_url+'" target="_blank" rel="noopener noreferrer"><b>'+r.name+'</b><span>'+((r.description||'').replace(/&/g,'&amp;'))+'</span><small>★ '+(r.stargazers_count||0)+' · '+(r.language||'code')+' · updated '+new Date(r.updated_at).toLocaleDateString('en-IN')+'</small></a>';
      }).join('')+
      '<a class="gh-more" href="'+j.html_url+'" target="_blank" rel="noopener noreferrer">View all on GitHub →</a>';
  }).catch(function(){
    box.innerHTML='<p class="gh-empty">Couldn\'t reach GitHub right now — <a href="https://github.com/gitvamshidhar-m/" target="_blank" rel="noopener noreferrer">view my profile</a>.</p>';
  });
})();</script>
  <script is:inline>(function(){
  var f=document.getElementById('contactForm');if(!f)return;
  var msg=document.getElementById('formMsg');
  var fl=document.getElementById('fLoad');
  var loadTime=Date.now();
  if(fl)fl.value=loadTime;
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var fl2=document.getElementById('fLoad');
    if(fl2)fl2.value=String(Date.now()-loadTime);
    var btn=f.querySelector('button[type=submit]');btn.disabled=true;btn.textContent='Sending…';
    var body={};new FormData(f).forEach(function(v,k){body[k]=v;});
    fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      .then(function(r){return r.json();})
      .then(function(j){
        msg.hidden=false;
        if(j&&j.ok&&j.delivered){msg.className='formmsg ok';msg.textContent='Thanks — message received. I usually reply within a day.';f.reset();}
        else{msg.className='formmsg err';msg.textContent='Message captured. For the fastest reply, email me directly: geovamshidhar@gmail.com';}
      })
      .catch(function(){msg.hidden=false;msg.className='formmsg err';msg.textContent='Network error — please email me directly: geovamshidhar@gmail.com';})
      .then(function(){btn.disabled=false;btn.textContent='Send Message';});
  });
})();</script>
  <script is:inline>/* ---------- data-driven overrides ---------- */
const DEFAULTS={
  stats:[
    {target:10,suffix:'+',label:'Years Experience'},
    {target:15,suffix:'%',label:'Organic Traffic Growth'},
    {target:70,suffix:'',label:'Qualified Leads / Mo'},
    {target:0,suffix:'',label:'Monthly Ad Budget',text:'Rs.2L+'},
    {target:3,suffix:'',label:'Live AI Products'}
  ],
  ticker:['70+ qualified leads / month','15% organic traffic growth','Rs.2L+ monthly ad budget','3 live AI products shipped solo','3.2x → 5.5x client ROAS','Rs.1,100 → Rs.770 cost-per-lead']
};
let DATA=DEFAULTS;
try{
  fetch('/api/stats',{cache:'no-store'}).then(r=>r.json()).then(j=>{DATA=Object.assign({},DEFAULTS,j);applyData();}).catch(()=>{fetch('data.json',{cache:'no-store'}).then(r=>r.json()).then(j=>{DATA=Object.assign({},DEFAULTS,j);applyData();}).catch(()=>{});});
}catch(e){}

function applyData(){
  const sts=document.querySelectorAll('.stat');
  if(DATA.stats&&DATA.stats.length===sts.length){
    sts.forEach((el,i)=>{
      const s=DATA.stats[i];
      el.querySelector('i').textContent=s.label;
      const b=el.querySelector('.count');
      if(s.text!==undefined){b.classList.remove('count');b.textContent=s.text;b.style.background='none';b.style.color='var(--txt)';}
      else{const v=(s.value!==undefined?s.value:s.target);b.dataset.target=v;b.dataset.suffix=s.suffix||'';}
    });
  }
  renderVox(DATA.testimonials||[]);
}
function renderVox(list){
  const vox=document.getElementById('vox');if(!vox)return;
  if(!list.length)return;
  vox.innerHTML=list.map(t=>
    '<div class="v-item"><p>'+String(t.quote||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;')+'</p>'+
    '<div class="v-who"><b>'+String(t.who||'').replace(/&/g,'&amp;')+'</b><i>'+String(t.role||'').replace(/&/g,'&amp;')+'</i></div></div>').join('');
}
const TICK=DATA.ticker;let ti=0;
const tickEl=document.getElementById('tickText');
setInterval(()=>{ti=(ti+1)%TICK.length;tickEl.textContent=TICK[ti];},3800);

/* ---------- profile view counter ---------- */
const viewsEl=document.getElementById('views');
if(viewsEl){
  fetch('/api/views',{cache:'no-store'}).then(r=>r.json()).then(j=>{
    if(j&&typeof j.views==='number'){viewsEl.querySelector('b').textContent=Math.round(j.views).toLocaleString('en-IN');viewsEl.hidden=false;}
  }).catch(()=>{});
}

/* ---------- referrer-aware note ---------- */
const refNote=document.getElementById('refNote');
if(refNote){
  const ref=document.referrer||'';
  let t='';
  if(ref.indexOf('linkedin.com')>-1)t='👋 via LinkedIn';
  else if(ref.indexOf('github.com')>-1)t='⌨️ via GitHub';
  else if(/google|bing|duckduckgo|yahoo/.test(ref))t='🔎 via search';
  else if(ref){try{t='↪️ '+new URL(ref).hostname.replace(/^www\./,'');}catch(e){}}
  if(t){refNote.textContent=t;refNote.style.display='inline-block';}
}

/* ---------- live traction meter ---------- */
const traction=document.getElementById('traction'),trV=document.getElementById('trViews'),trR=document.getElementById('trResume'),trM=document.getElementById('trMsg'),trS=document.getElementById('trSpam');
function fmtN(n){return Math.round(n||0).toLocaleString('en-IN');}
function loadTraction(){
  if(!traction)return;
  fetch('/api/track',{cache:'no-store'}).then(r=>r.json()).then(j=>{
    if(j&&typeof j.views==='number'&&typeof j.resume==='number'&&typeof j.messages==='number'){
      trV.textContent=fmtN(j.views);trR.textContent=fmtN(j.resume);trM.textContent=fmtN(j.messages);
      if(trS)trS.textContent=fmtN(j.spam);
      traction.hidden=false;
    }
  }).catch(()=>{});
}
function bumpTrack(k){fetch('/api/track',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({event:k})},).then(loadTraction).catch(()=>{});ea('bumpTrack',k);}
/* Vercel Web Analytics custom event */
function ea(name,label){try{if(window.va){window.va('event',{name:name,label:label||''});}}catch(e){}}

/* ---------- role switch ---------- */
