---
import Base from '../layouts/Base.astro';

const op = {
  title: "Vamshidhar Reddy | Performance Marketer Who Builds AI Tools",
  description: "AI-augmented performance marketer in Hyderabad, India. 10+ years SEO, PPC, CRO. 3 live AI tools built solo. Open to work — performance marketing, SEO, AI marketing.",
  canonical: "https://vamshidharm.vercel.app/",
  ogImage: "",
  variant: 'index',
  active: '',
};
const body = "<div id=\"progress\"></div>\n<div id=\"glow\"></div>\n\n<section class=\"hero-stage hero-main\" id=\"heroStage\">\n  <div class=\"hero-grid-bg\" aria-hidden=\"true\"></div>\n  <canvas id=\"particles\" aria-hidden=\"true\"></canvas>\n  <div class=\"blob b1\" aria-hidden=\"true\"></div><div class=\"blob b2\" aria-hidden=\"true\"></div><div class=\"blob b3\" aria-hidden=\"true\"></div>\n  <div class=\"wrap hero-inner\" id=\"heroInner\">\n    <span class=\"tag\">Performance Marketing · SEO · AI-Augmented <span id=\"refNote\" class=\"refnote\"></span></span>\n    <h1>Performance Marketer<br/><span>who builds AI growth tools</span></h1>\n    <p id=\"heroRole\">10+ years turning paid media spend into pipeline. I plan the strategy with the CMO and build the tool that executes it — ROAS 3.2x → 5.5x, CPL −30%, 3 products shipped solo.</p>\n    <div class=\"hero-proof\">\n      <div class=\"hp-item\"><b>3.2x → 5.5x</b><span>client ROAS, same budget</span></div>\n      <div class=\"hp-item\"><b>−30%</b><span>cost-per-lead · Rs.1,100 → Rs.770</span></div>\n      <div class=\"hp-item\"><b>70+</b><span>qualified leads / month</span></div>\n    </div>\n    <div class=\"cta-row\">\n      <a class=\"btn primary btn-lg\" href=\"/contact.html#slotpick\">📅 Book a 15-min call</a>\n      <a class=\"btn btn-lg\" href=\"https://vamshidharm.vercel.app/Vamshidhar_Reddy_M_CV.pdf\" download=\"Vamshidhar_Reddy_M_CV.pdf\">Download résumé (PDF)</a>\n    </div>\n    <div class=\"socials\">\n      <a href=\"https://linkedin.com/in/vamshidharreddym\" aria-label=\"LinkedIn\" target=\"_blank\" rel=\"noopener noreferrer\"><svg viewBox=\"0 0 24 24\"><path d=\"M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45z\"/></svg></a>\n      <a href=\"https://github.com/gitvamshidhar-m\" aria-label=\"GitHub\" target=\"_blank\" rel=\"noopener noreferrer\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.91c.58.11.79-.25.79-.56v-2.03c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z\"/></svg></a>\n      <a href=\"mailto:geovamshidhar@gmail.com\" aria-label=\"Email\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z\"/></svg></a>\n    </div>\n  </div>\n</section>\n\n<section class=\"impact\" aria-label=\"Proven results\">\n  <div class=\"impact-item\"><b>−30%</b><span>Cost-per-lead</span><small>Rs.1,100 → Rs.770</small></div>\n  <div class=\"impact-item\"><b>3.2x → 5.5x</b><span>Client ROAS</span><small>same budget</small></div>\n  <div class=\"impact-item\"><b>+15%</b><span>Organic traffic</span><small>audits + technical SEO</small></div>\n  <div class=\"impact-item\"><b>70+</b><span>Leads / month</span><small>qualified, measurable</small></div>\n</section>\n\n<section id=\"cases\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Selected case studies</span>\n      <h2>Proof with a before → after</h2>\n      <p>Not screenshots of dashboards — the problem, what I did, and the measured result.</p>\n    </div>\n    <div class=\"cs-grid reveal\">\n      <article class=\"cs-card\">\n        <div class=\"cs-tag\">Paid Media · Google Ads · B2B</div>\n        <h3>Cut cost-per-lead 30% by restructuring paid media</h3>\n        <div class=\"cs-block\"><b>Problem</b><p>Spend scattered across 40+ ad groups; cost-per-lead climbing, ROAS flat.</p></div>\n        <div class=\"cs-block\"><b>What I did</b><p>Consolidated 40+ ad groups into 8, moved to target-CPA bidding, and ran a structured creative A/B roadmap.</p></div>\n        <div class=\"cs-delta\"><span class=\"cs-before\">CPL Rs.1,100</span><i>→</i><span class=\"cs-after\">Rs.770 · −30%</span></div>\n        <p class=\"cs-meta\">Context: client PPC account · 60 days · same budget</p>\n        <a class=\"cs-link\" href=\"/blog/case-study-restructuring-paid-media-cut-cpl-30.html\">Read the full case study →</a>\n      </article>\n      <article class=\"cs-card\">\n        <div class=\"cs-tag\">SEO · Technical + Content</div>\n        <h3>Grew organic traffic 15% in a year</h3>\n        <div class=\"cs-block\"><b>Problem</b><p>Organic flat; technical debt (crawl errors, speed, schema gaps) capping visibility.</p></div>\n        <div class=\"cs-block\"><b>What I did</b><p>Technical SEO audits + fixes, keyword gap analysis, content aligned to search intent, E-E-A-T hardening.</p></div>\n        <div class=\"cs-delta\"><span class=\"cs-before\">Baseline</span><i>→</i><span class=\"cs-after\">+15% organic</span></div>\n        <p class=\"cs-meta\">Context: current role · 12 months · GA4 + Search Console</p>\n        <a class=\"cs-link\" href=\"/blog/case-study-organic-traffic-15-percent-combined-with-paid.html\">Read the full case study →</a>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"projects\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Projects</span>\n      <h2>Built with Code &amp; Marketing Instinct</h2>\n      <p>Three live products I designed, built, and launched solo. Run them yourself — health badges check them in real time.</p>\n    </div>\n    <div class=\"pgrid\">\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Growth SaaS · built solo</div><div class=\"ico\">🎯</div>\n        <h3>Hook AI — Marketing Copy Engine</h3>\n        <p>An AI engine that writes conversion-ready hooks, headlines, and ad copy across 15+ niches — with its own full SEO program, email flows, and A/B hero testing.</p>\n        <div class=\"chips\"><span>Next.js</span><span>Supabase</span><span>TypeScript</span><span>Razorpay</span><span>Groq AI</span><span>Vercel</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://hook-ai-marketing-engine.vercel.app\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://hook-ai-marketing-engine.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a><a href=\"https://github.com/gitvamshidhar-m/hook-ai-marketing-engine\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a></div>\n      </div>\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Paid Media &amp; CRO suite · v13.0</div><div class=\"ico\">📈</div>\n        <h3>Creative Predictor</h3>\n        <p>Paste any ad creative and get predicted CTR, engagement &amp; conversion, plus 20+ modules — quality score, A/B testing, competitor decoder, landing-page analyzer.</p>\n        <div class=\"chips\"><span>Groq Llama 3.3</span><span>OpenAI</span><span>HuggingFace</span><span>hf.space</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://mvamshi56-creative-predictor.static.hf.space/index.html\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a></div>\n      </div>\n      <div class=\"pcard reveal\">\n        <div class=\"sub\">Growth Strategy · funnel-based</div><div class=\"ico\">🚀</div>\n        <h3>AI Growth Strategy Generator</h3>\n        <p>Answer a quick wizard — industry, budget, KPI targets (CPA/ROAS) — and get a personalized, budget-optimized, effort-vs-impact-scored marketing plan.</p>\n        <div class=\"chips\"><span>Next.js</span><span>Guided Wizard</span><span>Vercel</span></div>\n        <span class=\"status-badge checking\" data-url=\"https://strategy-generator-kwdf-beta.vercel.app\"><span class=\"sdot\"></span>Checking</span>\n        <div class=\"links\"><a href=\"https://strategy-generator-kwdf-beta.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">Live →</a></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"experience\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">Experience</span>\n      <h2>Professional Journey</h2>\n      <p>10+ years, from QA to AI-Powered Marketing specialist.</p>\n    </div>\n    <div class=\"grid2\" style=\"grid-template-columns:1.1fr .9fr;gap:26px\">\n      <div class=\"tl\">\n        <div class=\"titem reveal\"><span class=\"range\">May 2023 — Present</span><h3>Digital Marketing Specialist</h3><div class=\"co\">Autozilla Software Solutions</div><ul><li>Grew organic traffic <b style=\"color:var(--accent2)\">15%</b> via SEO audits &amp; technical fixes</li><li>Generated <b style=\"color:var(--accent2)\">70+ leads/mo</b></li><li>Managed <b style=\"color:var(--accent2)\">Rs.2L+</b> monthly ad spend</li></ul></div>\n        <div class=\"titem reveal\"><span class=\"range\">Jun 2022 — May 2023</span><h3>Campaign Specialist</h3><div class=\"co\">Pranathi Software Services</div><ul><li>LinkedIn Ads for B2B lead generation</li><li>Optimized bids to lift ROAS &amp; cut wasted spend</li></ul></div>\n        <div class=\"titem reveal\"><span class=\"range\">Feb 2021 — May 2022</span><h3>Digital Marketing Executive</h3><div class=\"co\">FAMA Technologies</div><ul><li>Integrated SEO, PPC &amp; content; A/B and CRO</li></ul></div>\n      </div>\n      <div class=\"reveal\">\n        <span class=\"tag\">The edge</span>\n        <div class=\"step\"><b style=\"color:var(--accent2)\">Both sides</b><p style=\"color:var(--muted)\">Most marketers can't code. Most developers don't understand funnels. I do both — so I ship what I plan.</p></div>\n        <div class=\"step\" style=\"margin-top:14px\"><b style=\"color:var(--accent2)\">My standard</b><p style=\"color:var(--muted)\">\"I don't just run reports — I build the pipelines that generate them.\"</p></div>\n        <p style=\"margin-top:18px\"><a class=\"btn\" href=\"/experience.html\">Full history →</a> <a class=\"btn\" href=\"/resume.html\">Printable résumé →</a></p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"contact\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\"><span class=\"tag\">Contact</span><h2>Let's Build Something Intelligent</h2></div>\n    <div class=\"reveal\" style=\"max-width:820px;margin:0 auto 26px\">\n      <p style=\"color:var(--muted);text-align:center\">Hyderabad (IST, UTC+5:30) · open to remote for the right team · <b style=\"color:var(--accent2)\">1-week notice</b> · usually replies within a business day.</p>\n      <div style=\"text-align:center;margin-top:14px\">\n        <a class=\"btn primary btn-lg\" href=\"/contact.html#slotpick\">📅 Book a 15-min intro call →</a>\n        <a class=\"btn btn-lg\" href=\"https://vamshidharm.vercel.app/Vamshidhar_Reddy_M_CV.pdf\" download=\"Vamshidhar_Reddy_M_CV.pdf\" style=\"margin-left:10px\">Download résumé (PDF)</a>\n      </div>\n    </div>\n    <div class=\"contact\">\n      <div class=\"cinfo reveal\">\n        <a class=\"citem\" href=\"https://mail.google.com/mail/?view=cm&fs=1&to=geovamshidhar@gmail.com&su=Hello%20Vamshidhar\" target=\"_blank\" rel=\"noopener noreferrer\"><div class=\"ic\">✉️</div><div><b>Email me on Gmail</b><p>geovamshidhar@gmail.com</p></div></a>\n        <a class=\"citem\" href=\"tel:+917981719085\"><div class=\"ic\">📞</div><div><b>Phone</b><p>+91-7981719085</p></div></a>\n        <div class=\"citem\"><div class=\"ic\">📍</div><div><b>Location</b><p>Hyderabad, India</p></div></div>\n        <a class=\"citem\" href=\"https://linkedin.com/in/vamshidharreddym\" target=\"_blank\" rel=\"noopener noreferrer\"><div class=\"ic\">🔗</div><div><b>LinkedIn</b><p>/in/vamshidharreddym</p></div></a>\n      </div>\n<form class=\"reveal\" id=\"contactForm\">\n  <label class=\"hp\" aria-hidden=\"true\">Company website <input name=\"hp_three\" type=\"text\" tabindex=\"-1\" autocomplete=\"off\"></label>\n  <input type=\"hidden\" name=\"t\" id=\"fLoad\" value=\"0\">\n  <label class=\"visually-hidden\" for=\"cfName\">Your name</label>\n  <input id=\"cfName\" name=\"name\" placeholder=\"Your name\" required>\n  <label class=\"visually-hidden\" for=\"cfEmail\">Your email</label>\n  <input id=\"cfEmail\" name=\"email\" type=\"email\" placeholder=\"Your email\" required>\n  <label class=\"visually-hidden\" for=\"cfSubject\">Subject</label>\n  <input id=\"cfSubject\" name=\"subject\" placeholder=\"Subject\" required>\n  <label class=\"visually-hidden\" for=\"cfMsg\">Your message</label>\n  <textarea id=\"cfMsg\" name=\"message\" rows=\"4\" placeholder=\"Your message\" required></textarea>\n  <button class=\"btn primary\" type=\"submit\">Send Message</button>\n  <p id=\"formMsg\" class=\"formmsg\" hidden></p>\n  <div class=\"dl-row\">\n    <a class=\"btn\" href=\"https://vamshidharm.vercel.app/Vamshidhar_Reddy_M_CV.pdf\" download=\"Vamshidhar_Reddy_M_CV.pdf\" rel=\"noopener noreferrer\">📄 Download résumé (PDF)</a>\n    <a class=\"btn\" href=\"https://vamshidharm.vercel.app/Vamshidhar_Reddy_M_CV.docx\" download=\"Vamshidhar_Reddy_M_CV.docx\" rel=\"noopener noreferrer\">📃 CV (.docx)</a>\n    <a class=\"btn\" href=\"https://vamshidharm.vercel.app/vamshidhar.vcf\" download=\"vamshidhar.vcf\" rel=\"noopener noreferrer\">👤 Save my contact (.vcf)</a>\n  </div>\n</form>\n\n    </div>\n  </div>\n</section>\n\n<div id=\"help\">\n  <div class=\"box\">\n    <h3>⌨️ Keyboard shortcuts</h3>\n    <div class=\"krow\"><span>Command palette</span><b>⌘K</b></div>\n    <div class=\"krow\"><span>Toggle this menu</span><b>?</b></div>\n    <div class=\"krow\"><span>Toggle theme</span><b>T</b></div>\n    <div class=\"krow\"><span>Go to Projects</span><b>P</b></div>\n    <div class=\"krow\"><span>Go to Contact</span><b>C</b></div>\n    <div class=\"krow\"><span>Secret 🎉</span><b>vamshidhar</b></div>\n  </div>\n</div>\n\n<div id=\"palette\" role=\"dialog\" aria-label=\"Command palette\">\n  <div class=\"pal-box\">\n    <input id=\"palIn\" type=\"text\" placeholder=\"Search actions…\" autocomplete=\"off\" aria-label=\"Search commands\" />\n    <div class=\"pal-list\" id=\"palList\"></div>\n  </div>\n</div>\n";
---
<Base {...op} mixin={false}>
  <Fragment set:html={body} />
  <script is:inline>(function(){
  var f=document.getElementById('contactForm');if(!f)return;
  var msg=document.getElementById('formMsg');
  var fl=document.getElementById('fLoad');
  var loadTime=Date.now();
  if(fl)fl.value=loadTime;
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var fl2=document.getElementById('fLoad');
    if(fl2)fl2.value=String(Date.now()-loadTime);
    var btn=f.querySelector('button[type=submit]');btn.disabled=true;btn.textContent='Sending…';
    var body={};new FormData(f).forEach(function(v,k){body[k]=v;});
    fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      .then(function(r){return r.json();})
      .then(function(j){
        msg.hidden=false;
        if(j&&j.ok&&j.delivered){msg.className='formmsg ok';msg.textContent='Thanks — message received. I usually reply within a day.';f.reset();}
        else{msg.className='formmsg err';msg.textContent='Message captured. For the fastest reply, email me directly: geovamshidhar@gmail.com';}
      })
      .catch(function(){msg.hidden=false;msg.className='formmsg err';msg.textContent='Network error — please email me directly: geovamshidhar@gmail.com';})
      .then(function(){btn.disabled=false;btn.textContent='Send Message';});
  });
})();</script>
  <script is:inline>
  (function () {
    var v = (new URLSearchParams(location.search)).get('v') || 'a';
    var role = document.getElementById('heroRole');
    var tag = document.querySelector('.hero-stage .tag');
    if (v === 'b' && role) {
      role.textContent = 'The marketer who codes. I run performance marketing AND ship the AI tools behind it — 3 live products (ROAS 3.2x→5.5x, CPL −30%), all measurable on this page.';
      if (tag) tag.textContent = '⚡ Live A/B: variant B active. Performance Marketing · SEO · AI-Augmented.';
    }
    try { localStorage.setItem('ab_v', v); if (window.va) window.va('event', { name: 'hero_variant', label: v }); } catch (e) {}
    var vNote = document.createElement('div');
    vNote.id = 'vnote';
    vNote.innerHTML = '<span class="vn-body">⚡ You are seeing homepage variant <b>' + v.toUpperCase() + '</b> — this page is itself an A/B test. ' + (v === 'b' ? 'Meta, right?' : '<i>Try ?v=b</i>') + '</span><button class="vn-x" aria-label="Dismiss">×</button>';
    document.body.appendChild(vNote);
    vNote.querySelector('.vn-x').addEventListener('click', function (e) {
      e.stopPropagation();
      try { localStorage.setItem('vnote_done', '1'); } catch (err) {}
      vNote.remove();
    });
    vNote.addEventListener('click', function () {
      try { if (window.va) window.va('event', { name: 'hero_variant', label: 'switch' }); } catch (e) {}
      location.href = location.pathname + (v === 'b' ? '' : '?v=b');
    });
    if (v !== 'b') {
      try { if (localStorage.getItem('vnote_done')) vNote.remove(); } catch (e) {}
    }
    setTimeout(function () { if (vNote.isConnected) vNote.classList.add('show'); }, 1200);
  })();
  </script>
  <script is:inline>
  (function () {
    var f=document.getElementById('contactForm');
    if(f)f.addEventListener('submit',function(){setTimeout(function(){try{if(window.va)window.va('event',{name:'form_submit',label:'contact'});}catch(e){}},2500);});
  })();
  </script>
  <script is:inline>
  (function(){
    /* referrer note */
    var refNote=document.getElementById('refNote');
    if(refNote){
      var ref=document.referrer||'';var t='';
      if(ref.indexOf('linkedin.com')>-1)t='👋 via LinkedIn';
      else if(ref.indexOf('github.com')>-1)t='⌨️ via GitHub';
      else if(/google|bing|duckduckgo|yahoo/.test(ref))t='🔎 via search';
      else if(ref){try{t='↪️ '+new URL(ref).hostname.replace(/^www\./,'');}catch(e){}}
      if(t){refNote.textContent=t;refNote.style.display='inline-block';}
    }
    /* scroll progress + to-top */
    var prog=document.getElementById('progress'),toTop=document.getElementById('toTop');
    addEventListener('scroll',function(){
      var h=document.documentElement;
      if(prog)prog.style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+'%';
      if(toTop)toTop.classList.toggle('show',h.scrollTop>600);
    },{passive:true});
    if(toTop)toTop.addEventListener('click',function(){scrollTo({top:0,behavior:'smooth'});});
    /* cursor glow */
    var glow=document.getElementById('glow');
    if(glow){
      var gx=innerWidth/2,gy=innerHeight/2,tgx=gx,tgy=gy;
      addEventListener('mousemove',function(e){tgx=e.clientX;tgy=e.clientY;});
      (function gLoop(){gx+=(tgx-gx)*.12;gy+=(tgy-gy)*.12;glow.style.left=gx+'px';glow.style.top=gy+'px';requestAnimationFrame(gLoop);})();
    }
    /* reveal */
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target);}});},{threshold:.15});
    document.querySelectorAll('.reveal').forEach(function(x){io.observe(x);});
    /* theme + menu */
    var tb=document.getElementById('themeBtn'),html=document.documentElement;
    function toggleTheme(){var d=html.getAttribute('data-theme')==='dark'?'light':'dark';html.setAttribute('data-theme',d);if(tb)tb.textContent=d==='dark'?'🌙':'☀️';try{localStorage.setItem('don-theme',d);}catch(e){}}
    if(tb){tb.addEventListener('click',toggleTheme);tb.textContent=html.getAttribute('data-theme')==='dark'?'🌙':'☀️';}
    var mb=document.getElementById('menuBtn'),mm=document.getElementById('mmenu');
    if(mb&&mm){mb.addEventListener('click',function(){var on=mm.classList.toggle('on');mb.textContent=on?'✕':'☰';mb.setAttribute('aria-label',on?'Close menu':'Open menu');});mm.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){mm.classList.remove('on');mb.textContent='☰';mb.setAttribute('aria-label','Open menu');});});}
    var nmb=document.querySelector('.nav-more-btn'),nmd=document.querySelector('.nav-more-drop');
    if(nmb&&nmd){nmb.addEventListener('click',function(e){e.stopPropagation();var on=nmd.classList.toggle('on');nmb.setAttribute('aria-expanded',on?'true':'false');});document.addEventListener('click',function(e){if(!e.target.closest('.nav-more')){nmd.classList.remove('on');nmb.setAttribute('aria-expanded','false');}});}
    /* live product health */
    document.querySelectorAll('.status-badge').forEach(function(b){
      var url=b.dataset.url;
      fetch(url,{method:'HEAD',mode:'no-cors',cache:'no-store'}).then(function(){b.className='status-badge live';b.innerHTML='<span class="sdot"></span>Live';}).catch(function(){b.className='status-badge down';b.innerHTML='<span class="sdot"></span>Unreachable';});
    });
    /* particles */
    var cv=document.getElementById('particles');
    if(cv&&cv.getContext){
      var ctx=cv.getContext('2d');var P=[],W,H;
      function resize(){W=cv.width=innerWidth;H=cv.height=innerHeight;}resize();addEventListener('resize',resize);
      for(var i=0;i<28;i++)P.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.4+.3,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35});
      var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
      function part(){
        ctx.clearRect(0,0,W,H);
        for(var i=0;i<P.length;i++){
          var p=P[i];p.x+=p.vx;p.y+=p.vy;
          if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1;
          ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle='rgba(120,120,255,.5)';ctx.fill();
          for(var j=i+1;j<P.length;j++){
            var q=P[j],dx=p.x-q.x,dy=p.y-q.y,d=dx*dx+dy*dy;
            if(d<110*110){ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.strokeStyle='rgba(120,120,255,'+(.16*(1-d/(110*110)))+')';ctx.stroke();}
          }
        }
        if(!RM)requestAnimationFrame(part);
      }
      part();
    }
    /* keyboard shortcuts */
    var help=document.getElementById('help');
    var buf='';
    addEventListener('keydown',function(e){
      var k=e.key.toLowerCase();
      if(e.key==='Escape'){if(help)help.classList.remove('on');if(mm)mm.classList.remove('on');if(mb){mb.textContent='☰';mb.setAttribute('aria-label','Open menu');}return;}
      if(e.target.tagName==='INPUT'||e.target.tagName==='SELECT'||e.target.tagName==='TEXTAREA')return;
      if(k==='?'){e.preventDefault();if(help)help.classList.toggle('on');return;}
      if(k==='t')toggleTheme();
      var secs={p:'#projects',c:'#contact'};
      if(secs[k]){var el=document.querySelector(secs[k]);if(el)el.scrollIntoView();}
      buf=(buf+k).slice(-12);
      if(buf==='vamshidhar')confetti();
    });
    if(help)help.addEventListener('click',function(e){if(e.target===help)help.classList.remove('on');});
    function confetti(){
      if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
      var COLORS=['#6d5bff','#2ff3c0','#ff8a4c','#ff6b81','#ffd93d'];
      for(var i=0;i<60;i++){
        var s=document.createElement('div');s.className='confetti';
        s.style.left=Math.random()*100+'vw';
        s.style.background=COLORS[Math.floor(Math.random()*COLORS.length)];
        s.style.animationDuration=(Math.random()*1.6+1.2)+'s';
        s.style.animationDelay=(Math.random()*.6)+'s';
        s.style.transform='rotate('+Math.random()*360+'deg)';
        document.body.appendChild(s);
        setTimeout(function(){s.remove();},3200);
      }
    }
    /* command palette */
    var pal=document.getElementById('palette'),palIn=document.getElementById('palIn'),palList=document.getElementById('palList');
    if(pal&&palIn&&palList){
      var COMMANDS=[
        {label:'About',href:'/about.html'},{label:'Work / Projects',href:'/projects.html'},{label:'Case Studies',href:'/blog.html'},{label:'Contact',href:'/contact.html'},
        {label:'Experience',href:'/experience.html'},{label:'Skills',href:'/skills.html'},{label:'FAQ',href:'/faq.html'},{label:'Hire Me',href:'/hire.html'},{label:'Changelog',href:'/changelog.html'},{label:'Resume',href:'/resume.html'},
        {label:'Download résumé (PDF)',act:function(){location.href='/Vamshidhar_Reddy_M_CV.pdf';}},
        {label:'Download CV (.docx)',act:function(){location.href='/Vamshidhar_Reddy_M_CV.docx';}},
        {label:'Save contact (.vcf)',act:function(){location.href='/vamshidhar.vcf';}},
        {label:'Toggle theme',act:toggleTheme}
      ];
      var palSel=0,palItems=[];
      function palOpen(){pal.classList.add('open');palSel=0;palIn.value='';palFilter('');palIn.focus();}
      function palClose(){pal.classList.remove('open');palIn.blur();}
      function palGo(cmd){
        palClose();
        if(cmd.act)cmd.act();
        else if(cmd.href){if(cmd.href.indexOf('http')===0)location.href=cmd.href;else{var el=document.getElementById(cmd.href.slice(1));if(el)el.scrollIntoView({behavior:'smooth'});else location.href=cmd.href;}}
      }
      function palFilter(q){
        q=(q||'').toLowerCase();
        palItems=COMMANDS.filter(function(c){return c.label.toLowerCase().indexOf(q)>-1;});
        renderPal();
      }
      function renderPal(){
        if(!palItems.length){palList.innerHTML='<div class="pal-empty">No matches</div>';return;}
        palList.innerHTML=palItems.slice(0,12).map(function(c,i){return '<div class="pal-item'+(i===palSel?' sel':'')+'" data-i="'+i+'"><span>'+(c.icon||'→')+' '+c.label+'</span><span class="pk">↵</span></div>';}).join('');
        palList.querySelectorAll('.pal-item').forEach(function(el){el.addEventListener('click',function(){palSel=+el.dataset.i;palGo(palItems[+el.dataset.i]);});});
        var sel=palList.querySelector('.sel');if(sel)sel.scrollIntoView({block:'nearest'});
      }
      addEventListener('keydown',function(e){
        if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();pal.classList.contains('open')?palClose():palOpen();return;}
        if(pal.classList.contains('open')){
          if(e.key==='Escape'){e.preventDefault();palClose();}
          else if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();palSel=(palSel+(e.key==='ArrowDown'?1:-1)+COMMANDS.length)%COMMANDS.length;renderPal();}
          else if(e.key==='Enter'){e.preventDefault();var c=palItems[palSel];if(c)palGo(c);}
        }
      });
      palIn.addEventListener('input',function(){palSel=0;palFilter(palIn.value);});
    }
    /* clock */
    function clock(){
      var e=document.getElementById('clock');
      if(e)e.textContent='⏱ '+new Date().toLocaleTimeString('en-IN',{timeZone:'Asia/Kolkata',hour12:true});
    }
    clock();setInterval(clock,1000);
    /* analytics + SW */
    if('serviceWorker' in navigator&&!window.__swRegistered){window.__swRegistered=true;addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){});});}
    if(!window.__analyticsFired){window.__analyticsFired=true;fetch('/api/analytics',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({path:location.pathname,referrer:document.referrer,ua:navigator.userAgent})}).catch(function(){});}
  })();
  </script>

