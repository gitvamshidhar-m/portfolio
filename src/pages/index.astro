    const s=document.createElement('div');s.className='confetti';
    s.style.left=Math.random()*100+'vw';
    s.style.background=COLORS[Math.floor(Math.random()*COLORS.length)];
    s.style.animationDuration=(Math.random()*1.6+1.2)+'s';
    s.style.animationDelay=(Math.random()*.6)+'s';
    s.style.transform='rotate('+Math.random()*360+'deg)';
    document.body.appendChild(s);
    setTimeout(()=>s.remove(),3200);
  }
}

/* ---------- ROI calc ---------- */
function inr(n){return '₹'+Math.round(n).toLocaleString('en-IN');}
function fmt(n){return Math.round(n).toLocaleString('en-IN');}
function calc(){
  const visits=+document.getElementById('visits').value;
  const cr=+document.getElementById('conv').value;
  const rev=+document.getElementById('rev').value;
  const ads=+document.getElementById('ads').value;
  const leads=Math.round(visits*(cr/100));
  const traffic=Math.round(visits*0.15);
  const croGain=Math.round(leads*rev*0.12);
  const roasGain=Math.round(ads*0.25);
  const total=croGain+roasGain;
  document.getElementById('calcOut').innerHTML=
    '<div class="co-row"><span>Organic traffic lift (15%)</span><b>+'+fmt(traffic)+'</b></div>'+
    '<div class="co-row"><span>Additional leads / month</span><b>+'+fmt(leads)+'</b></div>'+
    '<div class="co-row"><span>CRO uplift (+12% conversion)</span><b>'+inr(croGain)+'</b></div>'+
    '<div class="co-row"><span>Paid ads ROAS gain (+25%)</span><b>'+inr(roasGain)+'</b></div>'+
    '<div class="co-row big"><span>Total monthly impact</span><b>'+inr(total)+'</b></div>';
}
document.getElementById('visits').addEventListener('input',function(){document.getElementById('mv').textContent=fmt(this.value);calc();});
document.getElementById('conv').addEventListener('input',function(){document.getElementById('cr').textContent=this.value+'%';calc();});
document.getElementById('rev').addEventListener('input',function(){document.getElementById('rv').textContent=inr(this.value);calc();});
document.getElementById('ads').addEventListener('input',function(){document.getElementById('pb').textContent=inr(this.value);calc();});
calc();
if('serviceWorker' in navigator&&!window.__swRegistered){window.__swRegistered=true;addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){});});}
if(!window.__analyticsFired){window.__analyticsFired=true;fetch('/api/analytics',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({path:location.pathname,referrer:document.referrer,ua:navigator.userAgent})}).catch(function(){});}
</script>
<script is:inline>
(function(){
  var stage=document.getElementById('heroStage');
  if(!stage)return;
  var reduces=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hero=stage.querySelector('h1');
  var tag=stage.querySelector('.tag');
  var typewrap=stage.querySelector('.type-wrap');
  var roles=stage.querySelector('.role-switch');
  var ticker=stage.querySelector('.ticker');
  var socials=stage.querySelector('.socials');
  var ctaRow=stage.querySelector('.cta-row');
  var sub=stage.querySelector('#heroRole');
  var grid=stage.querySelector('.hero-grid-bg');
  var inner=stage.querySelector('.hero-inner');
  var mse=stage.querySelector('.mouse');
  var beats=Array.prototype.slice.call(stage.querySelectorAll('.h-beat'));
  var bar=stage.querySelector('.h-progress span');
  function clamp(v,a,b){return Math.max(a,Math.min(b,v));}
  if(reduces){
    if(bar)bar.style.transform='scaleX(1)';
    if(reduces){}
  }
  function draw(){
    var top=stage.getBoundingClientRect().top;
    var vh=window.innerHeight;
    var max=Math.max(1,(stage.offsetHeight-vh));
    var s=clamp(-top/max,0,1);
    var intro=clamp(s/0.35,0,1);
    var socialFade=clamp((s-0.12)/0.3,0,1);
    var ctaFade=clamp((s-0.45)/0.3,0,1);
    var tops=[tag,hero,typewrap,roles,ticker,sub];
    for(var i=0;i<tops.length;i++){if(tops[i])tops[i].style.opacity=String(1-intro);}
    if(socials)socials.style.opacity=String(1-socialFade);
    if(ctaRow)ctaRow.style.opacity=String(clamp(1-ctaFade,0.15,1));
    if(mse)mse.style.opacity=String(1-clamp(s/0.4,0,1));
    if(grid)grid.style.transform='translateY('+(s*110)+'px)';
    if(hero)hero.style.transform='translateY('+(s*-46)+'px) scale('+(1-s*0.12)+')';
    if(inner)inner.style.transform='translateY('+(s*-120)+'px)';
    beats.forEach(function(b,i){if(b)b.style.opacity=String(clamp((s-(0.55+i*0.15))/0.28,0,1));});
    if(bar)bar.style.transform='scaleX('+s+')';
  }
  if(reduces){if(bar)bar.style.transform='scaleX(1)';return;}
  var ticking=false;
  function onScroll(){if(!ticking){ticking=true;requestAnimationFrame(function(){ticking=false;draw();});}}
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',onScroll);
  draw();
})();
</script>
