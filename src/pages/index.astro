function roleMatch(k){
  const r=k.toLowerCase();
  if(/seo/i.test(r))return "For an SEO role: I've grown organic traffic ~15% via audits, technical fixes, keyword strategy and E-E-A-T hardening — GA4, Search Console, Screaming Frog, Ahrefs/SEMrush. This portfolio proves it: semantic HTML, one h1, JSON-LD, RSS, sitemap/robots/llms.txt.";
