>Send Message</button>\n  <p id=\"formMsg\" class=\"formmsg\" hidden></p>\n  <div class=\"dl-row\">\n    <a class=\"btn\" href=\"https://vamshidharm.vercel.app/Vamshidhar_Reddy_M_CV.docx\" download=\"Vamshidhar_Reddy_M_CV.docx\" rel=\"noopener noreferrer\">📄 Download CV (.docx)</a>\n    <a class=\"btn\" href=\"https://vamshidharm.vercel.app/vamshidhar.vcf\" download=\"vamshidhar.vcf\" rel=\"noopener noreferrer\">👤 Save my contact (.vcf)</a>\n  </div>\n  <div class=\"recruit\" id=\"rrAnchor\">\n    <button class=\"btn recruit-toggle\" id=\"recruitToggle\" type=\"button\" aria-expanded=\"false\">⚡ Recruiter fast-track · intro → email (1 click)</button>\n    <div class=\"recruit-panel\" id=\"recruitPanel\">\n      <div>\n        <label>I'm hiring for</label>\n        <select id=\"rrRole\">\n          <option>SEO Manager / Specialist</option>\n          <option>PPC / Google Ads Specialist</option>\n          <option>Performance Marketing</option>\n          <option>AI / Product Marketing</option>\n          <option>Digital Marketing Manager</option>\n        </select>\n      </div>\n      <div>\n        <label>My team's go-to-market budget</label>\n        <select id=\"rrBudget\">\n          <option>Below ₹1L / month</option>\n          <option>₹1L–3L / month</option>\n          <option>₹3L+ / month</option>\n        </select>\n      </div>\n      <div>\n        <label>Start window you need</label>\n        <select id=\"rrStart\">\n          <option>ASAP (≈1 week)</option>\n          <option>This month</option>\n          <option>Next month</option>\n          <option>Flexible</option>\n        </select>\n      </div>\n      <div class=\"recruit-actions\">\n        <a class=\"btn primary\" id=\"rrMail\" href=\"https://mail.google.com/mail/?view=cm&fs=1&to=geovamshidhar@gmail.com\" target=\"_blank\" rel=\"noopener noreferrer\">✉️ Open intro email on Gmail</a>\n        <button class=\"btn\" id=\"rrCopy\" type=\"button\">📋 Copy summary</button>\n      </div>\n      <textarea id=\"rrText\" readonly rows=\"5\"></textarea>\n      <div class=\"qr\"><img id=\"rrQR\" alt=\"QR code — my resume\" loading=\"lazy\" /><span style=\"font-size:12.5px;color:var(--muted)\">Scan → opens my resume. <br/>Unhurried — this whole page is the proof.</span></div>\n    </div>\n  </div>\n</form>\n\n    </div>\n  </div>\n</section>\n\n<div id=\"help\">\n  <div class=\"box\">\n    <h3>⌨️ Keyboard shortcuts</h3>\n    <div class=\"krow\"><span>Command palette</span><b>⌘K</b></div>\n    <div class=\"krow\"><span>Toggle this menu</span><b>?</b></div>\n    <div class=\"krow\"><span>Toggle theme</span><b>T</b></div>\n    <div class=\"krow\"><span>Go to About</span><b>A</b></div>\n    <div class=\"krow\"><span>Go to Projects</span><b>P</b></div>\n    <div class=\"krow\"><span>Go to Hook Lab</span><b>H</b></div>\n    <div class=\"krow\"><span>Go to Experience</span><b>E</b></div>\n    <div class=\"krow\"><span>Go to Skills</span><b>S</b></div>\n    <div class=\"krow\"><span>Go to ROI</span><b>I</b></div>\n    <div class=\"krow\"><span>Go to Contact</span><b>C</b></div>\n    <div class=\"krow\"><span>Secret 🎉</span><b>vamshidhar</b></div>\n  </div>\n</div>\n\n<div id=\"palette\" role=\"dialog\" aria-label=\"Command palette\">\n  <div class=\"pal-box\">\n    <input id=\"palIn\" type=\"text\" placeholder=\"Search actions…\" autocomplete=\"off\" aria-label=\"Search commands\" />\n    <div class=\"pal-list\" id=\"palList\"></div>\n  </div>\n</div>";
