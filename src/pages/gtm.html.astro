---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';

const op = {
  title: "GTM Launch Agent — Autonomous 9-Agent Go-To-Market Studio | Vamshidhar Reddy",
  description: "The GTM Launch Agent is an autonomous 9-agent go-to-market studio: a Strategist plans the angle with a reasoning model (and shows its chain-of-thought), a Researcher mines live search for the category, an ICP agent profiles buyers, an Offer agent prices it, a Channel agent splits the budget, a Message agent stress-tests the positioning, a Skeptic audits every claim, a Planner builds the timeline, and a Publisher assembles a launch-ready one-pager.",
  canonical: "https://vamshidharm.vercel.app/gtm.html",
  ogImage: "",
  variant: 'sub',
  active: '/gtm.html',
};
const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "What is the GTM Launch Agent?", acceptedAnswer: { "@type": "Answer", text: "An autonomous go-to-market studio made of nine agents that collaborate on a single product. The Strategist plans the angle with a reasoning model and surfaces its chain-of-thought; the Researcher runs a live SERP query; the ICP agent profiles buyers; the Offer agent prices it; the Channel agent splits the budget; the Message agent stress-tests the positioning; the Skeptic audits every claim and verifies the citation URLs resolve; the Planner builds the timeline; and the Publisher assembles a launch-ready one-pager with a checklist." } },
    { "@type": "Question", name: "Is the launch plan real?", acceptedAnswer: { "@type": "Answer", text: "Yes. Every agent's tool really executes. The Researcher runs a live SERP query and shows the actual results; the rest run real deterministic tools grounded in that research plus a knowledge base of verified facts. The Strategist uses a reasoning model so you can see how it arrived at the angle." } },
    { "@type": "Question", name: "What makes it different from the Content Engine?", acceptedAnswer: { "@type": "Answer", text: "The Content Engine produces a publish-ready article; the GTM Launch Agent produces a launch-ready go-to-market plan. Same nine-agent pattern and the same reasoning-model Strategist, but the downstream agents are ICP, Offer, Channel, Message, Planner and Publisher instead of Writer, Editor, SEO, Connector and Amplifier." } }
  ]
});
const jsonLd = JSON.stringify({
  "@context": "https://schema.org", "@type": "SoftwareApplication",
  name: "GTM Launch Agent", applicationCategory: "BusinessApplication",
  operatingSystem: "Web", offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }
});

const body = `<section class="lpage-wrap">
  <div class="wrap">
    <div class="ag-hero">
      <div class="ag-hero-copy">
        <span class="tag">GTM Launch Agent · Agentic go-to-market studio</span>
        <h1>Nine agents. One launch. A launch-ready one-pager.</h1>
        <p style="color:var(--muted)">Launch planning is slow and full of guesswork. <b style="color:var(--accent2)">The GTM Launch Agent runs the whole pipeline instead.</b> A Strategist sets the angle <b style="color:var(--accent2)">with a reasoning model that shows its chain-of-thought</b>, a Researcher mines live search and returns real citations, an ICP agent profiles buyers, an Offer agent prices it, a Channel agent splits the budget, a Message agent stress-tests the positioning, a Skeptic audits every claim, a Planner builds the timeline, and a Publisher hands back a launch-ready one-pager with a checklist.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn primary btn-lg" href="#demo">▶ Run the GTM Agent</a>
          <a class="btn link-secondary" href="/content.html">See the Content Engine →</a>
        </div>
      </div>
      <div class="ag-orbit" aria-hidden="true">
        <svg class="ag-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
          <line data-agent="strategist" x1="50" y1="50" x2="4" y2="30"></line>
          <line data-agent="researcher" x1="50" y1="50" x2="24" y2="14"></line>
          <line data-agent="icp" x1="50" y1="50" x2="74" y2="11"></line>
          <line data-agent="offer" x1="50" y1="50" x2="9" y2="46"></line>
          <line data-agent="channel" x1="50" y1="50" x2="50" y2="3"></line>
          <line data-agent="message" x1="50" y1="50" x2="90" y2="44"></line>
          <line data-agent="skeptic" x1="50" y1="50" x2="4" y2="72"></line>
          <line data-agent="planner" x1="50" y1="50" x2="50" y2="84"></line>
          <line data-agent="publisher" x1="50" y1="50" x2="96" y2="72"></line>
          <line data-agent="simulator" x1="50" y1="50" x2="74" y2="86"></line>
        </svg>
        <div class="ag-core"><span>PRODUCT</span><i></i></div>
        <span class="ag-sat" data-agent="strategist" style="top:30%;left:4%;--agc:#c3a6ff">🧭</span>
        <span class="ag-sat" data-agent="researcher" style="top:14%;left:24%;--agc:#49b6ff">🔍</span>
        <span class="ag-sat" data-agent="icp" style="top:11%;left:74%;--agc:#8b7bff">👤</span>
        <span class="ag-sat" data-agent="offer" style="top:46%;left:9%;--agc:#ff9e5c">💰</span>
        <span class="ag-sat" data-agent="channel" style="top:3%;left:50%;--agc:#6ee7b7">📡</span>
        <span class="ag-sat" data-agent="message" style="top:44%;left:90%;--agc:#ffd479">✍️</span>
        <span class="ag-sat" data-agent="skeptic" style="top:72%;left:4%;--agc:#ff8a8a">⚖️</span>
        <span class="ag-sat" data-agent="planner" style="top:84%;left:50%;--agc:#7dd3fc">🗓️</span>
        <span class="ag-sat" data-agent="publisher" style="top:72%;left:96%;--agc:#fda4af">🚀</span>
        <span class="ag-sat" data-agent="simulator" style="top:86%;left:74%;--agc:#b6ff9e">🎲</span>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <div class="ag-pipeline">
      <div class="ag-pipe">
        <div class="ag-node" style="--agc:#c3a6ff"><span class="ag-nico">🧭</span><b>Strategist</b><i>angle brief</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#49b6ff"><span class="ag-nico">🔍</span><b>Researcher</b><i>live SERP</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#8b7bff"><span class="ag-nico">👤</span><b>ICP</b><i>buyer profiles</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#ff9e5c"><span class="ag-nico">💰</span><b>Offer</b><i>pricing tiers</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#6ee7b7"><span class="ag-nico">📡</span><b>Channel</b><i>budget split</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#ffd479"><span class="ag-nico">✍️</span><b>Message</b><i>positioning</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#ff8a8a"><span class="ag-nico">⚖️</span><b>Skeptic</b><i>claim audit</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#7dd3fc"><span class="ag-nico">🗓️</span><b>Planner</b><i>launch calendar</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#fda4af"><span class="ag-nico">🚀</span><b>Publisher</b><i>one-pager</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#b6ff9e"><span class="ag-nico">🎲</span><b>Simulator</b><i>Monte Carlo</i></div>
      </div>
      <div class="ag-loop"><b>Reasoning in the loop:</b> the Strategist uses a reasoning model (Groq) and shows its chain-of-thought before the rest of the studio builds on the angle. Every downstream agent runs a real tool — live SERP, ICP builders, pricing, budget math, claim verification.</div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">The team</span><h2 style="font-size:clamp(20px,3vw,26px)">A launch studio that plans like a growth lead</h2></div>
      <div class="ab-grid">
        <div class="ab-variant"><b>🧭 Strategist Agent</b><span class="ag-persona">The Cartographer</span><p>Sets the GTM angle, positioning, launch hypothesis and the one metric this launch must move — using a reasoning model whose thinking is shown to you.</p></div>
        <div class="ab-variant"><b>🔍 Researcher Agent</b><span class="ag-persona">The Archaeologist</span><p>Runs a real live search on the category and returns actual sources, citations, keyword set and competitor signals — nothing hallucinated.</p></div>
        <div class="ab-variant"><b>👤 ICP Agent</b><span class="ag-persona">The Profiler</span><p>Builds 2-3 buyer profiles from the research — pains, triggers and objections — that the Offer and Message agents write against.</p></div>
        <div class="ab-variant"><b>💰 Offer Agent</b><span class="ag-persona">The Pricer</span><p>Prices the product into tiers with a decoy anchor so the hero offer sells itself, grounded in the ICP and category.</p></div>
        <div class="ab-variant"><b>📡 Channel Agent</b><span class="ag-persona">The Allocator</span><p>Splits the launch budget across channels by CAC efficiency and reach, returning a real percentage split.</p></div>
        <div class="ab-variant"><b>✍️ Message Agent</b><span class="ag-persona">The Stress-Tester</span><p>Drafts the hook and stress-tests the positioning against the ICP pains and the Skeptic's objections, issuing a verdict.</p></div>
        <div class="ab-variant"><b>⚖️ Skeptic Agent</b><span class="ag-persona">The Devil's Advocate</span><p>Audits every claim, verifies the citation URLs actually resolve and scores launch-risk before publishing.</p></div>
        <div class="ab-variant"><b>🗓️ Planner Agent</b><span class="ag-persona">The Scheduler</span><p>Builds the 0-30 day launch calendar from the plan, sequencing paid, owned and community channels.</p></div>
        <div class="ab-variant"><b>🚀 Publisher Agent</b><span class="ag-persona">The Launcher</span><p>Assembles the launch-ready one-pager — slug, meta title/description, a markdown export and a launch checklist.</p></div>
        <div class="ab-variant"><b>⚔️ Competitor Agent</b><span class="ag-persona">The Incumbent</span><p>Surfaces the real incumbents the Researcher found and challenges the angle on their turf, so the studio debates against live competition instead of a strawman.</p></div>
        <div class="ab-variant"><b>🎲 Market Simulator</b><span class="ag-persona">The Oddsmaker</span><p>Runs 400 Monte Carlo launches across the budget, price and channel mix to estimate CAC, payback and the probability you hit the goal — then re-simulates live as you drag the sliders.</p></div>
      </div>
  </div>

  <div class="wrap" id="demo" style="margin-top:44px;scroll-margin-top:90px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">Live demo · GTM Launch Agent</span><h2 style="font-size:clamp(22px,3.4vw,30px)">Give it a product. Get a launch plan.</h2>
    <p style="color:var(--muted);max-width:680px">Type a product (and optionally an audience and a goal). The nine agents will brief the angle with a reasoning model, mine live search, profile ICPs, price the offer, split the budget, stress-test the messaging, audit every claim, build the timeline and assemble a launch-ready one-pager. Runs on Groq when a key is set; otherwise the same real tools run with a rule-based strategist.</p></div>
    <div class="ag-console">
        <div class="ag-input">
         <label for="productInput">Product to launch</label>
         <input id="productInput" type="text" placeholder="e.g. an AI lead-scoring SaaS for B2B agencies" />
         <div class="ag-row">
           <div><label for="audInput" style="font-size:12px;color:var(--muted)">Audience</label>
           <input id="audInput" type="text" placeholder="e.g. agency owners" /></div>
           <div><label for="goalInput" style="font-size:12px;color:var(--muted)">Primary goal</label>
           <input id="goalInput" type="text" placeholder="e.g. lower cost-per-lead" /></div>
         </div>
         <div class="ag-runrow">
           <button id="runBtn" class="btn primary btn-lg" type="button">▶ Run GTM Agent</button>
           <span id="ceMode" class="ag-mode" hidden></span>
           <span id="ceSerp" class="ag-mode serp" hidden></span>
           <span class="ag-hint">Try: “an AI ad-creative tool for D2C brands” or “a founder coaching program”.</span>
         </div>
       </div>
      <div class="ag-stage" id="agStage" hidden>
        <div class="ag-orch" id="agOrch"></div>
        <div class="ag-agents" id="agAgents"></div>
        <div class="ag-log" id="agLog"></div>
      </div>
      <div class="ce-brief" id="ceBrief" hidden></div>
      <div class="ag-share-row" id="ceShareRow" hidden>
        <button type="button" class="btn" id="ceCopyBtn">⧉ Copy plan</button>
        <button type="button" class="btn" id="ceMdBtn">⬇ One-pager MD</button>
        <button type="button" class="btn" id="ceTxtBtn">⬇ Plain text</button>
      </div>
    </div>
  </div>

  <div class="wrap" id="warRoom" style="margin-top:44px;display:none;scroll-margin-top:90px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">Launch War-Room · debate + Monte Carlo</span><h2 style="font-size:clamp(22px,3.4vw,30px)">We war-game the angle, then simulate the funnel</h2>
    <p style="color:var(--muted);max-width:680px">The Competitor Agent challenges the angle on live incumbents, the studio debates it, then a Market Simulator runs 400 launches to estimate CAC, payback and the probability you hit your goal. Drag the sliders to re-plan live.</p></div>
    <div class="wr-grid">
      <div class="wr-col">
        <b>⚔️ Debate Theatre</b>
        <div class="wr-transcript" id="debateLog"></div>
      </div>
      <div class="wr-col">
        <b>🎲 Market Simulator</b>
        <div class="wr-gauge"><span class="wr-gnum" id="simGauge">–</span><i>P(hit goal)</i></div>
        <div class="wr-bars">
          <div class="wr-bar"><label>CAC (₹)</label><div class="wr-barv"><b id="simCac">–</b><small>p10 / p50 / p90</small></div></div>
          <div class="wr-bar"><label>Qualified leads / 30d</label><div class="wr-barv"><b id="simLeads">–</b></div></div>
          <div class="wr-bar"><label>Payback (days)</label><div class="wr-barv"><b id="simPay">–</b></div></div>
        </div>
        <div class="wr-sliders">
          <div class="wr-sl"><label>Budget <span id="simBudgetV"></span></label><input id="simBudget" type="range" min="50000" max="1000000" step="10000"></div>
          <div class="wr-sl"><label>Hero price <span id="simPriceV"></span></label><input id="simPrice" type="range" min="1000" max="200000" step="1000"></div>
          <div id="simMixWrap" class="wr-mix"></div>
        </div>
        <div class="ag-hint" id="simGoalNote"></div>
      </div>
    </div>
    <div class="blk" style="margin-top:14px"><b>📈 Measurement plan</b><div id="measBlock" style="margin-top:6px">–</div></div>
  </div>

  <div class="wrap" style="margin-top:44px">
    <span class="tag">Common questions</span>
    <div style="display:grid;gap:10px;margin-top:16px;max-width:820px">
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">What exactly does each agent do?</summary><p style="color:var(--muted);margin-top:8px">Strategist sets the angle with a reasoning model (chain-of-thought shown); Researcher runs a live SERP query and returns real sources, citations and keywords; ICP builds 2-3 buyer profiles with pains, triggers and objections; Offer prices the product into tiers with a decoy anchor; Channel splits the budget by CAC and reach; Message drafts the hook and stress-tests the positioning; Skeptic audits every claim and verifies citation URLs resolve; Planner builds the 0-30 day calendar; Publisher assembles the one-pager with slug, meta and a launch checklist.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Is the reasoning model doing real work?</summary><p style="color:var(--muted);margin-top:8px">Yes — when a GROQ_API_KEY is present the Strategist calls a reasoning model and the page renders its chain-of-thought in the “Strategist · reasoning trace” panel. Without a key it falls back to a rule-based brief but still runs every downstream tool for real. Either way the plan you see is produced by actual tool calls, not placeholders.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Can this publish on my own site?</summary><p style="color:var(--muted);margin-top:8px">The Publisher outputs a one-pager markdown (slug, meta title/description, launch checklist) ready to drop into any CMS or docs tool. A human reviews the Skeptic verdict and locks pricing and the channel split before publishing.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Where does a human still need to step in?</summary><p style="color:var(--muted);margin-top:8px">On judgement: approving the angle, the pricing and the channel split, and the final publish call. The engine handles research, profiling, pricing, budgeting, messaging, claim-audit, scheduling and packaging — the first ~90% of launch planning.</p></details>
    </div>
  </div>
</section>`;
---
<Base {...op}>
  <script type="application/ld+json" is:inline set:html={faqLd} />
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <Fragment set:html={body} />
  <LeadForm service="ai" serviceLabel="GTM Launch Agent" promise="Want an autonomous launch studio for your team? I'll scope a 9-agent GTM pipeline — reasoning-model strategy to a launch-ready one-pager — and run it on your actual product." />
  <script>
    const AGENT_META = {
      strategist: { icon: '🧭', color: '#c3a6ff', persona: 'The Cartographer', name: 'Strategist Agent' },
      researcher: { icon: '🔍', color: '#49b6ff', persona: 'The Archaeologist', name: 'Researcher Agent' },
      icp: { icon: '👤', color: '#8b7bff', persona: 'The Profiler', name: 'ICP Agent' },
      offer: { icon: '💰', color: '#ff9e5c', persona: 'The Pricer', name: 'Offer Agent' },
      channel: { icon: '📡', color: '#6ee7b7', persona: 'The Allocator', name: 'Channel Agent' },
      message: { icon: '✍️', color: '#ffd479', persona: 'The Stress-Tester', name: 'Message Agent' },
      skeptic: { icon: '⚖️', color: '#ff8a8a', persona: "The Devil's Advocate", name: 'Skeptic Agent' },
      planner: { icon: '🗓️', color: '#7dd3fc', persona: 'The Scheduler', name: 'Planner Agent' },
      publisher: { icon: '🚀', color: '#fda4af', persona: 'The Launcher', name: 'Publisher Agent' },
      competitor: { icon: '⚔️', color: '#ffb86b', persona: 'The Incumbent', name: 'Competitor Agent' },
      simulator: { icon: '🎲', color: '#b6ff9e', persona: 'The Oddsmaker', name: 'Market Simulator' }
    };
    const STEP = 480, THINK = 480;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const $ = (id) => document.getElementById(id);

    async function type(el, text) {
      if (!el) return;
      if (reduce) { el.textContent = text; return; }
      el.textContent = '';
      for (let i = 0; i < text.length; i++) { el.textContent += text[i]; await sleep(9); }
    }

    const runBtn = $('runBtn'), productEl = $('productInput'), audEl = $('audInput'), goalEl = $('goalInput');
    const stage = $('agStage'), orch = $('agOrch'), agents = $('agAgents'), log = $('agLog'), brief = $('ceBrief'), shareRow = $('ceShareRow');
    const modeEl = $('ceMode'), serpEl = $('ceSerp');
    let data = null, lastProduct = '';

    function telLine(t) {
      if (!t) return 'no LLM calls metered';
      const tok = ((t.prompt || 0) + (t.completion || 0));
      const toolN = (t.tools && t.tools.calls) || 0;
      const toolMs = (t.tools && t.tools.ms) || 0;
      const calls = (t.calls || 0) > 0;
      const tokTxt = tok > 0 ? tok.toLocaleString('en-IN') + ' tokens' : 'tokens n/a (provider sent no usage)';
      return (calls ? (t.calls + ' LLM calls · ' + tokTxt) : '0 LLM calls') + ' · ' + (t.ms || 0) + 'ms LLM · ' + toolN + ' real tools ' + (toolMs || 0) + 'ms · ≈$' + ((t.cost || 0).toFixed(4)) + ' (est)';
    }

    function logLine(cls, html) {
      const d = document.createElement('div');
      d.className = 'ln';
      const t = new Date().toLocaleTimeString('en-IN', { hour12: false });
      d.innerHTML = '<span class="t">' + t + '</span> ' + (cls ? '<span class="' + cls + '">' + html + '</span>' : html);
      log.appendChild(d); log.scrollTop = log.scrollHeight;
    }

    function makeCard(a) {
      const card = document.createElement('div');
      card.className = 'ag-card';
      const id = (a.id || '').toLowerCase();
      card.setAttribute('data-agent', id);
      const meta = AGENT_META[id] || {};
      if (meta.color) card.style.setProperty('--agc', meta.color);
      card.innerHTML =
        '<div class="ag-card-head">' +
          '<span class="ag-ico">' + (meta.icon || '🛰') + '</span>' +
          '<div><div class="ag-name">' + esc(a.name || 'Agent') + '</div><div class="ag-role">' + esc(a.role || '') + '</div>' + (meta.persona ? '<span class="ag-persona">' + esc(meta.persona) + '</span>' : '') + '</div>' +
          '<span class="ag-status">queued</span>' +
        '</div>' +
        '<div class="ag-live"></div>' +
        '<div class="ag-tools">' + (Array.isArray(a.tools) ? a.tools.map((t) => '<span>' + esc(t) + '</span>').join('') : '') + '</div>' +
        '<div class="ag-field think"><span class="k">Thinking</span><p></p></div>' +
        '<div class="ag-field act"><span class="k">Action</span><p></p></div>' +
        '<div class="ag-field out"><span class="k">Output</span><p></p></div>' +
        '<div class="ag-call"></div>' +
        '<div class="ag-handoff"></div>';
      const status = card.querySelector('.ag-status');
      const thinkP = card.querySelector('.ag-field.think p');
      const actP = card.querySelector('.ag-field.act p');
      const outP = card.querySelector('.ag-field.out p');
      const liveEl = card.querySelector('.ag-live');
      const callEl = card.querySelector('.ag-call');
      const handoffEl = card.querySelector('.ag-handoff');
      return { card, status, thinkP, actP, outP, liveEl, callEl, handoffEl };
    }

    function clientFallback(product, audience) {
      const p = String(product || 'the product').trim();
      const core = p.charAt(0).toUpperCase() + p.slice(1);
      const ag = (id, thinking, action, output, live, call, result) => ({ id, name: AGENT_META[id].name, persona: AGENT_META[id].persona, role: '', tools: [call], thinking, action, output, live, call, result, status: 'done' });
      return {
        mode: 'offline', topic: core, product: p, audience: audience || '', goal: '',
        orchestrator: 'Strategist sets the GTM angle, Researcher mines live search, ICP profiles buyers, Offer prices it, Channel splits the budget, Message stress-tests the positioning, Skeptic audits every claim, Planner builds the timeline, Publisher assembles the one-pager.',
        reasoning: 'Offline mode — set a GROQ_API_KEY to see the Strategist reason over the category with a reasoning model.',
        agents: [
          ag('strategist', 'Frames the GTM angle: positioning, launch hypothesis and the one metric this launch must move.', 'Turns "' + core + '" into a launch brief.', 'Angle + positioning + hypothesis handed downstream.', 'Framing the launch…', 'gtm.brief', 'positioning + hypothesis'),
          ag('researcher', 'Mines live search for the category, competitors and citable sources.', 'Queries SERP for the product plus intent variants.', 'Real sources + keyword set handed to ICP and Offer.', 'Mining live search…', 'gtm.research', 'source set + keywords'),
