    async function run() {
      const product = productEl.value.trim();
      if (!product) { productEl.focus(); productEl.style.borderColor = 'var(--accent)'; return; }
      productEl.style.borderColor = '';
      runBtn.disabled = true; runBtn.textContent = '⏳ Studio working…';
      stage.hidden = false; reset(); data = null;
      const payload = { product: product, audience: audEl ? audEl.value.trim() : '', goal: goalEl ? goalEl.value.trim() : '', stream: true };
      try {
        const res = await fetch('/api/gtm', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error('bad');
        const reader = res.body.getReader(); const dec = new TextDecoder(); let buf = '';
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buf += dec.decode(value, { stream: true });
          let idx;
          while ((idx = buf.indexOf('\n')) >= 0) {
            const line = buf.slice(0, idx); buf = buf.slice(idx + 1);
            if (!line.trim()) continue;
            let ev = null; try { ev = JSON.parse(line); } catch (e) { continue; }
            if (ev.event === 'tool') {
              const ok = ev.exec && ev.exec.ok;
              logLine(ok ? 't' : 'a', (AGENT_META[ev.id] ? (AGENT_META[ev.id].icon + ' ') : '🛰 ') + '<b>' + esc(ev.tool || 'tool') + '</b> ' + (ok ? 'executed in ' + ev.exec.ms + 'ms' : 'failed — fallback used'));
            } else if (ev.event === 'serp') {
              if (ev.used) logLine('t', 'researcher grounded in live SERP sweep (' + ev.count + ' results across ' + ((ev.queries || []).length) + ' intent queries)');
            } else if (ev.event === 'metrics') {
              logLine('m', 'metrics · ' + telLine(ev.telemetry));
            } else if (ev.event === 'orch' && ev.text) {
              orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator:</b> ' + esc(ev.text.slice(0, 300)) + '</span>';
            } else if (ev.event === 'debate' && ev.line) {
              debateLine(ev.line);
            } else if (ev.event === 'sim' && ev.sim) {
              window.__gtmSim = ev.sim;
            } else if (ev.event === 'plan' && ev.data && Array.isArray(ev.data.agents) && ev.data.agents.length) {
              data = ev.data;
            }
          }
        }
        if (!data) throw new Error('empty');
      } catch (e) {
        data = clientFallback(product, audEl ? audEl.value.trim() : '');
        logLine('a', 'live API unreachable — using built-in planner');
      }
      if (modeEl) { modeEl.hidden = false; modeEl.className = 'ag-mode ' + (data.mode === 'ai' ? 'ai' : 'template'); modeEl.textContent = data.mode === 'ai' ? '● LIVE LLM' : (data.mode === 'offline' ? '● OFFLINE DEMO' : '● RULE-BASED FALLBACK'); }
      if (serpEl) { if (data.serpUsed) { serpEl.hidden = false; serpEl.textContent = '🔎 LIVE SERP · ' + (data.serpCount || 0) + ' results'; } else { serpEl.hidden = true; } }
      orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator:</b> ' + esc(data.orchestrator || ('Planning ' + (data.product || 'the launch') + '…')) + '</span>';
      logLine('a', 'orchestrator: ' + esc(data.orchestrator || 'starting'));
      const seq = data.agents;
      for (let i = 0; i < seq.length; i++) {
        const a = seq[i]; const id = (a.id || '').toLowerCase();
        const ui = makeCard(a); agents.appendChild(ui.card);
        requestAnimationFrame(() => ui.card.classList.add('show'));
        const sat = document.querySelector('.ag-sat[data-agent="' + id + '"]');
        const line = document.querySelector('.ag-lines line[data-agent="' + id + '"]');
        if (sat) sat.classList.add('on'); if (line) line.classList.add('on');
        ui.status.textContent = 'thinking'; ui.status.className = 'ag-status thinking'; ui.card.classList.add('active');
        const liveTxt = a.live || ((a.name || 'Agent') + ' working');
        logLine('a', (a.name || 'agent') + ' — ' + liveTxt);
        await type(ui.liveEl, liveTxt + '…'); await sleep(THINK);
        ui.thinkP.textContent = ''; await type(ui.thinkP, a.thinking || ''); await sleep(STEP);
        ui.actP.textContent = a.action || ''; ui.outP.textContent = a.output || '';
        ui.liveEl.textContent = liveTxt; ui.liveEl.classList.add('done');
        if (a.call && ui.callEl) {
          const exec = a.exec || null; const toolName = esc(a.call || (exec && exec.tool));
          if (exec && exec.ok) ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + '</span><span class="ag-callres real">' + esc(a.result || '') + '</span><span class="ag-callms">' + exec.ms + 'ms</span>';
          else if (exec && !exec.ok) ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + '</span><span class="ag-callres err">' + esc((exec.error || 'tool failed')) + '</span>';
          else ui.callEl.innerHTML = '<span class="ag-calltool">' + toolName + '</span> <span class="ag-callres">' + esc(a.result || '') + '</span>';
        }
        ui.status.textContent = 'done'; ui.status.className = 'ag-status done'; ui.card.classList.remove('active'); ui.card.classList.add('done');
        const next = seq[i + 1]; if (next && ui.handoffEl) ui.handoffEl.innerHTML = '↓ hands off to ' + esc(next.name);
        logLine('', (a.name || 'agent') + ' → ' + esc((a.output || '').slice(0, 90)));
        await sleep(STEP * 0.35);
      }
      renderBrief(data);
      showWarRoom(data);
      runBtn.disabled = false; runBtn.textContent = '▶ Run again';
    }

    runBtn.addEventListener('click', run);
    productEl.addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') run(); });
    (function () {
      try {
        const h = location.hash && location.hash.length > 4 ? JSON.parse(decodeURIComponent(location.hash.slice(1))) : null;
        if (h && h.product) { productEl.value = String(h.product).slice(0, 160); setTimeout(run, 350); }
      } catch (e) {}
    })();
  </script>
</Base>
