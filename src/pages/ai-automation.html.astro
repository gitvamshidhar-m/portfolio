---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';

const op = {
  title: "AI Marketing Automation & Tools — Vamshidhar Reddy | From Strategy to Shipped",
  description: "I build the AI marketing tools and automations that execute my strategy — 3 live products shipped solo, from Hook Lab to Creative Predictor. Free automation teardown on request.",
  canonical: "https://vamshidharm.vercel.app/ai-automation.html",
  ogImage: "",
  variant: 'sub',
  active: "",
};
const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "What can you automate for a marketing team?", acceptedAnswer: { "@type": "Answer", text: "Reporting, ad creative generation, content drafts, lead enrichment and scoring, competitor monitoring, and internal GPT assistants that know your product." } },
    { "@type": "Question", name: "Do I need a dev team to use these?", acceptedAnswer: { "@type": "Answer", text: "No. I build tools that your team uses from a browser with no-code operations, and I own maintenance end-to-end." } },
    { "@type": "Question", name: "How are your AI tools different from generic SaaS?", acceptedAnswer: { "@type": "Answer", text: "They're trained on your context — your offers, ICP, tone, and playbooks — and wired into your data, so outputs are on-brand instead of generic." } },
    { "@type": "Question", name: "What will the free teardown give me?", acceptedAnswer: { "@type": "Answer", text: "A map of which repetitive tasks are automation-ready, rough hours saved per week, and the first workflow I'd build — no obligations." } }
  ]
});
const body = `<section class="lpage-wrap">
  <div class="wrap">
    <div class="sec-head">
      <span class="tag">AI · Automation · I build what I market</span>
      <h1>Stop doing the work a machine should do — I'll build the machine</h1>
      <p style="color:var(--muted);max-width:720px">I don't just recommend AI — I build it. <b style="color:var(--accent2)">3 live AI marketing tools shipped solo</b>: a copy engine, an ad creative predictor, and a strategy generator. The same muscle automates your reporting, copy, and lead workflows.</p>
      <div class="cta-row" style="justify-content:center">
        <a class="btn primary btn-lg" href="#ctaForm">Map my automation opportunities →</a>
        <a class="btn link-secondary" href="/projects.html#demos">Try the live AI demos →</a>
      </div>
    </div>
  </div>

  <div class="wrap grid2" style="margin-top:34px">
    <div class="how" style="margin:0">
      <div class="step"><span class="num">01</span><div><b>Find the Repeat Work</b><p>An hour with your team surfaces 3–5 tasks eating hours every week — I size the win before building anything.</p></div></div>
      <div class="step"><span class="num">02</span><div><b>Build It On Your Context</b><p>Not a random chatbot — trained on your offers, tone, customers, and data. On-brand output, no babysitting.</p></div></div>
      <div class="step"><span class="num">03</span><div><b>Put a Guardrail &amp; Dashboard</b><p>Human-in-the-loop where it matters, usage tracking where it doesn't. Teams actually use what they trust.</p></div></div>
      <div class="step"><span class="num">04</span><div><b>Keep Improving It</b><p>It's software — versions ship monthly, tuned to the results you see.</p></div></div>
    </div>
    <div style="display:grid;gap:14px">
      <div style="border:1px solid var(--border,#ffffff22);border-radius:14px;padding:18px;background:rgba(139,123,255,.05)">
        <b style="font-size:22px;color:var(--accent2)">3</b>
        <p style="color:var(--muted);margin:6px 0 0">live AI products shipped solo — Hook AI, Creative Predictor, Strategy Generator.</p>
      </div>
      <div style="border:1px solid var(--border,#ffffff22);border-radius:14px;padding:18px;background:rgba(139,123,255,.05)">
        <b style="font-size:22px;color:var(--accent2)">10+ hrs/wk</b>
        <p style="color:var(--muted);margin:6px 0 0">typical reporting + copy hours reclaimed with the first automation stack.</p>
      </div>
      <div style="border:1px solid var(--border,#ffffff22);border-radius:14px;padding:18px;background:rgba(139,123,255,.05)">
        <b style="font-size:22px;color:var(--accent2)">Strategy + Code</b>
        <p style="color:var(--muted);margin:6px 0 0">one person who plans the campaign and writes the tool that runs it — no handoffs.</p>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <span class="tag">Common questions</span>
    <div style="display:grid;gap:10px;margin-top:16px;max-width:820px">
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">What tasks are best to automate first?</summary><p style="color:var(--muted);margin-top:8px">Reporting, first-draft copy, lead qualification, and competitor monitoring — 3 tasks that deliver visible hours back in the first month.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Do I need developers or a data team?</summary><p style="color:var(--muted);margin-top:8px">No. I own build and maintenance. Your team uses a simple tool and my dashboard.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Is it another generic SaaS I'll pay monthly for?</summary><p style="color:var(--muted);margin-top:8px">It's built on your context and data. SaaS prices are irrelevant when the tool understands your offer and produces on-brand work.</p></details>
    </div>
  </div>
</section>`;
---

<Base {...op}>
  <Fragment set:html={body} />
  <script type="application/ld+json" is:inline set:html={faqLd} />
  <LeadForm service="ai" serviceLabel="AI automation" promise="Free automation teardown: I'll map the repetitive marketing work on your team, estimate the hours back per week, and pick the first workflow to build." />
</Base>