---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';

const op = {
  title: "Hive — Agentic AI Marketing Team | Vamshidhar Reddy",
  description: "Hive is agentic AI for marketing: autonomous agents that research (with live SERP), plan, create, launch, measure and optimize — deciding, acting and improving on their own.",
  canonical: "https://vamshidharm.vercel.app/agentic-ai.html",
  ogImage: "",
  variant: 'sub',
  active: '/agentic-ai.html',
};
const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "What is agentic AI in digital marketing?", acceptedAnswer: { "@type": "Answer", text: "A set of autonomous agents that read a goal, pick their own tools, take action, check the result, and loop back to improve — instead of running fixed 'if this then that' rules you pre-wrote. Research, strategy, content, media, analytics and optimization happen without a human in every step." } },
    { "@type": "Question", name: "How is agentic AI different from marketing automation?", acceptedAnswer: { "@type": "Answer", text: "Automation executes the rules you defined; it cannot react to something you didn't anticipate. Agentic AI handles the unexpected — it decides what to do next based on live results, like a senior team would." } },
    { "@type": "Question", name: "Is the agent demo on this page real?", acceptedAnswer: { "@type": "Answer", text: "Yes. It calls a real LLM (Groq) to orchestrate the six agents, then each agent actually invokes a real tool — a live web search (SERP), a budget allocator, ROAS/CPL calculators, a market-size funnel, a copy writer. What you see on the cards is the real return value of that tool, streamed live, with the elapsed time. If no API keys are set it still runs the same tools and falls back to a rule-based plan for the thinking." } },
    { "@type": "Question", name: "Where would I actually use this for my business?", acceptedAnswer: { "@type": "Answer", text: "Anywhere a goal needs a coordinated plan: launching a product, scaling paid media, building a content engine, or running an always-on improvement loop across channels — with your team approving the big calls." } },
    { "@type": "Question", name: "What does an agent's tool call actually look like?", acceptedAnswer: { "@type": "Answer", text: "Each agent invokes a real, runnable tool and shows the actual return value on its card — the Research Agent runs a live web search, the Strategy Agent splits a budget, the Media Agent computes projected ROAS, the Analytics Agent derives CPL/CTR. In production those tools would be bound to your real Google Ads and GA4 APIs behind the same guardrails — this page executes a safe, read-only set." } },
    { "@type": "Question", name: "Where does agentic AI still need a human?", acceptedAnswer: { "@type": "Answer", text: "On brand-safety, tone, hard spend caps, and a launch kill-switch. Models also guess in novel, low-data markets, so a human owns the high-downside calls while the agents handle the repeatable ~95% of the work." } }
  ]
});
const body = `<section class="lpage-wrap">
  <div class="wrap">
    <div class="ag-hero">
      <div class="ag-hero-copy">
        <span class="tag">Hive · Agentic AI</span>
        <h1>Meet Hive — the marketing team that runs itself</h1>
        <p style="color:var(--muted)">Automation follows rules you wrote. <b style="color:var(--accent2)">Agentic AI decides, acts, and improves on its own.</b> Below, Hive's six specialized agents take any goal you type and turn it into a measured, self-optimizing campaign — research to reporting, no meeting required. This is where digital marketing is going, and it already works.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn primary btn-lg" href="#demo">▶ Run Hive</a>
          <a class="btn link-secondary" href="/ai-automation.html">See the tools I build →</a>
        </div>
      </div>
      <div class="ag-orbit" aria-hidden="true">
        <svg class="ag-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
          <line data-agent="research" x1="50" y1="50" x2="24" y2="14"></line>
          <line data-agent="strategy" x1="50" y1="50" x2="74" y2="11"></line>
          <line data-agent="content" x1="50" y1="50" x2="9" y2="46"></line>
          <line data-agent="media" x1="50" y1="50" x2="90" y2="44"></line>
          <line data-agent="analytics" x1="50" y1="50" x2="28" y2="80"></line>
          <line data-agent="optimizer" x1="50" y1="50" x2="72" y2="82"></line>
        </svg>
        <div class="ag-core"><span>GOAL</span><i></i></div>
        <span class="ag-sat" data-agent="research" style="top:14%;left:24%;--agc:#49b6ff">🔍</span>
        <span class="ag-sat" data-agent="strategy" style="top:11%;left:74%;--agc:#8b7bff">🧭</span>
        <span class="ag-sat" data-agent="content" style="top:46%;left:9%;--agc:#ff6fae">✍️</span>
        <span class="ag-sat" data-agent="media" style="top:44%;left:90%;--agc:#ff9e5c">📣</span>
        <span class="ag-sat" data-agent="analytics" style="top:80%;left:28%;--agc:#2ff3c0">📊</span>
        <span class="ag-sat" data-agent="optimizer" style="top:82%;left:72%;--agc:#8affc1">♻️</span>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:30px">
    <div class="sec-head" style="margin-bottom:20px"><span class="tag">Automation ≠ Agentic</span><h2 style="font-size:clamp(20px,3vw,26px)">One follows orders. The other makes calls.</h2></div>
    <div class="ab-grid">
      <div class="ab-variant"><b>🔧 Marketing Automation</b><p>IF this, THEN that. A rule you pre-wrote moves the data, sends the email, posts the report. Brilliant for repeatable work — but it can't react to anything you didn't anticipate.</p></div>
      <div class="ab-variant ab-winner"><b>🤖 Agentic Marketing</b><p>Autonomous agents read the goal, pick their own tools, take action, check the result, and loop back to improve. They handle the unexpected — the way a senior team would, at machine speed.</p></div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">The Hive</span><h2 style="font-size:clamp(20px,3vw,26px)">Six agents. One goal. Zero hand-holding.</h2></div>
    <div class="ab-grid">
      <div class="ab-variant"><b>🔍 Research Agent</b><span class="ag-persona">The Scout</span><p>The skeptical data hound. Maps the real buyer and the channels they use, then hands clean signal onward — no gut-feel assumptions.</p></div>
      <div class="ab-variant"><b>🧭 Strategy Agent</b><span class="ag-persona">The Architect</span><p>The calm chess player. Turns research into a focused plan: positioning, channels, and exactly where the budget goes.</p></div>
      <div class="ab-variant"><b>✍️ Content Agent</b><span class="ag-persona">The Wordsmith</span><p>The brand-voiced writer. Crafts hooks, ad copy and landing pages that sound like you — never generic filler.</p></div>
      <div class="ab-variant"><b>📣 Media Buying Agent</b><span class="ag-persona">The Operator</span><p>The precise executor. Builds and launches campaigns with tight audiences and hard budget caps.</p></div>
      <div class="ab-variant"><b>📊 Analytics Agent</b><span class="ag-persona">The Truth-Teller</span><p>The number-obsessed skeptic. Wires tracking and stands up the KPI dashboard so every rupee is measurable.</p></div>
      <div class="ab-variant"><b>♻️ Optimizer Agent</b><span class="ag-persona">The Tinkerer</span><p>The restless experimenter. Flags losers, rotates winners, and feeds fresh signal back to research.</p></div>
    </div>
    <div class="ag-pipeline" aria-hidden="true">
      <div class="ag-pipe">
        <div class="ag-node" style="--agc:#49b6ff"><span class="ag-nico">🔍</span><b>Research</b><i>The Scout</i></div>
        <div class="ag-arrow">→</div>
        <div class="ag-node" style="--agc:#8b7bff"><span class="ag-nico">🧭</span><b>Strategy</b><i>The Architect</i></div>
        <div class="ag-arrow">→</div>
        <div class="ag-node" style="--agc:#ff6fae"><span class="ag-nico">✍️</span><b>Content</b><i>The Wordsmith</i></div>
        <div class="ag-arrow">→</div>
        <div class="ag-node" style="--agc:#ff9e5c"><span class="ag-nico">📣</span><b>Media</b><i>The Operator</i></div>
        <div class="ag-arrow">→</div>
        <div class="ag-node" style="--agc:#2ff3c0"><span class="ag-nico">📊</span><b>Analytics</b><i>The Truth-Teller</i></div>
        <div class="ag-arrow">→</div>
        <div class="ag-node" style="--agc:#8affc1"><span class="ag-nico">♻️</span><b>Optimizer</b><i>The Tinkerer</i></div>
      </div>
      <div class="ag-loop">↩︎ The Optimizer loops fresh signal back to <b>Research</b> — the Hive keeps improving on its own.</div>
    </div>
  </div>

  <div class="wrap" id="demo" style="margin-top:44px;scroll-margin-top:90px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">Live demo · Hive + live SERP</span><h2 style="font-size:clamp(22px,3.4vw,30px)">Put Hive to work</h2>
    <p style="color:var(--muted);max-width:680px">Type a real marketing goal. The agents will plan it, hand off between each other, and hand you a campaign plan. Runs on Groq — no account, and nothing is stored beyond an anonymous counter.</p></div>
    <div class="ag-console">
      <div class="ag-input">
        <label for="goalInput">Your marketing goal</label>
        <textarea id="goalInput" placeholder="e.g. Launch a B2B SaaS for project managers and get 200 qualified demos in 90 days"></textarea>
        <div class="ag-row">
          <input id="nicheInput" type="text" placeholder="Niche / product (optional)" />
          <input id="budgetInput" type="text" placeholder="Monthly budget (optional)" />
        </div>
        <div class="ag-runrow">
          <button id="runBtn" class="btn primary btn-lg" type="button">▶ Run Hive</button>
          <select id="langSel" aria-label="Plan language" title="Plan language">
            <option value="en">English</option>
            <option value="hi">हिन्दी (Hindi)</option>
            <option value="te">తెలుగు (Telugu)</option>
            <option value="ta">தமிழ் (Tamil)</option>
          </select>
          <button id="voiceBtn" class="btn" type="button" aria-label="Speak your goal into the mic" title="Speak your goal — it will be transcribed and run">🎤 Speak</button>
          <span id="agMode" class="ag-mode" hidden></span>
          <span id="agSerp" class="ag-mode serp" hidden></span>
          <span class="ag-hint">Try: “Sell 500 units of a D2C skincare brand in 60 days” or “Book 30 consultations for a local dental clinic”.</span>
        </div>
        <div class="ag-adv">
          <label class="ag-check" id="compareWrap"><input type="checkbox" id="compareChk" /> <span>⚖ Compare LLM plan vs rule-based baseline</span></label>
          <p id="serpHint" class="ag-hint" hidden style="color:var(--accent)">Live web search was blocked. Paste a search-results page's HTML below to ground the Research Agent manually.</p>
          <button type="button" class="ag-adv-toggle" id="serpToggle" aria-expanded="false" aria-controls="serpBody">⤵ Paste search HTML (manual fallback)</button>
          <div class="ag-adv-body" id="serpBody" hidden>
            <textarea id="serpPaste" placeholder="Paste the HTML of a Google / DuckDuckGo search-results page here. The Research Agent will use those results to ground its plan — handy when live search is blocked." rows="4"></textarea>
            <span class="ag-hint">Optional. Leave empty to let Hive fetch live results itself.</span>
          </div>
        </div>
      </div>
      <div class="ag-stage" id="agStage" hidden>
        <div class="ag-orch" id="agOrch"></div>
        <div class="ag-agents" id="agAgents"></div>
        <div class="ag-log" id="agLog"></div>
      </div>
      <div class="ag-plan" id="agPlan" hidden></div>
      <div class="ag-follow" id="agFollow" hidden>
        <div class="ag-follow-head"><b>💬 Ask the team a follow-up</b><span class="ag-hint">e.g. “Give me 3 ad headlines” · “Shift ₹50k to LinkedIn” · “make the timeline 8 weeks”</span></div>
        <div class="ag-follow-row">
          <input id="followInput" type="text" placeholder="Type a follow-up to refine the plan…" />
          <button id="followBtn" class="btn" type="button">Ask →</button>
        </div>
        <div class="ag-follow-thread" id="followThread"></div>
      </div>
      <div class="ag-watch" id="agWatch">
        <div class="ag-watch-head"><b>🔎 Competitor watch</b><span class="ag-hint">Add keywords — Hive checks SERPs and pings you when a new competitor appears.</span></div>
        <div class="ag-follow-row">
          <input id="watchInput" type="text" placeholder="Keyword, e.g. “best project management software”" />
          <button id="watchAddBtn" class="btn" type="button">Watch →</button>
          <button id="watchRunBtn" class="btn" type="button">↻ Check now</button>
        </div>
        <div class="ag-watch-list" id="watchList"></div>
      </div>
    </div>
  </div>

  <div class="ag-modal" id="agModal" role="dialog" aria-modal="true">
    <div class="ag-modal-card">
      <h4 id="agModalTitle">Edit section</h4>
      <div class="ag-hint" id="agModalHint"></div>
      <textarea id="agModalArea" spellcheck="false"></textarea>
      <div class="ag-modal-actions">
        <button type="button" class="btn" id="agModalCancel">Cancel</button>
        <button type="button" class="btn primary" id="agModalSave">Save & revise →</button>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:44px">
    <div class="ag-proof">
      <div class="ag-proof-copy">
        <span class="tag">Proof, not just a pitch</span>
        <h2 style="font-size:clamp(20px,3vw,26px)">The loop works because the outcomes do</h2>
        <p style="color:var(--muted);max-width:640px">Hive isn't a metaphor. The same research → optimize loop has shipped real results on live accounts — ROAS climbing <b style="color:var(--accent2)">3.2x → 5.5x</b> and CPL cut <b style="color:var(--accent2)">−30%</b>. Run the demo above, then see how the numbers get built.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn primary" href="/case-study.html">See the case-study builder →</a>
          <a class="btn link-secondary" href="/audit.html">Get a free audit</a>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <span class="tag">Common questions</span>
    <div style="display:grid;gap:10px;margin-top:16px;max-width:820px">
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">What exactly does each agent do?</summary><p style="color:var(--muted);margin-top:8px">Research sizes the audience, Strategy sets the plan, Content writes the assets, Media launches the campaigns, Analytics measures them, and the Optimizer keeps improving — each one handing its output to the next.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Do I lose control if agents act autonomously?</summary><p style="color:var(--muted);margin-top:8px">No. The demo shows the plan and the loop; in production you set guardrails — humans approve the big calls (budget, launches) while agents handle the repetitive ones.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Can this plug into my actual ad accounts and CRM?</summary><p style="color:var(--muted);margin-top:8px">Yes — that's the build. The agents call real tools (ad platforms, GA4, your CRM) behind a guardrailed workflow. This page is the safe, read-only showcase of the orchestration.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">What does an agent's tool call actually look like?</summary>
        <p style="color:var(--muted);margin-top:8px">Read-only mock of what the Media Agent emits before a human approves a launch. In production the same call hits the real Google Ads + GA4 APIs behind the guardrail.</p>
        <pre class="ag-trace">{
  "agent": "media",
  "tool": "google_ads.create_campaign",
  "guardrail": "requires_human_approval",
  "dry_run": true,
  "params": {
    "name": "Hive · PM SaaS · LinkedIn",
    "objective": "LEAD",
    "budget": { "daily": 3000, "currency": "INR" },
    "audience": { "lookalike": "analytics:demo_audience", "exclude": ["existing_customers"] },
    "tracking": { "ga4_event": "generate_lead", "click_id": "gclid" }
  },
  "result": "VALIDATED · awaiting human approval"
}</pre>
        <pre class="ag-trace">{
  "agent": "analytics",
  "tool": "ga4.run_report",
  "params": { "metrics": ["conversions", "cost_per_conversion"], "dimensions": ["campaign"], "date_range": "last_7d" },
  "result": { "pm_saas_linkedin": { "conversions": 41, "cpa_inr": 734 } }
}</pre>
      </details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Where does agentic AI still need a human?</summary>
        <p style="color:var(--muted);margin-top:8px">Agentic AI is brilliant at execution, not judgment. In the builds I ship, a human stays on the calls that have real downside: brand-safety and tone (no agent ships copy that could read as tone-deaf), hard spend caps so a rogue experiment can't blow the budget, and a kill-switch on any launch. Novel or low-data markets are where I still step in — models guess when there's no signal to ground them. The Hive owns the ~95% of repeatable work; I own the ~5% that needs scar tissue.</p>
      </details>
    </div>
  </div>
</section>`;
---

<Base {...op}>
  <Fragment set:html={body} />
  <script type="application/ld+json" is:inline set:html={faqLd} />
  <LeadForm service="ai" serviceLabel="Agentic AI" promise="Want this running on your account? I'll scope a guardrailed Hive for your channels and KPIs — research to optimizer — and show you the first autonomous campaign plan." />
  <script>
    const ICON = { research: '🔍', strategy: '🧭', content: '✍️', media: '📣', analytics: '📊', optimizer: '♻️' };
    const AGENT_META = {
      research: { icon: '🔍', color: '#49b6ff', persona: 'The Scout' },
      strategy: { icon: '🧭', color: '#8b7bff', persona: 'The Architect' },
      content: { icon: '✍️', color: '#ff6fae', persona: 'The Wordsmith' },
      media: { icon: '📣', color: '#ff9e5c', persona: 'The Operator' },
      analytics: { icon: '📊', color: '#2ff3c0', persona: 'The Truth-Teller' },
      optimizer: { icon: '♻️', color: '#8affc1', persona: 'The Tinkerer' }
    };
    const STEP = 620, THINK = 620;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const qs = (obj) => { try { return JSON.stringify(obj).slice(0, 140); } catch (e) { return ''; } };
    const $ = (id) => document.getElementById(id);

    async function type(el, text) {
      if (!el) return;
      if (reduce) { el.textContent = text; return; }
      el.textContent = '';
      for (let i = 0; i < text.length; i++) {
        el.textContent += text[i];
        await sleep(14);
      }
    }

    // Compact offline fallback (server normally returns the full plan; this only
    // covers the rare case the API call itself fails). Keep in sync with libs/agentic.js.
    function clientFallback(goal, budget) {
      const g = String(goal || '').toLowerCase();
      const isB2B = /b2b|saas|software|enterprise|api|platform|crm|workflow/.test(g);
      const isLoc = /local|restaurant|clinic|salon|dentist|agency|lawyer|real estate|realtor|near me|gym/.test(g);
      const channels = isB2B ? ['LinkedIn Ads', 'Google Search', 'Cold email + Apollo', 'G2 / review sites', 'Webinars']
        : isLoc ? ['Google Local Services', 'Meta geo Ads', 'Local SEO', 'Google Maps', 'Reviews']
        : /ecommerce|shopify|d2c|dtc|store|retail|skincare|apparel/.test(g) ? ['Meta (FB/IG) Ads', 'Google Shopping', 'TikTok Ads', 'Influencer seeding', 'Email + SMS']
        : ['Meta Ads', 'Google Ads', 'LinkedIn', 'Email / CRM', 'Content + SEO'];
      const bud = (budget && budget.trim()) ? budget.trim() : (isB2B ? '₹2.5L–₹4L / mo' : isLoc ? '₹60k–₹1.2L / mo' : '₹1.5L–₹3L / mo');
      const core = goal.charAt(0).toUpperCase() + goal.slice(1);
      const ag = (id, name, role, tools, thinking, action, output, live, call, result) => ({ id, name, role, tools, thinking, action, output, live, call, result, status: 'done' });
      return {
        mode: 'offline', goal: goal,
        orchestrator: 'Research sizes the audience, Strategy sets channels + budget, Content + Media ship the launch, Analytics measures, Optimizer closes the loop.',
        agents: [
          ag('research', 'Research Agent', 'Market & audience intelligence', ['web_search', 'analytics'], 'Maps who actually buys and where they hang out for: "' + core + '".', 'Pulls demand, competitor and audience signals across ' + channels.slice(0, 3).join(', ') + '.', 'Primary ICP + best channels identified: ' + channels.slice(0, 2).join(' and ') + ' — handed to Strategy.', 'Sizing the audience via live SERP…', 'serp.search', '3 competitor angles · 12.4k monthly searches'),
          ag('strategy', 'Strategy Agent', 'Positioning, channels & budget', ['planner'], 'Turns the research into a focused plan instead of spraying budget.', 'Allocates "' + bud + '" across the highest-intent channels only.', 'Plan: lead with ' + channels[0] + ', then ' + (channels[1] || channels[0]) + '; 70/30 testing split — handed to Content.', 'Turning signal into a focused plan…', 'planner.allocate', bud + ' · 70/30 split · top 2 channels'),
          ag('content', 'Content Agent', 'Copy, creative & brand voice', ['llm_writer', 'brand_voice'], 'Writes in the brand voice the strategy defined, not generic filler.', 'Drafts hook variants, landing page and ad copy mapped to the ICP.', '3 hook angles + 1 landing page ready for Media — handed to Media.', 'Drafting hooks + landing copy in brand voice…', 'llm_writer', '3 hooks + 1 landing page · brand voice 98% match'),
          ag('media', 'Media Buying Agent', 'Campaign build & targeting', ['ad_platform', 'audience_sync'], 'Builds the campaigns exactly as Content + Strategy specified.', 'Launches ' + channels[0] + ' with the winning hooks and tight audiences.', 'Live campaigns with audience sync + budget caps — handed to Analytics.', 'Building & launching the campaigns…', 'google_ads.create_campaign', 'VALIDATED · awaiting human approval'),
          ag('analytics', 'Analytics Agent', 'Tracking, KPIs & dashboards', ['ga4', 'pixel'], 'Makes sure every rupee is measurable before it scales.', 'Wires GA4 + pixels and stands up a one-screen KPI dashboard.', 'Tracking live; KPIs = CPL, CTR, demo rate, ROAS — handed to Optimizer.', 'Wiring tracking + the KPI dashboard…', 'ga4.run_report', 'CPL ₹734 · CTR 3.1% · demo rate 4.2%'),
          ag('optimizer', 'Optimizer Agent', 'Always-on improvement loop', ['experiment', 'alert'], 'Keeps improving using the KPIs Analytics defined.', 'Auto-flags underperforming ads and rotates in the next hook variant.', 'Weekly experiment loop feeds fresh signal back to Research — Hive keeps learning.', 'Spinning up the experiment loop…', 'experiment.rotate', '2 losers paused · next hook variant queued')
        ],
        campaignPlan: {
          channels: channels, budget: { total: bud, split: '70% to top channel, 30% to experiments' },
          kpis: ['CPL / CAC', 'CTR & hook win-rate', 'Demo / lead rate', 'ROAS'],
          timeline: ['Week 1: Research + tracking live', 'Week 2-4: Launch ' + channels[0] + ' + content', 'Week 5-8: Scale winners, cut losers', 'Week 9-12: Automate the optimizer loop']
        },
        summary: 'A 6-agent Hive takes "' + core + '" from blank page to a measured, self-optimizing campaign — research to reporting handled without a meeting. That is agentic marketing: autonomous agents that plan, act and improve, with you approving the big calls.'
      };
    }

const runBtn = $('runBtn'), goal = $('goalInput'), niche = $('nicheInput'), budget = $('budgetInput');
    const stage = $('agStage'), orch = $('agOrch'), agents = $('agAgents'), log = $('agLog'), plan = $('agPlan'), modeEl = $('agMode'), serpEl = $('agSerp');
    const serpToggle = $('serpToggle'), serpBody = $('serpBody'), serpPaste = $('serpPaste'), serpHint = $('serpHint');
    const voiceBtn = $('voiceBtn');
    const langSel = $('langSel');
    // Persist the chosen plan language so returning visitors keep their preference.
    if (langSel) {
      const savedLang = (function () { try { return localStorage.getItem('hiveLang'); } catch (e) { return null; } })();
      if (savedLang && ['en', 'hi', 'te', 'ta'].indexOf(savedLang) >= 0) langSel.value = savedLang;
      langSel.addEventListener('change', function () {
        try { localStorage.setItem('hiveLang', langSel.value); } catch (e) {}
      });
    }
    const followEl = $('agFollow'), followInput = $('followInput'), followBtn = $('followBtn'), followThread = $('followThread');
    const watchAddBtn = $('watchAddBtn'), watchInput = $('watchInput'), watchList = $('watchList'), watchRunBtn = $('watchRunBtn');
    let tel = null; // last run telemetry: token/cost/latency ledger
    let data = null; // last full plan payload (shared with the compare toggle)
    let cmpVar = false; // compare-mode toggle state

    function telLine(t) {
      if (!t) return 'no LLM calls metered';
      const tok = ((t.prompt || 0) + (t.completion || 0));
      const toolN = (t.tools && t.tools.calls) || 0;
      const toolMs = (t.tools && t.tools.ms) || 0;
      return (t.prompt ? (t.calls + ' LLM calls · ' + tok.toLocaleString('en-IN') + ' tokens') : ('0 LLM calls')) + ' · ' + t.ms + 'ms LLM · ' + toolN + ' tools ' + toolMs + 'ms · ≈$' + ((t.cost || 0).toFixed(4)) + ' (est)';
    }

    if (serpToggle && serpBody) {
      serpToggle.addEventListener('click', function () {
        const on = serpBody.hidden;
        serpBody.hidden = !on;
        serpToggle.setAttribute('aria-expanded', on ? 'true' : 'false');
        serpToggle.textContent = on ? '⤴ Hide search HTML paste' : '⤵ Paste search HTML (manual fallback)';
      });
      if (serpPaste) serpPaste.value = '';
    }

    function stripTags(s) { return String(s || '').replace(/<[^>]*>/g, '').replace(/&amp;/g, '&').replace(/&#x27;|&#39;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>'); }

    // Robust SERP-HTML parser: understands DuckDuckGo, Google and plain pasted text,
    // so the manual fallback works regardless of which search engine the visitor used.
    function parsePasted(html) {
      if (!html) return [];
      const out = [];

      // DuckDuckGo anchors (result__a / result__snippet)
      const ddgT = /<a[^>]*class="result__a"[^>]*href="([^"]*)"[^>]*>([\s\S]*?)<\/a>/g;
      const ddgS = /<a[^>]*class="result__snippet"[^>]*>([\s\S]*?)<\/a>/g;
      const ddgBlocks = [];
      let mm;
      while ((mm = ddgT.exec(html))) {
        let link = '';
        const um = mm[1].match(/uddg=([^&]+)/);
        if (um) { try { link = decodeURIComponent(um[1]); } catch (e) {} }
        ddgBlocks.push({ title: stripTags(mm[2]), link: link });
      }
      const ddgSnips = (html.match(ddgS) || []).map((s) => stripTags(s.replace(/^<a[^>]*>/, '').replace(/<\/a>$/, '')));
      for (let i = 0; i < ddgBlocks.length && out.length < 8; i++) {
        let domain = '';
        try { domain = new URL(ddgBlocks[i].link || '').hostname.replace(/^www\./, ''); } catch (e) {}
        out.push({ title: ddgBlocks[i].title, link: ddgBlocks[i].link, domain: domain, snippet: ddgSnips[i] || '' });
      }

      // Google anchors (h3 titles + /url?q= links + snippets)
      if (out.length < 8) {
        const gRe = /<a[^>]*href="\/url\?q=([^&"']+)[^"]*"[^>]*>([\s\S]*?)<\/a>/gi;
        const gTitles = [];
        while ((mm = gRe.exec(html))) {
          let link = '';
          try { link = decodeURIComponent(mm[1]); } catch (e) {}
          gTitles.push({ title: stripTags(mm[2]), link: link });
        }
        const gSnips = (html.match(/<div[^>]*class="[^"]*(?:VwiC3b|IsZvec|aCOpRe)[^"]*"[^>]*>([\s\S]*?)<\/div>/gi) || []).map((s) => stripTags(s));
        for (let i = 0; i < gTitles.length && out.length < 8; i++) {
          let domain = '';
          try { domain = new URL(gTitles[i].link || '').hostname.replace(/^www\./, ''); } catch (e) {}
          out.push({ title: gTitles[i].title, link: gTitles[i].link, domain: domain, snippet: gSnips[i] || '' });
        }
      }

      // Plain-text fallback: one result per line — "title — link" or "title — snippet"
      if (out.length < 8) {
        const isHtml = /<[a-zA-Z/][^>]*>/.test(html);
        if (!isHtml) {
          html.split(/\r?\n/).forEach((line) => {
            if (out.length >= 8) return;
            line = line.trim();
            if (!line) return;
            let title = line, link = '', snippet = '';
            const linkMatch = line.match(/(https?:\/\/[^\s]+)/);
            if (linkMatch) { link = linkMatch[1].replace(/[.,;:)\]}>]+$/, ''); title = line.replace(linkMatch[0], '').replace(/^[\s·•|\-–—]+|[\s·•|\-–—]+$/g, '').trim(); }
            const em = line.split(/\s{2,}|\s+—\s+|\s+-\s+/);
            if (!title && em.length > 1) { title = em[0]; snippet = em.slice(1).join(' — '); }
            if (!title) title = link || line;
            let domain = '';
            try { domain = new URL(link || '').hostname.replace(/^www\./, ''); } catch (e) {}
            out.push({ title: title.slice(0, 160), link: link, domain: domain, snippet: snippet.slice(0, 240) });
          });
        }
      }
      return out;
    }

    function logLine(cls, html) {
      const d = document.createElement('div');
      d.className = 'ln';
      const t = new Date().toLocaleTimeString('en-IN', { hour12: false });
      d.innerHTML = '<span class="t">' + t + '</span> ' + (cls ? '<span class="' + cls + '">' + html + '</span>' : html);
      log.appendChild(d);
      log.scrollTop = log.scrollHeight;
    }

    // ---- Voice input: record the mic, transcribe via /api/agentic/stt, then auto-run ----
    let rec = null, recChunks = [], recStream = null;
    function vLabel(on) { return on ? '⏺ Recording… tap to stop' : '🎤 Speak'; }
    async function vStart() {
      if (rec && rec.state === 'recording') { vStop(); return; }
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { logLine('a', 'mic needs HTTPS or a supported browser'); return; }
      try {
        recStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const mime = (typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) ? 'audio/webm;codecs=opus' : 'audio/webm';
        rec = new MediaRecorder(recStream, mime ? { mimeType: mime } : undefined);
        recChunks = [];
        rec.ondataavailable = function (e) { if (e.data && e.data.size) recChunks.push(e.data); };
        rec.onstop = vSend;
        rec.start();
        voiceBtn.textContent = vLabel(true);
        voiceBtn.classList.add('rec');
        setTimeout(function () { if (rec && rec.state === 'recording') vStop(); }, 20000);
      } catch (e) {
        voiceBtn.textContent = vLabel(false);
        logLine('a', 'mic unavailable — check permission');
      }
    }
    function vStop() {
      try { if (rec && rec.state !== 'inactive') rec.stop(); } catch (e) {}
      if (recStream) recStream.getTracks().forEach(function (t) { t.stop(); });
      recStream = null;
    }
    async function vSend() {
      voiceBtn.textContent = '⏳ Transcribing…';
      const type = rec ? (rec.mimeType || 'audio/webm') : 'audio/webm';
      const blob = new Blob(recChunks, { type: type });
      recChunks = [];
      if (blob.size < 1000) {
        voiceBtn.textContent = vLabel(false);
        voiceBtn.classList.remove('rec');
        logLine('a', 'nothing heard — try again');
        return;
      }
      try {
        const b64 = await new Promise(function (resolve, reject) {
          const fr = new FileReader();
          fr.onload = function () { resolve(String(fr.result).split(',')[1] || ''); };
          fr.onerror = reject;
          fr.readAsDataURL(blob);
        });
        const r = await fetch('/api/agentic/stt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ audio: b64, mime: type, lang: langSel ? langSel.value : 'en' })
        });
        const j = await r.json();
        if (!r.ok) throw new Error((j && j.error) || 'transcription failed');
        goal.value = String(j.text || '').trim();
        logLine('t', '🎤 heard: "' + goal.value.slice(0, 100) + '"' + (goal.value.length > 100 ? '…' : ''));
        if (goal.value) run();
      } catch (e) {
        logLine('a', 'transcription failed — type the goal instead');
      }
      voiceBtn.textContent = vLabel(false);
      voiceBtn.classList.remove('rec');
    }
    if (voiceBtn) voiceBtn.addEventListener('click', vStart);

    function reset() {
      cmpVar = false;
      agents.innerHTML = '';
      log.innerHTML = '';
      plan.hidden = true;
      plan.innerHTML = '';
      orch.innerHTML = '';
      document.querySelectorAll('.ag-sat.on, .ag-lines line.on').forEach((el) => el.classList.remove('on'));
    }

    function makeCard(a) {
      const card = document.createElement('div');
      card.className = 'ag-card';
      const id = (a.id || '').toLowerCase();
      card.setAttribute('data-agent', id);
      const meta = AGENT_META[id] || {};
      const icon = meta.icon || ICON[id] || '🤖';
      if (meta.color) card.style.setProperty('--agc', meta.color);
      card.innerHTML =
        '<div class="ag-card-head">' +
          '<span class="ag-ico">' + icon + '</span>' +
          '<div><div class="ag-name">' + esc(a.name || 'Agent') + '</div><div class="ag-role">' + esc(a.role || '') + '</div>' + (meta.persona ? '<span class="ag-persona">' + esc(meta.persona) + '</span>' : '') + '</div>' +
          '<span class="ag-status">queued</span>' +
          '<button type="button" class="ag-regen" title="Regenerate this agent">↻</button>' +
        '</div>' +
        '<div class="ag-live"></div>' +
        '<div class="ag-tools">' + (Array.isArray(a.tools) ? a.tools.map((t) => '<span>' + esc(t) + '</span>').join('') : '') + '</div>' +
        '<div class="ag-field think"><span class="k">Thinking</span><p></p></div>' +
        '<div class="ag-field act"><span class="k">Action</span><p></p></div>' +
        '<div class="ag-field out"><span class="k">Output</span><p></p></div>' +
        '<div class="ag-call"></div>' +
        '<div class="ag-handoff"></div>';
      const status = card.querySelector('.ag-status');
      const thinkP = card.querySelector('.ag-field.think p');
      const actP = card.querySelector('.ag-field.act p');
      const outP = card.querySelector('.ag-field.out p');
      const liveEl = card.querySelector('.ag-live');
      const callEl = card.querySelector('.ag-call');
      const handoffEl = card.querySelector('.ag-handoff');
      return { card, status, thinkP, actP, outP, liveEl, callEl, handoffEl };
    }

    async function run() {
      const g = goal.value.trim();
      if (!g) { goal.focus(); goal.style.borderColor = 'var(--accent)'; return; }
      goal.style.borderColor = '';
      runBtn.disabled = true;
      runBtn.textContent = '⏳ Hive working…';
      stage.hidden = false;
      plan.hidden = true;
      reset();
      data = null;
      const pastedHtml = serpPaste ? serpPaste.value.trim() : '';
      const pastedResults = parsePasted(pastedHtml);
      try {
        if (window._shareRunId) {
          const rid = window._shareRunId;
          window._shareRunId = '';
          const rr = await fetch('/api/agentic?run=' + encodeURIComponent(rid), { cache: 'no-store' });
          if (rr.ok) {
            const j = await rr.json();
            if (j && Array.isArray(j.agents) && j.agents.length) { data = j; logLine('t', 'replaying shared run ' + rid); }
            else throw new Error('empty');
          } else { throw new Error('bad'); }
        } else {
        const res = await fetch('/api/agentic', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ goal: g, niche: niche.value.trim(), budget: budget.value.trim(), lang: langSel ? langSel.value : 'en', serpResults: pastedResults.length ? pastedResults : undefined, compare: true, stream: true })
        });
        if (!res.ok) throw new Error('bad');
        // NDJSON stream: tool events arrive live, final 'plan' event has the full result.
        const reader = res.body.getReader();
        const dec = new TextDecoder();
        let buf = '';
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buf += dec.decode(value, { stream: true });
          let idx;
          while ((idx = buf.indexOf('\n')) >= 0) {
            const line = buf.slice(0, idx); buf = buf.slice(idx + 1);
            if (!line.trim()) continue;
            let ev = null;
            try { ev = JSON.parse(line); } catch (e) { continue; }
            if (ev.event === 'tool') {
              const ok = ev.exec && ev.exec.ok;
              logLine(ok ? 't' : 'a', (AGENT_META[ev.id] ? (AGENT_META[ev.id].icon + ' ') : '🔧 ') + '<b>' + esc(ev.tool || 'tool') + '</b> ' + (ok ? 'executed in ' + ev.exec.ms + 'ms' : 'failed — fallback used'));
            } else if (ev.event === 'serp') {
              if (ev.used) logLine('t', 'research grounded in ' + (ev.query === 'pasted results' ? 'pasted search results' : 'live SERP') + ' (' + ev.count + ' results)');
            } else if (ev.event === 'cache') {
              logLine('g', 'composition cache hit — skipped orchestrator LLM call (' + ev.ms + 'ms)');
            } else if (ev.event === 'metrics') {
              tel = ev.telemetry || null;
              logLine('m', 'metrics · ' + telLine(ev.telemetry));
            } else if (ev.event === 'orch') {
              if (ev.text) {
                orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator composing:</b> <span class="ag-orch-txt">' + esc(ev.text.slice(-360)) + '</span><span class="ag-orch-dims">…</span></span>';
                orch.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
              }
            } else if (ev.event === 'reflect') {
              logLine('t', (AGENT_META[ev.id] ? AGENT_META[ev.id].icon + ' ' : '') + 'observed real tool result — handoff updated' + (ev.passes && ev.passes > 1 ? ' (' + ev.passes + ' reflect passes)' : ''));
            } else if (ev.event === 'plan' && ev.data && Array.isArray(ev.data.agents) && ev.data.agents.length) {
              data = ev.data;
            }
          }
        }
        if (!data) throw new Error('empty');
        }
      } catch (e) {
        data = clientFallback(g, budget.value.trim());
        logLine('a', 'live API unreachable — using built-in planner');
      }

      if (modeEl) {
        modeEl.hidden = false;
        modeEl.className = 'ag-mode ' + (data.mode === 'ai' ? 'ai' : 'template');
        modeEl.textContent = data.mode === 'ai' ? '● LIVE LLM' : (data.mode === 'offline' ? '● OFFLINE DEMO' : '● RULE-BASED FALLBACK');
      }
      if (serpEl) {
        if (data.serpUsed) {
          serpEl.hidden = false;
          const source = (data.serpQuery === 'pasted results') ? '📋 PASTED SEARCH' : '🔎 LIVE SERP';
          serpEl.textContent = source + ' · ' + (data.serpCount || 0) + ' results';
          logLine('t', 'research grounded in ' + (source === 'PASTED SEARCH' ? 'pasted search results' : 'live SERP') + ' (' + (data.serpCount || 0) + ' results)');
        } else {
          serpEl.hidden = true;
          if (data.serpBlocked && serpHint) {
            serpHint.hidden = false;
            if (serpBody) serpBody.hidden = false;
            if (serpToggle) { serpToggle.setAttribute('aria-expanded', 'true'); serpToggle.textContent = '⤴ Hide search HTML paste'; }
          }
        }
      }

      orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator:</b> ' + esc(data.orchestrator || 'Planning Hive…') + '</span>';
      logLine('a', 'orchestrator: ' + esc(data.orchestrator || 'starting'));

      const seq = data.agents;
      for (let i = 0; i < seq.length; i++) {
        const a = seq[i];
        const id = (a.id || '').toLowerCase();
        const ui = makeCard(a);
        agents.appendChild(ui.card);
        requestAnimationFrame(() => ui.card.classList.add('show'));
        const sat = document.querySelector('.ag-sat[data-agent="' + id + '"]');
        const line = document.querySelector('.ag-lines line[data-agent="' + id + '"]');
        if (sat) sat.classList.add('on');
        if (line) line.classList.add('on');
        ui.status.textContent = 'thinking'; ui.status.className = 'ag-status thinking';
        ui.card.classList.add('active');
        const liveTxt = a.live || ((a.name || 'Agent') + ' working');
        logLine('a', (a.name || 'agent') + ' — ' + liveTxt);
        await type(ui.liveEl, liveTxt + '…');
        await sleep(THINK);
        ui.thinkP.textContent = '';
        await type(ui.thinkP, a.thinking || '');
        await sleep(STEP);
        ui.actP.textContent = a.action || '';
        ui.outP.textContent = a.output || '';
        ui.liveEl.textContent = liveTxt;
        ui.liveEl.classList.add('done');
        if (a.call && ui.callEl) {
          const exec = a.exec || null;
          const toolName = esc(a.call || (exec && exec.tool));
          const argsText = (a.toolArgs && Object.keys(a.toolArgs).length)
            ? ' ' + esc(qs(a.toolArgs))
            : '';
          if (exec && exec.ok) {
            ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + argsText + '</span><span class="ag-callres real">' + esc(a.result || '') + '</span><span class="ag-callms">' + exec.ms + 'ms</span>';
          } else if (exec && !exec.ok) {
            ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + argsText + '</span><span class="ag-callres err">' + esc((exec.error || 'tool failed')) + '</span>';
          } else {
            ui.callEl.innerHTML = '<span class="ag-calltool">' + toolName + '</span> <span class="ag-callres">' + esc(a.result || '') + '</span>';
          }
        }
        ui.status.textContent = 'done'; ui.status.className = 'ag-status done';
        ui.card.classList.remove('active'); ui.card.classList.add('done');
        const next = seq[i + 1];
        if (next && ui.handoffEl) ui.handoffEl.innerHTML = '↓ hands off to ' + esc(next.name);
        logLine('', (a.name || 'agent') + ' → ' + esc((a.output || '').slice(0, 90)));
        await sleep(STEP * 0.35);
      }

      renderPlan(data);
      runBtn.disabled = false;
      runBtn.textContent = '▶ Run again';
    }

    function planToText(d) {
      const cp = d.campaignPlan || {};
      const L = [];
      L.push('CAMPAIGN PLAN: ' + (d.goal || ''));
      L.push('');
      if (d.orchestrator) L.push('ORCHESTRATOR: ' + d.orchestrator);
      L.push('');
      (d.agents || []).forEach(function (a) {
        L.push('• ' + (a.name || 'Agent') + (a.role ? ' (' + a.role + ')' : ''));
        if (a.thinking) L.push('   thinking: ' + a.thinking);
        if (a.action) L.push('   action:   ' + a.action);
        if (a.output) L.push('   output:   ' + a.output);
        if (a.call) L.push('   tool:     ' + a.call + (a.result ? (' → ' + a.result) : ''));
      });
      L.push('');
      if (cp.channels && cp.channels.length) L.push('CHANNELS: ' + cp.channels.join(', '));
      if (cp.budget) L.push('BUDGET: ' + (cp.budget.total || '') + (cp.budget.split ? (' · ' + cp.budget.split) : ''));
      if (cp.kpis && cp.kpis.length) L.push('KPIs: ' + cp.kpis.join(', '));
      if (cp.timeline && cp.timeline.length) L.push('TIMELINE:\n  - ' + cp.timeline.join('\n  - '));
      if (d.summary) { L.push(''); L.push('SUMMARY: ' + d.summary); }
      return L.join('\n');
    }

    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text);
      }
      return new Promise(function (resolve, reject) {
        try {
          const ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          document.execCommand('copy'); document.body.removeChild(ta); resolve();
        } catch (e) { reject(e); }
      });
    }

    function renderPlan(d) {
      const cp = d.campaignPlan || {};
      // Differential compare: when toggled, tag every item that differs between the
      // plan being shown and the rule-based baseline so the changes pop at a glance.
      const other = (d === data && d.fallback) ? d.fallback : (cmpVar && d !== data ? data : null);
      const cmpAgainst = cmpVar ? (other && other.campaignPlan) : null;
      const diffTag = (listA, listB) => {
        const setB = new Set((listB || []).map((x) => String(x).trim().toLowerCase()));
        return (listA || []).map((x) => {
          if (cmpAgainst && !setB.has(String(x).trim().toLowerCase())) return '<mark class="ag-changed">' + esc(x) + '</mark>';
          return '<span>' + esc(x) + '</span>';
        }).join('');
      };
      const diffLi = (listA, listB) => {
        const setB = new Set((listB || []).map((x) => String(x).trim().toLowerCase()));
        return (listA || []).map((x) => {
          if (cmpAgainst && !setB.has(String(x).trim().toLowerCase())) return '<li><mark class="ag-changed">' + esc(x) + '</mark></li>';
          return '<li>' + esc(x) + '</li>';
        }).join('');
      };
      const chips = (Array.isArray(cp.channels) ? diffTag(cp.channels, cmpAgainst ? cmpAgainst.channels : null) : '');
      const kpis = (Array.isArray(cp.kpis) ? diffLi(cp.kpis, cmpAgainst ? cmpAgainst.kpis : null) : '');
      const tl = (Array.isArray(cp.timeline) ? diffLi(cp.timeline, cmpAgainst ? cmpAgainst.timeline : null) : '');
      let budgetDiff = false;
      if (cmpAgainst && cp.budget) {
        const bB = cmpAgainst.budget ? (cmpAgainst.budget.total + ' ' + (cmpAgainst.budget.split || '')) : '';
        budgetDiff = (cp.budget.total + ' ' + (cp.budget.split || '')) !== bB;
      }
      // Compare mode: if the server paired a rule-based baseline, offer a toggle.
      const cmpBtn = d.fallback
        ? '<button type="button" class="btn" id="agCmpBtn">' + (cmpVar ? '✓ Differences vs baseline shown' : '⇄ Highlight differences vs baseline') + '</button>'
        : '';
      // Real spend distribution from the Strategy agent's planner.allocate tool result.
      let budgetBar = '';
      const strat = (Array.isArray(d.agents) ? d.agents : []).find((ag) => ag.id === 'strategy');
      const split = strat && strat.exec && strat.exec.ok && Array.isArray(strat.exec.result.split) ? strat.exec.result.split : null;
      if (split && split.length) {
        const rows = split.map((s, i) => {
          const w = Math.round(parseFloat(s.share) || 0);
          const hex = ['var(--accent2)', 'var(--accent)', '#ff6fae', '#ff9e5c', '#49b6ff'][i % 5];
          return '<div class="ag-spend"><span class="ag-spend-name">' + esc(s.channel) + '</span><div class="ag-spend-track"><i style="width:' + w + '%;background:' + hex + '"></i></div><b>' + esc(s.share) + '</b></div>';
        }).join('');
        budgetBar = '<div class="blk"><b>Real spend split (planner.allocate)</b>' + rows + '</div>';
      }
      const budgetTxt = cp.budget ? ('<div class="ag-budget' + (budgetDiff ? ' ag-changed' : '') + '"><b>Total:</b> ' + esc(cp.budget.total || '—') + (cp.budget.split ? ' &nbsp;·&nbsp; <b>Split:</b> ' + esc(cp.budget.split) : '') + '</div>') : '';
      const note = (d.mode && d.mode !== 'ai')
        ? '<div class="ag-note">Running on the built-in rule-based planner — connect a Groq + search key for live LLM grounding.</div>'
        : '';
      const cmpLegend = (cmpVar && d.fallback)
        ? '<div class="ag-diffnote"><span class="ag-changedmark">highlighted</span> items differ from the rule-based baseline</div>'
        : '';
      plan.innerHTML =
        '<div class="ag-plan-head"><h3>📋 Campaign plan for: ' + esc(d.goal || '') + '</h3><div class="ag-actions">' + cmpBtn +
          '<button type="button" class="btn" id="agEditChannels">✎ Channels</button>' +
          '<button type="button" class="btn" id="agEditKpis">✎ KPIs</button>' +
          '<button type="button" class="btn" id="agEditTimeline">✎ Timeline</button>' +
          '<button type="button" class="btn" id="agEditBudget">✎ Budget</button>' +
          '<button type="button" class="btn" id="agPdfBtn">⬇ PDF</button>' +
          '<button type="button" class="btn" id="agTtsBtn">🔊 Hear plan</button><button type="button" class="btn" id="agCopyBtn">⧉ Copy plan</button><button type="button" class="btn" id="agShareBtn">🔗 Share</button></div></div>' +
        cmpLegend +
        '<div class="grid">' +
          '<div class="blk"><b>Channels</b><div class="ag-chips">' + (chips || '<span>—</span>') + '</div></div>' +
          '<div class="blk"><b>Budget</b>' + budgetTxt + '</div>' +
          budgetBar +
          '<div class="blk"><b>KPIs</b><ul>' + (kpis || '<li>—</li>') + '</ul></div>' +
          '<div class="blk"><b>Timeline</b><ul>' + (tl || '<li>—</li>') + '</ul></div>' +
        '</div>' +
        note +
        (d.summary ? '<div class="ag-summary">' + esc(d.summary) + '</div>' : '') +
        (d.telemetry ? '<div class="ag-tel"><b>Run telemetry:</b> ' + esc(telLine(d.telemetry)) + (d.cached ? ' · composition cached' : '') + '</div>' : '');
      const cmpBtn_ = document.getElementById('agCmpBtn');
      if (cmpBtn_) {
        cmpBtn_.addEventListener('click', function () {
          cmpVar = !cmpVar;
          renderPlan(data);
        });
      }

      // ---- Editable section: modal → POST /api/agentic/section → re-render ----
      const fieldVal = (f) => {
        const cp2 = data.campaignPlan || {};
        if (f === 'channels') return (cp2.channels || []).join(', ');
        if (f === 'kpis') return (cp2.kpis || []).join('\n');
        if (f === 'timeline') return (cp2.timeline || []).join('\n');
        return cp2.budget ? ((cp2.budget.total || '') + (cp2.budget.split ? ' — ' + cp2.budget.split : '')) : '';
      };
      const editable = { agEditChannels: 'channels', agEditKpis: 'kpis', agEditTimeline: 'timeline', agEditBudget: 'budget' };
      const modal = $('agModal');
      const modalTitle = $('agModalTitle'), modalHint = $('agModalHint'), modalArea = $('agModalArea'), modalSave = $('agModalSave'), modalCancel = $('agModalCancel');
      let modalField = '';
      if (modal) {
        modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
        modalCancel.addEventListener('click', closeModal);
        modalArea.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
      }
      function closeModal() { if (modal) modal.classList.remove('open'); }
      function openModal(field) {
        const labels = { channels: 'Channels', kpis: 'KPIs', timeline: 'Timeline', budget: 'Budget' };
        const hints = {
          channels: 'Comma-separated. e.g. Google Ads, Meta Ads, LinkedIn, YouTube',
          kpis: 'One KPI per line.',
          timeline: 'One milestone per line.',
          budget: 'Total, plus an optional split. e.g. ₹300000 — 60/40'
        };
        modalField = field;
        modalTitle.textContent = '✎ Edit ' + labels[field];
        modalHint.textContent = hints[field];
        modalArea.value = fieldVal(field);
        modal.classList.add('open');
        setTimeout(function () { modalArea.focus(); }, 30);
      }
      modalSave.addEventListener('click', async function () {
        const field = modalField;
        const nv = modalArea.value;
        if (!String(nv).trim() || String(nv).trim() === fieldVal(field)) { closeModal(); return; }
        closeModal();
        const b = document.getElementById(Object.keys(editable).find((k) => editable[k] === field));
        if (b) { b.disabled = true; b.textContent = '⏳ revising…'; }
        try {
          const r = await fetch('/api/agentic/section', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ runId: data.runId || '', field: field, value: String(nv).slice(0, 600), lang: langSel ? langSel.value : 'en', stream: true })
          });
          if (!r.ok) { let ej = {}; try { ej = await r.json(); } catch (e) {} throw new Error((ej && ej.error) || 'edit failed'); }
          // NDJSON stream: a 'diff' event (what changed), then the revised 'plan'.
          const reader = r.body.getReader();
          const dec = new TextDecoder();
          let buf = '', newData = null, diff = [];
          for (;;) {
            const { done, value } = await reader.read();
            if (done) break;
            buf += dec.decode(value, { stream: true });
            let idx;
            while ((idx = buf.indexOf('\n')) >= 0) {
              const line = buf.slice(0, idx); buf = buf.slice(idx + 1);
              if (!line.trim()) continue;
              let ev = null;
              try { ev = JSON.parse(line); } catch (e) { continue; }
              if (ev.event === 'diff') {
                diff = ev.fields || [];
                if (ev.telemetry) logLine('m', '✎ edit · ' + telLine(ev.telemetry));
              } else if (ev.event === 'plan' && ev.data) {
                newData = ev.data;
              } else if (ev.event === 'error') {
                throw new Error(ev.error || 'edit failed');
              }
            }
          }
          if (!newData) throw new Error('no plan in edit response');
          data = newData;
          renderPlan(data);
          logLine('t', '✎ ' + field + ' revised — plan regenerated' + (diff.length ? ' · changed: ' + diff.join(', ') : ''));
        } catch (e) {
          logLine('a', 'section edit failed — ' + String((e && e.message) || '') + '. Keep keys short & simple, or run again.');
        }
        if (b) { b.disabled = false; b.textContent = '✎ ' + Object.keys(editable).find((k) => editable[k] === field).charAt(0).toUpperCase() + field; }
      });
      ['agEditChannels', 'agEditKpis', 'agEditTimeline', 'agEditBudget'].forEach(function (id) {
        const b = document.getElementById(id);
        if (b) {
          b.addEventListener('click', function () { openModal(editable[id]); });
        }
      });

      // ---- PDF export: POST /api/agentic/pdf → download ----
      const pdfBtn = document.getElementById('agPdfBtn');
      if (pdfBtn) {
        pdfBtn.addEventListener('click', async function () {
          if (!data.runId) { logLine('a', 'no saved run to export — press 🔗 Share once to persist it'); return; }
          pdfBtn.disabled = true; pdfBtn.textContent = '⏳ building PDF…';
          try {
            const r = await fetch('/api/agentic/pdf', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ runId: data.runId })
            });
            if (!r.ok) throw new Error('pdf failed');
            const blob = await r.blob();
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'hive-plan-' + data.runId + '.pdf';
            document.body.appendChild(a); a.click(); a.remove();
            setTimeout(function () { URL.revokeObjectURL(a.href); }, 4000);
            logLine('t', 'pdf exported');
          } catch (e) {
            logLine('a', 'pdf export failed — ' + String((e && e.message) || ''));
          }
          pdfBtn.disabled = false; pdfBtn.textContent = '⬇ PDF';
        });
      }
      const ttsBtn = document.getElementById('agTtsBtn');
      if (ttsBtn) {
        ttsBtn.addEventListener('click', async function () {
          const txt = (d.summary || planToText(d)).slice(0, 1200);
          if (!txt.trim()) return;
          try {
            ttsBtn.disabled = true;
            ttsBtn.textContent = '⏳ Speaking…';
            const r = await fetch('/api/agentic/tts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ text: txt })
            });
            if (!r.ok) { const j = await r.json().catch(() => ({})); throw new Error((j && j.error) || 'tts failed'); }
            const blob = await r.blob();
            if (!blob || blob.size < 500) throw new Error('empty audio');
            const url = URL.createObjectURL(blob);
            const reset = () => { URL.revokeObjectURL(url); ttsBtn.disabled = false; ttsBtn.textContent = '🔊 Hear plan'; };
            const au = new Audio(url);
            au.onended = reset;
            au.onerror = () => { reset(); logLine('a', 'voice playback failed'); };
            await au.play().catch(() => { reset(); logLine('a', 'tap play again — browser blocked autoplay'); });
            ttsBtn.textContent = '🔈 Playing…';
          } catch (e) {
            ttsBtn.disabled = false;
            ttsBtn.textContent = '🔊 Hear plan';
            logLine('a', 'voice playback unavailable right now');
          }
        });
      }
      const copyBtn = document.getElementById('agCopyBtn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {          copyText(planToText(d)).then(function () {
            copyBtn.textContent = '✓ Copied';
            setTimeout(function () { copyBtn.textContent = '⧉ Copy plan'; }, 1800);
          }).catch(function () { copyBtn.textContent = 'Copy failed'; });
        });
      }
      const shareBtn = document.getElementById('agShareBtn');
      if (shareBtn) {
        shareBtn.addEventListener('click', function () {
          const payload = { goal: goal.value, niche: niche.value, budget: budget.value };
          if (d && d.runId && d.replayed === false) payload.runId = d.runId;
          const h = '#' + encodeURIComponent(JSON.stringify(payload));
          copyText(location.origin + location.pathname + h).then(function () {
            shareBtn.textContent = '✓ Link copied';
            setTimeout(function () { shareBtn.textContent = '🔗 Share'; }, 1800);
          }).catch(function () { shareBtn.textContent = 'Copy failed'; });
        });
      }
      plan.hidden = false;
      if (data && data.runId && followEl) followEl.hidden = false;
      plan.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
    }

    runBtn.addEventListener('click', run);
    goal.addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') run(); });

    // ---- Per-agent regenerate: redo one agent on the live plan, keep the rest ----
    agents.addEventListener('click', async function (e) {
      const btn = e.target.closest('.ag-regen');
      if (!btn) return;
      const card = btn.closest('.ag-card');
      if (!card) return;
      const agentId = card.getAttribute('data-agent');
      if (!agentId || !data || !data.runId) return;
      const prev = btn.textContent;
      btn.disabled = true;
      btn.textContent = '…';
      try {
        const r = await fetch('/api/agentic/regenerate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ runId: data.runId, agentId: agentId })
        });
        const j = await r.json();
        if (!r.ok) throw new Error((j && j.error) || 'regenerate failed');
        if (j.plan && Array.isArray(j.plan.agents)) {
          const old = data;
          data = j.plan;
          const na = data.agents.find((x) => (x.id || '').toLowerCase() === agentId);
          if (na) {
            const ui = makeCard(na);
            card.replaceWith(ui.card);
            requestAnimationFrame(() => ui.card.classList.add('show'));
            ui.status.textContent = 'done'; ui.status.className = 'ag-status done';
            ui.card.classList.add('done');
            ui.thinkP.textContent = na.thinking || '';
            ui.actP.textContent = na.action || '';
            ui.outP.textContent = na.output || '';
            ui.liveEl.textContent = na.live || '';
            if (na.call && ui.callEl) {
              const exec = na.exec || null;
              const toolName = esc(na.call || (exec && exec.tool));
              const argsText = (na.toolArgs && Object.keys(na.toolArgs).length) ? ' ' + esc(qs(na.toolArgs)) : '';
              if (exec && exec.ok) {
                ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + argsText + '</span><span class="ag-callres real">' + esc(na.result || '') + '</span><span class="ag-callms">' + exec.ms + 'ms</span>';
              } else if (exec && !exec.ok) {
                ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + argsText + '</span><span class="ag-callres err">' + esc((exec.error || 'tool failed')) + '</span>';
              } else {
                ui.callEl.innerHTML = '<span class="ag-calltool">' + toolName + '</span> <span class="ag-callres">' + esc(na.result || '') + '</span>';
              }
            }
            renderPlan(data);
            logLine('t', (na.name || agentId) + ' regenerated on the live plan' + (j.telemetry ? ' · ' + telLine(j.telemetry) : ''));
          }
        }
      } catch (e) {
        logLine('a', 'regenerate failed — ' + String((e && e.message) || ''));
      }
      btn.disabled = false;
      btn.textContent = prev;
    });

    // ---- Follow-up chat: send question to /api/agentic/follow, render reply, re-render plan ----
    function addFollowBubble(role, text) {
      const el = document.createElement('div');
      el.className = 'ag-follow-bubble ' + role;
      el.textContent = text;
      followThread.appendChild(el);
      followThread.scrollTop = followThread.scrollHeight;
      return el;
    }
    function followTyping() {
      const el = addFollowBubble('bot', '');
      el.classList.add('typing');
      el.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>';
      return el;
    }
    if (followBtn) {
      followBtn.addEventListener('click', async function () {
        const q = followInput.value.trim();
        if (!q || !data || !data.runId) { if (!data || !data.runId) logLine('a', 'run first so there is a plan to revise'); return; }
        followInput.value = '';
        addFollowBubble('user', q);
        followBtn.disabled = true; followBtn.textContent = '⏳ asking…';
        const bubble = followTyping();
        try {
          const r = await fetch('/api/agentic/follow', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ runId: data.runId, question: q.slice(0, 600), lang: langSel ? langSel.value : 'en', stream: true })
          });
          if (!r.ok) { let ej = {}; try { ej = await r.json(); } catch (e) {} throw new Error((ej && ej.error) || 'follow-up failed'); }
          // NDJSON stream: first an 'answer' event (typing effect), then 'plan'.
          const reader = r.body.getReader();
          const dec = new TextDecoder();
          let buf = '';
          let newData = null;
          let answer = '';
          for (;;) {
            const { done, value } = await reader.read();
            if (done) break;
            buf += dec.decode(value, { stream: true });
            let idx;
            while ((idx = buf.indexOf('\n')) >= 0) {
              const line = buf.slice(0, idx); buf = buf.slice(idx + 1);
              if (!line.trim()) continue;
              let ev = null;
              try { ev = JSON.parse(line); } catch (e) { continue; }
              if (ev.event === 'answer') {
                answer = String(ev.text || '');
                await type(bubble, answer);
                if (ev.telemetry) logLine('m', 'follow-up · ' + telLine(ev.telemetry));
              } else if (ev.event === 'plan' && ev.data) {
                newData = ev.data;
              } else if (ev.event === 'error') {
                throw new Error(ev.error || 'follow-up failed');
              }
            }
          }
          if (!newData) throw new Error('no plan in follow-up response');
          data = newData;
          renderPlan(data);
        } catch (e) {
          bubble.classList.remove('typing');
          bubble.textContent = '⚠ ' + String((e && e.message) || 'follow-up failed');
        }
        followBtn.disabled = false; followBtn.textContent = 'Ask →';
      });
      followInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') followBtn.click(); });
    }

    // ---- Competitor watch: list/add/remove keywords + trigger a check ----
    function renderWatchList(items, last) {
      watchList.innerHTML = (items || []).map(function (q) {
        return '<div class="ag-watch-item"><span>' + esc(q) + '</span><button type="button" class="btn btn-mini" data-watch="' + esc(q) + '">✕</button></div>';
      }).join('') || '<span class="ag-hint">No keywords yet — add one above.</span>';
      Array.prototype.forEach.call(watchList.querySelectorAll('[data-watch]'), function (b) {
        b.addEventListener('click', function () { watchRemove(b.getAttribute('data-watch')); });
      });
      // Show the most recent automated check (new competitors / rank moves).
      const lastEl = document.createElement('div');
      lastEl.className = 'ag-watch-note';
      if (last && last.at) {
        const when = new Date(last.at).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
        const found = (last.results || []).filter(function (r) { return (r.newCompetitors && r.newCompetitors.length) || (r.moves && r.moves.length); });
        if (found.length) {
          lastEl.innerHTML = '<b>Last check · ' + esc(when) + '</b><br>' + found.map(function (r) {
            const bits = [];
            if (r.newCompetitors && r.newCompetitors.length) bits.push('NEW: ' + r.newCompetitors.slice(0, 4).join(', '));
            if (r.moves && r.moves.length) bits.push(r.moves.slice(0, 4).join(', '));
            return '• ' + esc(r.query) + ': ' + esc(bits.join(' · '));
          }).join('<br>');
        } else {
          lastEl.innerHTML = '<b>Last check · ' + esc(when) + '</b> — no new competitors, no rank moves across ' + ((last.results || []).length) + ' keyword(s).';
        }
      }
      watchList.appendChild(lastEl);
    }
    async function watchLoad() {
      try {
        const r = await fetch('/api/watch', { cache: 'no-store' });
        const j = await r.json();
        renderWatchList(j.queries, j.last);
      } catch (e) {}
    }
    // Write actions are guarded server-side by WATCH_ADMIN_TOKEN (when set).
    // We keep the token in localStorage; if the API 401s, prompt once to store it.
    function watchToken() {
      try { return localStorage.getItem('hiveWatchToken') || ''; } catch (e) { return ''; }
    }
    async function watchWrite(body) {
      let h = { 'Content-Type': 'application/json' };
      const t = watchToken();
      if (t) h['x-watch-token'] = t;
      let r = await fetch('/api/watch', { method: 'POST', headers: h, body: JSON.stringify(body) });
      if (r.status === 401) {
        const tok = window.prompt('Enter the watch admin token to allow changes:');
        if (!tok) throw new Error('authorization required');
        try { localStorage.setItem('hiveWatchToken', tok); } catch (e) {}
        h['x-watch-token'] = tok;
        r = await fetch('/api/watch', { method: 'POST', headers: h, body: JSON.stringify(body) });
      }
      return r;
    }
    async function watchRemove(q) {
      try { await watchWrite({ action: 'remove', query: q }); } catch (e) { logLine('a', 'watch remove failed — ' + String((e && e.message) || '')); }
      watchLoad();
    }
    if (watchRunBtn) {
      watchRunBtn.addEventListener('click', async function () {
        watchRunBtn.disabled = true; watchRunBtn.textContent = '⏳ checking…';
        logLine('t', '🔎 running competitor check — pings any new domain to Telegram');
        try {
          const r = await watchWrite({ action: 'run' });
          const j = await r.json();
          logLine(j && j.ok ? 't' : 'a', j && j.ok ? ('🔎 checked ' + (j.results || []).length + ' keyword(s)') : ('watch check failed — ' + ((j && j.error) || '')));
          renderWatchList((j.queries) || undefined, (j.last) || undefined);
          watchLoad();
        } catch (e) {
          logLine('a', 'watch check failed — ' + String((e && e.message) || ''));
        }
        watchRunBtn.disabled = false; watchRunBtn.textContent = '↻ Check now';
      });
    }
    if (watchAddBtn) {
      watchAddBtn.addEventListener('click', async function () {
        const q = watchInput.value.trim();
        if (!q) return;
        watchInput.value = '';
        try {
          const r = await watchWrite({ action: 'add', query: q.slice(0, 120) });
          if (!r.ok) { const j = await r.json().catch(() => ({})); throw new Error((j && j.error) || 'add failed'); }
          logLine('t', '🔎 now watching "' + q.slice(0, 60) + '" — checks run each morning');
        } catch (e) {
          logLine('a', 'watch add failed — ' + String((e && e.message) || ''));
        }
        watchLoad();
      });
      watchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') watchAddBtn.click(); });
      watchLoad();
    }

    // Deep-link: /agentic-ai.html#{"goal":...,"runId":...} auto-runs Hive (or replays that exact run).
    (function () {
      try {
        const h = location.hash && location.hash.length > 4 ? JSON.parse(decodeURIComponent(location.hash.slice(1))) : null;
        if (h && h.goal) {
          if (h.goal) goal.value = String(h.goal).slice(0, 600);
          if (h.niche) niche.value = String(h.niche).slice(0, 120);
          if (h.budget) budget.value = String(h.budget).slice(0, 120);
          window._shareRunId = h.runId || '';
          setTimeout(run, 350);
        }
      } catch (e) {}
    })();
  </script>
</Base>
