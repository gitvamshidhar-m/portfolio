---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';

const op = {
  title: "Content Engine — Autonomous AI Content Studio with RAG | Vamshidhar Reddy",
  description: "The Content Engine is an autonomous 5-agent content studio: a Researcher mines live search and returns real citations, a Writer drafts the piece grounded in that research plus a knowledge base (RAG), an Editor fact-checks it, an SEO agent scores on-page optimization, and a Publisher assembles a publish-ready package with a markdown export.",
  canonical: "https://vamshidharm.vercel.app/content.html",
  ogImage: "",
  variant: 'sub',
  active: '/content.html',
};
const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "What is the Content Engine?", acceptedAnswer: { "@type": "Answer", text: "The Content Engine is an autonomous content studio made of five agents that collaborate on a single topic. The Researcher runs a real live web search and returns actual sources, citations, keywords and subtopics. The Writer drafts a markdown article grounded in that research plus a knowledge base of verified facts (retrieval-augmented generation). The Editor reviews the real draft for structure, length, hedges, claims and calls-to-action. The SEO agent scores on-page optimization against the actual text. The Publisher assembles a publish-ready package — slug, meta title/description, a markdown export and a readiness score." } },
    { "@type": "Question", name: "Is the demo real?", acceptedAnswer: { "@type": "Answer", text: "Yes. Every agent's tool really executes. The Researcher runs a live SERP query (SerpAPI/Brave/keyless fallback) and shows the actual results. The Writer drafts with a real LLM (Groq) when a key is set and a deterministic template otherwise. The Editor, SEO and Publisher run deterministic checks over the actual draft text — word counts, heading structure, keyword coverage, meta lengths and a blended readiness score — so the numbers on screen are real measurements, not placeholders." } },
    { "@type": "Question", name: "What makes it RAG, not just a chatbot writing an article?", acceptedAnswer: { "@type": "Answer", text: "Retrieval-augmented generation means the writing is grounded in retrieved documents, not just the model's memory. The Content Engine retrieves two kinds of evidence for every topic: real web search results (titles, snippets, domains, links) and matched entries from a knowledge base of verified facts about the author. Those retrieved chunks are injected into the Writer's prompt, and the Editor checks the draft against the same citations — so claims trace back to sources the reader can actually click." } },
    { "@type": "Question", name: "What does a human still need to do?", acceptedAnswer: { "@type": "Answer", text: "Publish. The engine drafts, fact-checks, scores and packages the piece, but a human owns the final call: approving the angle, fixing flagged issues the Editor surfaces, adding internal links and the brand's own CTA, and hitting publish in the CMS. The model deals with first-draft velocity; the human owns the brand's voice." } }
  ]
});
const body = `<section class="lpage-wrap">
  <div class="wrap">
    <div class="ag-hero">
      <div class="ag-hero-copy">
        <span class="tag">Content Engine · Agentic content studio</span>
        <h1>Five agents. One topic. A publish-ready piece.</h1>
        <p style="color:var(--muted)">Content briefs become drafts the slow way. <b style="color:var(--accent2)">The Content Engine runs the whole pipeline instead.</b> A Researcher mines live search and returns real citations, a Writer drafts the piece grounded in that research plus a knowledge base (<b style="color:var(--accent2)">RAG</b>), an Editor fact-checks it, an SEO agent scores on-page optimization, and a Publisher hands back a publish-ready package with a markdown export.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn primary btn-lg" href="#demo">▶ Run the Content Engine</a>
          <a class="btn link-secondary" href="/grapevine.html">See Grapevine, the reputation agent →</a>
        </div>
      </div>
      <div class="ag-orbit" aria-hidden="true">
        <svg class="ag-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
          <line data-agent="researcher" x1="50" y1="50" x2="24" y2="14"></line>
          <line data-agent="writer" x1="50" y1="50" x2="74" y2="11"></line>
          <line data-agent="editor" x1="50" y1="50" x2="9" y2="46"></line>
          <line data-agent="seo" x1="50" y1="50" x2="90" y2="44"></line>
          <line data-agent="publisher" x1="50" y1="50" x2="50" y2="84"></line>
        </svg>
        <div class="ag-core"><span>TOPIC</span><i></i></div>
        <span class="ag-sat" data-agent="researcher" style="top:14%;left:24%;--agc:#49b6ff">🔍</span>
        <span class="ag-sat" data-agent="writer" style="top:11%;left:74%;--agc:#8b7bff">✍️</span>
        <span class="ag-sat" data-agent="editor" style="top:46%;left:9%;--agc:#ff9e5c">🧐</span>
        <span class="ag-sat" data-agent="seo" style="top:44%;left:90%;--agc:#6ee7b7">🎯</span>
        <span class="ag-sat" data-agent="publisher" style="top:84%;left:50%;--agc:#ffd479">🚀</span>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <div class="ag-pipeline">
      <div class="ag-pipe">
        <div class="ag-node" style="--agc:#49b6ff"><span class="ag-nico">🔍</span><b>Researcher</b><i>live SERP</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#8b7bff"><span class="ag-nico">✍️</span><b>Writer</b><i>RAG draft</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#ff9e5c"><span class="ag-nico">🧐</span><b>Editor</b><i>fact-check</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#6ee7b7"><span class="ag-nico">🎯</span><b>SEO</b><i>on-page score</i></div>
        <span class="ag-arrow">→</span>
        <div class="ag-node" style="--agc:#ffd479"><span class="ag-nico">🚀</span><b>Publisher</b><i>ready to post</i></div>
      </div>
      <div class="ag-loop"><b>RAG in the loop:</b> real search snippets + matched knowledge-base facts are retrieved per topic and injected into the Writer and Editor — claims trace back to sources you can click.</div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">The team</span><h2 style="font-size:clamp(20px,3vw,26px)">A studio that ships first drafts like a staff writer</h2></div>
    <div class="ab-grid">
      <div class="ab-variant"><b>🔍 Researcher Agent</b><span class="ag-persona">The Archaeologist</span><p>Runs a real live search on your topic and returns actual sources, citations, keyword set and subtopics — nothing hallucinated.</p></div>
      <div class="ab-variant"><b>✍️ Writer Agent</b><span class="ag-persona">The Wordsmith</span><p>Drafts a structured markdown piece grounded in the retrieved research plus a knowledge base of verified facts (RAG), in your audience's voice.</p></div>
      <div class="ab-variant"><b>🧐 Editor Agent</b><span class="ag-persona">The Fact-Checker</span><p>Runs real editorial checks on the actual draft — length, headings, hedges, overclaims, citation coverage and a call-to-action — and issues a verdict.</p></div>
      <div class="ab-variant"><b>🎯 SEO Agent</b><span class="ag-persona">The Ranker</span><p>Scores on-page optimization from the real text: title length, meta description, keyword placement, heading hierarchy and word count.</p></div>
      <div class="ab-variant"><b>🚀 Publisher Agent</b><span class="ag-persona">The Launcher</span><p>Packages the piece for the CMS: slug, meta title and description, reading time, a clean markdown export with citations, and a blended readiness score.</p></div>
    </div>
  </div>

  <div class="wrap" id="demo" style="margin-top:44px;scroll-margin-top:90px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">Live demo · Content Engine + RAG</span><h2 style="font-size:clamp(22px,3.4vw,30px)">Brief a topic. Get a publish-ready draft.</h2>
    <p style="color:var(--muted);max-width:680px">Type a topic. The five agents will mine live search, draft a grounded piece, fact-check it, score its SEO and package it for publishing — with a markdown export. Runs on Groq when a key is set; otherwise the same real tools run with a rule-based writer.</p></div>
    <div class="ag-console">
        <div class="ag-input">
         <label for="topicInput">Topic to write about</label>
         <input id="topicInput" type="text" placeholder="e.g. how to lower cost-per-lead for B2B SaaS" />
         <div class="ag-row">
           <div><label for="audInput" style="font-size:12px;color:var(--muted)">Audience</label>
           <input id="audInput" type="text" placeholder="e.g. B2B SaaS founders" /></div>
           <div><label for="voiceInput" style="font-size:12px;color:var(--muted)">Voice</label>
           <input id="voiceInput" type="text" placeholder="e.g. clear and direct" /></div>
           <div><label for="wordsInput" style="font-size:12px;color:var(--muted)">Target length (words)</label>
           <input id="wordsInput" type="number" min="300" max="2400" step="100" value="900" /></div>
         </div>
         <div class="ag-runrow">
           <button id="runBtn" class="btn primary btn-lg" type="button">▶ Run Content Engine</button>
           <span id="ceMode" class="ag-mode" hidden></span>
           <span id="ceSerp" class="ag-mode serp" hidden></span>
           <span id="histWrap" class="ag-histwrap" hidden>
             <label for="histSel">↻ Past outputs</label>
             <select id="histSel" aria-label="Replay a past run"><option value="">—</option></select>
           </span>
           <span class="ag-hint">Try: “how to lower cost-per-lead for B2B SaaS” or “SEO content strategy 2026”.</span>
         </div>
       </div>
      <div class="ag-stage" id="agStage" hidden>
        <div class="ag-orch" id="agOrch"></div>
        <div class="ag-agents" id="agAgents"></div>
        <div class="ag-log" id="agLog"></div>
      </div>
      <div class="ce-brief" id="ceBrief" hidden></div>
      <div class="ag-share-row" id="ceShareRow" hidden>
        <button type="button" class="btn" id="ceCopyBtn">⧉ Copy package</button>
        <button type="button" class="btn" id="ceMdBtn">⬇ Markdown</button>
        <button type="button" class="btn" id="ceShareBtn">🔗 Share</button>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:44px">
    <div class="ag-proof">
      <div class="ag-proof-copy">
        <span class="tag">Why the Content Engine exists</span>
        <h2 style="font-size:clamp(20px,3vw,26px)">Great drafts are research, not inspiration</h2>
        <p style="color:var(--muted);max-width:640px">Most content fails before the writing starts — the brief was thin, the sources were vibes, and nobody checked the claim rate. The Content Engine front-loads the research: real sources first, a grounded draft, a fact-check, an SEO pass, and then a package you can actually paste into the CMS. The human owns the brand and the final publish call.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn primary" href="/hire.html">Want this in your content team? Let's talk →</a>
          <a class="btn link-secondary" href="/grapevine.html">Meet Grapevine, the reputation agent</a>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <span class="tag">Common questions</span>
    <div style="display:grid;gap:10px;margin-top:16px;max-width:820px">
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">What exactly does each agent do?</summary><p style="color:var(--muted);margin-top:8px">Researcher runs a live SERP query and returns real sources, citations, keywords and subtopics; Writer drafts a structured markdown article grounded in those sources plus matched knowledge-base facts (RAG); Editor runs real checks on the actual draft (length, headings, hedges, overclaims, citations, CTA) and issues a verdict; SEO scores on-page optimization from the real title/meta/headings/keywords; Publisher assembles the slug, meta title/description, reading time, markdown export and a blended readiness score.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Is the writing actually grounded, or does the model make things up?</summary><p style="color:var(--muted);margin-top:8px">The Writer is prompt-grounded in retrieved documents: the same real search results the Researcher surfaced plus verified knowledge-base facts, injected into the prompt with instructions not to invent numbers or sources. The Editor then re-checks the draft against those citations. It is RAG: retrieval before generation, and the sources are rendered at the bottom of the export so claims are traceable.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Can this publish on my own site?</summary><p style="color:var(--muted);margin-top:8px">Yes — that's the build: the Publisher outputs a front-matter markdown file (title, description, slug, reading time) plus the body and a Sources section, ready to drop into any CMS. A human reviews the Editor's flagged issues and adds the brand's internal links and CTA before hitting publish.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Where does agentic AI still need a human?</summary><p style="color:var(--muted);margin-top:8px">On judgement: the final angle, brand voice, internal links, and the publish call. The engine handles research, drafting, fact-checking, SEO scoring and packaging — the first ~90% of the work — and surfaces the issues a human should fix. It is designed for velocity and quality control, not to replace editorial judgement.</p></details>
    </div>
  </div>
</section>`;
---

<Base {...op}>
  <Fragment set:html={body} />
  <script type="application/ld+json" is:inline set:html={faqLd} />
  <LeadForm service="ai" serviceLabel="Content Engine" promise="Want an autonomous content studio for your team? I'll scope a RAG-grounded pipeline — live-research briefs to publish-ready drafts — and show you the first run on your actual topics." />
  <script>
    const AGENT_META = {
      researcher: { icon: '🔍', color: '#49b6ff', persona: 'The Archaeologist' },
      writer: { icon: '✍️', color: '#8b7bff', persona: 'The Wordsmith' },
      editor: { icon: '🧐', color: '#ff9e5c', persona: 'The Fact-Checker' },
      seo: { icon: '🎯', color: '#6ee7b7', persona: 'The Ranker' },
      publisher: { icon: '🚀', color: '#ffd479', persona: 'The Launcher' }
    };
    const STEP = 480, THINK = 480;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const $ = (id) => document.getElementById(id);

    async function type(el, text) {
      if (!el) return;
      if (reduce) { el.textContent = text; return; }
      el.textContent = '';
      for (let i = 0; i < text.length; i++) {
        el.textContent += text[i];
        await sleep(9);
      }
    }

    const runBtn = $('runBtn'), topicEl = $('topicInput'), audEl = $('audInput'), voiceEl = $('voiceInput'), wordsEl = $('wordsInput');
    const stage = $('agStage'), orch = $('agOrch'), agents = $('agAgents'), log = $('agLog'), brief = $('ceBrief'), shareRow = $('ceShareRow');
    const modeEl = $('ceMode'), serpEl = $('ceSerp'), histWrap = $('histWrap'), histSel = $('histSel');
    let data = null, lastTopic = '';

    function telLine(t) {
      if (!t) return 'no LLM calls metered';
      const tok = ((t.prompt || 0) + (t.completion || 0));
      const toolN = (t.tools && t.tools.calls) || 0;
      const toolMs = (t.tools && t.tools.ms) || 0;
      return (t.prompt ? (t.calls + ' LLM calls · ' + tok.toLocaleString('en-IN') + ' tokens') : ('0 LLM calls')) + ' · ' + t.ms + 'ms LLM · ' + toolN + ' real tools ' + toolMs + 'ms · ≈$' + ((t.cost || 0).toFixed(4)) + ' (est)';
    }

    function logLine(cls, html) {
      const d = document.createElement('div');
      d.className = 'ln';
      const t = new Date().toLocaleTimeString('en-IN', { hour12: false });
      d.innerHTML = '<span class="t">' + t + '</span> ' + (cls ? '<span class="' + cls + '">' + html + '</span>' : html);
      log.appendChild(d);
      log.scrollTop = log.scrollHeight;
    }

    function makeCard(a) {
      const card = document.createElement('div');
      card.className = 'ag-card';
      const id = (a.id || '').toLowerCase();
      card.setAttribute('data-agent', id);
      const meta = AGENT_META[id] || {};
      const icon = meta.icon || '🛰';
      if (meta.color) card.style.setProperty('--agc', meta.color);
      card.innerHTML =
        '<div class="ag-card-head">' +
          '<span class="ag-ico">' + icon + '</span>' +
          '<div><div class="ag-name">' + esc(a.name || 'Agent') + '</div><div class="ag-role">' + esc(a.role || '') + '</div>' + (meta.persona ? '<span class="ag-persona">' + esc(meta.persona) + '</span>' : '') + '</div>' +
          '<span class="ag-status">queued</span>' +
        '</div>' +
        '<div class="ag-live"></div>' +
        '<div class="ag-tools">' + (Array.isArray(a.tools) ? a.tools.map((t) => '<span>' + esc(t) + '</span>').join('') : '') + '</div>' +
        '<div class="ag-field think"><span class="k">Thinking</span><p></p></div>' +
        '<div class="ag-field act"><span class="k">Action</span><p></p></div>' +
        '<div class="ag-field out"><span class="k">Output</span><p></p></div>' +
        '<div class="ag-call"></div>' +
        '<div class="ag-handoff"></div>';
      const status = card.querySelector('.ag-status');
      const thinkP = card.querySelector('.ag-field.think p');
      const actP = card.querySelector('.ag-field.act p');
      const outP = card.querySelector('.ag-field.out p');
      const liveEl = card.querySelector('.ag-live');
      const callEl = card.querySelector('.ag-call');
      const handoffEl = card.querySelector('.ag-handoff');
      return { card, status, thinkP, actP, outP, liveEl, callEl, handoffEl };
    }

    // Compact offline fallback so the page still demos if the API is unreachable.
    function clientFallback(topic) {
      const t = String(topic || 'the topic').trim();
      const core = t.charAt(0).toUpperCase() + t.slice(1);
      const ag = (id, thinking, action, output, live, call, result) => ({ id, name: AGENT_META[id].name, persona: AGENT_META[id].persona, role: '', tools: [call], thinking, action, output, live, call, result, status: 'done' });
      const kw = ['strategy', 'optimization', 'results'];
      const draft = '# ' + core + ': a practical, results-first guide\n\n> Written for marketers. Grounded in live research.\n\n## Why ' + t + ' matters\n\nThe teams that win treat ' + t + ' as a system — baseline, one clean test, scale what passes.\n\n## The three levers\n\nTest one change at a time and measure against a real baseline before you scale.\n\n## A simple weekly cadence\n\nThirty minutes every Monday: pick the single biggest lever, design one test, get a verdict by Friday.\n\n## Key takeaways\n\n- Pick one lever\n- Measure against a baseline\n- Scale only what beats your previous best\n';
      return {
        mode: 'offline', topic: t,
        orchestrator: 'Researcher mines live search for "' + core + '", Writer drafts grounded in that research + knowledge base, Editor fact-checks over the sources, SEO scores on-page optimization, Publisher assembles the publish-ready package.',
        agents: [
          ag('researcher', 'Mines live search for the angles, keywords and citable sources behind "' + core + '".', 'Queries SERP for the topic plus intent variants.', 'Real sources + keyword set surfaced — handed to Writer.', 'Mining live search…', 'content.research', 'source set + keywords + citations'),
          ag('writer', 'Drafts the piece in a clear, direct voice.', 'Writes a structured draft grounded in the retrieved research and knowledge base.', 'A structured draft handed to Editor for review.', 'Drafting the piece…', 'content.draft', 'structured draft + title'),
          ag('editor', 'Checks the draft for structure, length and claims.', 'Runs real editorial checks over the actual draft against keywords and sources.', 'Verdict + issue list handed to the SEO agent.', 'Reviewing the draft…', 'content.edit', 'verdict + issue list'),
          ag('seo', 'Scores the on-page optimization of the real draft.', 'Measures title, meta, headings and keyword placement against the actual text.', 'A real 0-100 on-page score handed to Publisher.', 'Scoring on-page SEO…', 'content.seo', 'SEO score + checklist'),
          ag('publisher', 'Packages the piece for publishing.', 'Builds slug, meta, markdown export and readiness verdict from the real draft.', 'A publish-ready package with export handed back.', 'Packaging for publish…', 'content.publish', 'slug + meta + markdown export')
        ],
        briefing: 'The Content Engine produced a clear, direct piece on "' + core + '" for marketers — grounded in live web research, fact-checked over the real sources, scored for on-page SEO and packaged ready to publish with a markdown export.',
        nextSteps: ['Approve the Editor\'s verdict and fix any flagged issues', 'Add internal links and a call-to-action in the CMS', 'Publish the markdown export and share the citations with the team'],
        research: { sources: [], keywords: kw, citations: [] },
        sources: [], citations: [], keywords: kw,
        draft: draft, title: core,
        editor: { verdict: 'minor edits', score: 75, passes: 6, issues: ['Offline demo — run against the live API for a full fact-check.'], stats: { words: 120 } },
        seo: { score: 75, passes: 6, total: 8, checks: [{ ok: true, label: 'Title within 25-60 chars' }, { ok: true, label: 'Meta under 162 chars' }, { ok: false, label: 'Primary keyword in title' }, { ok: false, label: '≥2 researched keywords in body' }, { ok: true, label: 'Exactly one H1' }, { ok: true, label: '≥2 H2 sections' }, { ok: false, label: '300+ word count' }, { ok: true, label: 'Key takeaways section' }], metaTitle: core, metaDesc: 'A practical guide to ' + t + ' for marketers — grounded in live research and a verified track record.' },
        publish: { slug: String(t).toLowerCase().replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '-').slice(0, 60), metaTitle: core, metaDesc: 'A practical guide to ' + t + ' for marketers.', wordCount: 120, readingMin: 1, ready: 78, markdown: draft, headings: [core, 'Why ' + t + ' matters', 'The three levers', 'A simple weekly cadence', 'Key takeaways'] },
        metrics: { wordCount: 120, seoScore: 75, readiness: 78, citations: 0 },
        telemetry: { calls: 0, ms: 0, cost: 0, tools: { calls: 0, ms: 0 } }
      };
    }

    function scoreColor(s) {
      if (s >= 80) return '#8affc1';
      if (s >= 55) return '#ffd479';
      return '#ff6f6f';
    }

    function markdownPlain(md) {
      return String(md || '')
        .replace(/^#{1,3}\s+/gm, '')
        .replace(/[*_`>]/g, '')
        .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
    }

    function renderBrief(d) {
      const edit = d.editor || {};
      const seo = d.seo || {};
      const pub = d.publish || {};
      const sources = d.sources || [];
      const kws = d.keywords || [];
      const metrics = d.metrics || {};
      const escCell = (v) => { const s = String(v == null ? '' : v); return s.replace(/"/g, '""'); };

      const kwChips = kws.length
        ? '<div class="ag-chips">' + kws.slice(0, 8).map((k) => '<span>#' + esc(k) + '</span>').join('') + '</div>'
        : '<div class="ag-hint">no keyword set retrieved</div>';

      const sourceList = sources.slice(0, 6).map((s, i) =>
        '<li><a href="' + esc(s.link || '#') + '" target="_blank" rel="noopener" style="color:var(--accent2)">' + esc(s.title || s.domain || 'source') + '</a> <span class="ag-hint">(' + esc(s.domain || 'web') + ')</span></li>'
      ).join('');

      const issues = (edit.issues || []).map((i) =>
        '<li><span class="ag-pri" style="color:#ff9e5c">fix</span> ' + esc(i) + '</li>'
      ).join('');
      const editOk = edit.passes != null
        ? '<div class="ce-bignum" style="color:' + scoreColor(edit.score || 0) + '">' + edit.score + ' <i>editorial</i></div><div class="ag-hint">' + (edit.passes || 0) + ' checks passed · verdict: <b style="color:var(--txt)">' + esc(edit.verdict || '—') + '</b></div>'
        : '<div class="ag-hint">no editorial pass yet</div>';

      const seoChecks = (seo.checks || []).map((c) =>
        '<li class="' + (c.ok ? 'ce-ok' : 'ce-bad') + '">' + (c.ok ? '✓' : '✗') + ' ' + esc(c.label) + '</li>'
      ).join('');

      const seoBlock = seo.score != null
        ? '<div class="blk"><b>🎯 SEO Agent · on-page score</b><div class="ce-gauge" style="--ceg:' + scoreColor(seo.score) + '">' + seo.score + '<i>' + (seo.passes || 0) + '/' + (seo.total || 8) + ' checks</i></div><ul class="ce-checks">' + seoChecks + '</ul>' +
          (seo.metaTitle ? '<div class="ce-meta"><span>meta title · ' + (seo.metaTitle || '').length + ' chars</span><b>' + esc(seo.metaTitle || '') + '</b><span>meta description · ' + (seo.metaDesc || '').length + ' chars</span><b>' + esc(seo.metaDesc || '') + '</b></div>' : '') +
          '</div>'
        : '<div class="blk"><b>🎯 SEO Agent</b><div class="ag-hint">no SEO pass yet</div></div>';

      const readyCol = scoreColor(pub.ready || 0);
      const pubBlock = pub.slug
        ? '<div class="blk ce-readyb"><b>🚀 Publisher Agent · ready to post</b>' +
          '<div class="ce-ready"><div class="ce-bignum" style="color:' + readyCol + '">' + (pub.ready || 0) + '%</div><span class="ag-hint">readiness</span></div>' +
          '<div class="ce-meta"><span>slug</span><b>/' + esc(pub.slug || '') + '</b><span>reading time</span><b>' + (pub.readingMin || 1) + ' min · ' + (pub.wordCount || 0) + ' words</b></div>' +
          (pub.ctaPresent !== undefined ? '<div class="ag-hint">CTA present: ' + (pub.ctaPresent ? 'yes' : 'no — add one before publish') + '</div>' : '') +
          '</div>'
        : '<div class="blk"><b>🚀 Publisher Agent</b><div class="ag-hint">no package yet</div></div>';

      const draftHtml = String(d.draft || '').split('\n').map((line) => {
        const m = line.match(/^(#{1,3})\s+(.*)$/);
        if (m) return '<h' + m[1].length + ' style="margin:14px 0 6px;color:var(--txt)">' + esc(m[2]) + '</h' + m[1].length + '>';
        if (/^>/.test(line)) return '<p class="ag-hint" style="margin:4px 0">' + esc(markdownPlain(line)) + '</p>';
        if (/^[-*]\s/.test(line)) return '<li style="font-size:13px;line-height:1.55;margin:3px 0">' + esc(markdownPlain(line.slice(2))) + '</li>';
        if (/^\[.+?\]\(https?:\/\/.+\)$/.test(line.trim())) return '<a href="' + esc((line.trim().match(/\((https?:\/\/[^)]+)\)/) || ['', '#'])[1]) + '" target="_blank" rel="noopener" style="color:var(--accent2);font-size:12.5px">' + esc(markdownPlain(line)) + '</a><br>';
        return '<p style="font-size:13.5px;line-height:1.65;margin:6px 0;color:var(--txt)">' + esc(markdownPlain(line)) + '</p>';
      }).join('');

      brief.innerHTML =
        '<div class="ag-plan-head"><h3>📝 Content Engine · ' + esc(d.title || d.topic || '') + '</h3>' +
        '<div class="ag-actions"><button type="button" class="btn" id="ceCopyBtn">⧉ Copy package</button><button type="button" class="btn" id="ceMdBtn">⬇ Markdown</button><button type="button" class="btn" id="ceTxtBtn">⬇ Plain text</button></div></div>' +
        '<div class="ce-verdict"><b>' + esc((edit.verdict || 'draft ready') + '') + '</b><span class="ag-hint">' + (metrics.wordCount || 0) + ' words · ' + (d.metrics && d.metrics.citations != null ? d.metrics.citations + ' citations' : 'offline demo') + '</span></div>' +
        '<div class="grid">' +
          '<div class="blk"><b>🔍 Research · live sources</b>' + kwChips + '<ul class="ce-sources">' + (sourceList || '<li class="ag-hint">no live sources (offline demo)</li>') + '</ul></div>' +
          '<div class="blk"><b>🧐 Editor Agent · fact-check</b>' + editOk + '<ul class="ce-issues">' + (issues || '<li class="ce-ok">✓ No issues flagged</li>') + '</ul></div>' +
          seoBlock +
          pubBlock +
        '</div>' +
        '<div class="ce-draft"><div class="ce-draft-head"><b>✍️ Draft</b><span class="ag-hint">grounded in ' + (sources.length ? sources.length + ' live source(s)' : 'retrieved context') + ' + knowledge base</span></div><div class="ce-draft-body">' + draftHtml + '</div></div>' +
        (d.briefing ? '<div class="ag-summary">' + esc(d.briefing) + '</div>' : '') +
        ((d.nextSteps || []).length ? '<div class="ag-summary"><b>Next steps:</b> ' + (d.nextSteps || []).map(function (s) { return '<span class="ag-hint">' + esc(s) + '</span>'; }).join(' &nbsp;→&nbsp; ') + '</div>' : '') +
        (d.telemetry ? '<div class="ag-tel"><b>Run telemetry:</b> ' + esc(telLine(d.telemetry)) + '</div>' : '');
      brief.hidden = false;
      shareRow.hidden = false;

      const copyBtn = $('ceCopyBtn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          copyText(briefToText(d)).then(function () { copyBtn.textContent = '✓ Copied'; setTimeout(function () { copyBtn.textContent = '⧉ Copy package'; }, 1800); }).catch(function () { copyBtn.textContent = 'Copy failed'; });
        });
      }
      const mdBtn = $('ceMdBtn');
      if (mdBtn) {
        mdBtn.addEventListener('click', function () {
          downloadFile('content-' + String(d.publish && d.publish.slug || 'article').replace(/[^\w-]+/g, '-') + '.md', (d.publish && d.publish.markdown) || ('# ' + d.title + '\n\n' + d.draft), 'text/markdown;charset=utf-8');
          mdBtn.textContent = '⬇ Saved'; setTimeout(function () { mdBtn.textContent = '⬇ Markdown'; }, 1800);
        });
      }
      const txtBtn = $('ceTxtBtn');
      if (txtBtn) {
        txtBtn.addEventListener('click', function () {
          downloadFile('content-' + String(d.publish && d.publish.slug || 'article').replace(/[^\w-]+/g, '-') + '.txt', markdownPlain(d.publish && d.publish.markdown || d.draft) + '\n\n—\n' + (sources || []).map(function (s) { return s.domain; }).join(', '), 'text/plain;charset=utf-8');
          txtBtn.textContent = '⬇ Saved'; setTimeout(function () { txtBtn.textContent = '⬇ Plain text'; }, 1800);
        });
      }
      const shareBtn = $('ceShareBtn');
      if (shareBtn) {
        shareBtn.addEventListener('click', function () {
          const h = '#{"topic":"' + encodeURIComponent(d.topic || d.title || '') + '"}';
          copyText(location.origin + location.pathname + h).then(function () { shareBtn.textContent = '✓ Link copied'; setTimeout(function () { shareBtn.textContent = '🔗 Share'; }, 1800); }).catch(function () { shareBtn.textContent = 'Copy failed'; });
        });
      }
      populateHist(d.topic);
    }

    function briefToText(d) {
      const L = [];
      L.push('CONTENT ENGINE: ' + (d.title || d.topic || ''));
      L.push('');
      (d.agents || []).forEach(function (a) {
        L.push('• ' + (a.name || 'Agent'));
        if (a.thinking) L.push('   thinking: ' + a.thinking);
        if (a.action) L.push('   action:   ' + a.action);
        if (a.output) L.push('   output:   ' + a.output);
        if (a.call) L.push('   tool:     ' + a.call + (a.result ? (' → ' + a.result) : ''));
      });
      L.push('');
      if ((d.keywords || []).length) L.push('KEYWORDS: ' + d.keywords.slice(0, 8).join(', '));
      if (d.editor) L.push('EDITOR: ' + (d.editor.verdict || '') + ' · score ' + (d.editor.score != null ? d.editor.score + '/100' : '—') + (d.editor.issues && d.editor.issues.length ? ' · issues: ' + d.editor.issues.join('; ') : ''));
      if (d.seo) L.push('SEO: ' + (d.seo.score != null ? d.seo.score + '/100' : '—') + ' · meta "' + (d.seo.metaDesc || '') + '"');
      if (d.publish) L.push('PUBLISH: /' + (d.publish.slug || '') + ' · ' + (d.publish.metaTitle || '') + ' · ' + (d.publish.wordCount || 0) + ' words · ready ' + (d.publish.ready || 0) + '%');
      L.push('');
      (d.sources || []).forEach(function (s) { L.push('SOURCE: ' + (s.title || '') + ' (' + s.domain + ') ' + s.link); });
      L.push('');
      if (d.draft) L.push('DRAFT:\n' + markdownPlain(d.publish && d.publish.markdown || d.draft));
      L.push('');
      if (d.briefing) L.push('BRIEFING: ' + d.briefing);
      return L.join('\n');
    }

    function downloadFile(name, content, type) {
      const blob = new Blob([content], { type: type });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(a.href);
    }

    async function populateHist(topic) {
      if (!topic || !histWrap || !histSel) return;
      try {
        const r = await fetch('/api/content?recent=1&topic=' + encodeURIComponent(topic), { cache: 'no-store' });
        if (!r.ok) throw new Error('bad');
        const j = await r.json();
        const runs = (j && j.runs) || [];
        histSel.innerHTML = '<option value="">—</option>';
        runs.forEach(function (run) {
          const when = new Date(run.at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', hour12: false });
          histSel.insertAdjacentHTML('beforeend', '<option value="' + esc(run.runId) + '">' + esc(when) + (run.runId === data.runId ? ' · current' : '') + '</option>');
        });
        histWrap.hidden = runs.length < 1;
        histSel.disabled = false;
      } catch (e) {
        histWrap.hidden = true;
      }
    }

    async function replay(runId) {
      runBtn.disabled = true;
      runBtn.textContent = '⏳ Loading past output…';
      try {
        const r = await fetch('/api/content?run=' + encodeURIComponent(runId), { cache: 'no-store' });
        if (!r.ok) throw new Error('bad');
        const j = await r.json();
        if (!j || !Array.isArray(j.agents)) throw new Error('bad');
        data = j;
        if (modeEl) { modeEl.hidden = false; modeEl.className = 'ag-mode ai'; modeEl.textContent = '● REPLAYED OUTPUT'; }
        serpEl.hidden = true;
        logLine('a', 'replayed stored run ' + runId);
        orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator:</b> ' + esc(j.orchestrator || ('Producing ' + (j.topic || 'the piece') + '…')) + '</span>';
        renderBrief(j);
        populateHist(j.topic);
      } catch (e2) {
        logLine('a', 'replay failed — stored run may have expired');
      } finally {
        runBtn.disabled = false;
        runBtn.textContent = '▶ Run again';
      }
    }

    if (histSel) histSel.addEventListener('change', function () {
      if (histSel.value) replay(histSel.value);
    });

    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(text);
      return new Promise(function (resolve, reject) {
        try {
          const ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          document.execCommand('copy'); document.body.removeChild(ta); resolve();
        } catch (e) { reject(e); }
      });
    }

    function reset() {
      agents.innerHTML = '';
      log.innerHTML = '';
      orch.innerHTML = '';
      brief.hidden = true;
      shareRow.hidden = true;
      if (modeEl) modeEl.hidden = true;
      if (serpEl) serpEl.hidden = true;
      if (histWrap) histWrap.hidden = true;
    }

    async function run() {
      const topic = topicEl.value.trim();
      if (!topic) { topicEl.focus(); topicEl.style.borderColor = 'var(--accent)'; return; }
      topicEl.style.borderColor = '';
      runBtn.disabled = true;
      runBtn.textContent = '⏳ Studio working…';
      stage.hidden = false;
      reset();
      data = null;
      const payload = {
        topic: topic,
        audience: audEl ? audEl.value.trim() : '',
        voice: voiceEl ? voiceEl.value.trim() : '',
        wordCount: wordsEl ? Number(wordsEl.value) || 900 : 900,
        stream: true
      };
      try {
        const res = await fetch('/api/content', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error('bad');
        const reader = res.body.getReader();
        const dec = new TextDecoder();
        let buf = '';
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buf += dec.decode(value, { stream: true });
          let idx;
          while ((idx = buf.indexOf('\n')) >= 0) {
            const line = buf.slice(0, idx); buf = buf.slice(idx + 1);
            if (!line.trim()) continue;
            let ev = null;
            try { ev = JSON.parse(line); } catch (e) { continue; }
            if (ev.event === 'tool') {
              const ok = ev.exec && ev.exec.ok;
              logLine(ok ? 't' : 'a', (AGENT_META[ev.id] ? (AGENT_META[ev.id].icon + ' ') : '🛰 ') + '<b>' + esc(ev.tool || 'tool') + '</b> ' + (ok ? 'executed in ' + ev.exec.ms + 'ms' : 'failed — fallback used'));
            } else if (ev.event === 'serp') {
              if (ev.used) logLine('t', 'researcher grounded in live SERP (' + ev.count + ' results)');
            } else if (ev.event === 'metrics') {
              logLine('m', 'metrics · ' + telLine(ev.telemetry));
            } else if (ev.event === 'orch' && ev.text) {
              orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator:</b> ' + esc(ev.text.slice(0, 300)) + '</span>';
            } else if (ev.event === 'reflect') {
              logLine('t', (AGENT_META[ev.id] ? AGENT_META[ev.id].icon + ' ' : '') + 'observed real tool result — handoff updated');
            } else if (ev.event === 'plan' && ev.data && Array.isArray(ev.data.agents) && ev.data.agents.length) {
              data = ev.data;
            }
          }
        }
        if (!data) throw new Error('empty');
      } catch (e) {
        data = clientFallback(topic);
        logLine('a', 'live API unreachable — using built-in planner');
      }

      if (modeEl) {
        modeEl.hidden = false;
        modeEl.className = 'ag-mode ' + (data.mode === 'ai' ? 'ai' : 'template');
        modeEl.textContent = data.mode === 'ai' ? '● LIVE LLM' : (data.mode === 'offline' ? '● OFFLINE DEMO' : '● RULE-BASED FALLBACK');
      }
      if (serpEl) {
        if (data.serpUsed) {
          serpEl.hidden = false;
          serpEl.textContent = '🔎 LIVE SERP · ' + (data.serpCount || 0) + ' results';
        } else {
          serpEl.hidden = true;
        }
      }

      orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator:</b> ' + esc(data.orchestrator || ('Producing ' + (data.topic || 'the piece') + '…')) + '</span>';
      logLine('a', 'orchestrator: ' + esc(data.orchestrator || 'starting'));

      const seq = data.agents;
      for (let i = 0; i < seq.length; i++) {
        const a = seq[i];
        const id = (a.id || '').toLowerCase();
        const ui = makeCard(a);
        agents.appendChild(ui.card);
        requestAnimationFrame(() => ui.card.classList.add('show'));
        const sat = document.querySelector('.ag-sat[data-agent="' + id + '"]');
        const line = document.querySelector('.ag-lines line[data-agent="' + id + '"]');
        if (sat) sat.classList.add('on');
        if (line) line.classList.add('on');
        ui.status.textContent = 'thinking'; ui.status.className = 'ag-status thinking';
        ui.card.classList.add('active');
        const liveTxt = a.live || ((a.name || 'Agent') + ' working');
        logLine('a', (a.name || 'agent') + ' — ' + liveTxt);
        await type(ui.liveEl, liveTxt + '…');
        await sleep(THINK);
        ui.thinkP.textContent = '';
        await type(ui.thinkP, a.thinking || '');
        await sleep(STEP);
        ui.actP.textContent = a.action || '';
        ui.outP.textContent = a.output || '';
        ui.liveEl.textContent = liveTxt;
        ui.liveEl.classList.add('done');
        if (a.call && ui.callEl) {
          const exec = a.exec || null;
          const toolName = esc(a.call || (exec && exec.tool));
          if (exec && exec.ok) {
            ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + '</span><span class="ag-callres real">' + esc(a.result || '') + '</span><span class="ag-callms">' + exec.ms + 'ms</span>';
          } else if (exec && !exec.ok) {
            ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + '</span><span class="ag-callres err">' + esc((exec.error || 'tool failed')) + '</span>';
          } else {
            ui.callEl.innerHTML = '<span class="ag-calltool">' + toolName + '</span> <span class="ag-callres">' + esc(a.result || '') + '</span>';
          }
        }
        ui.status.textContent = 'done'; ui.status.className = 'ag-status done';
        ui.card.classList.remove('active'); ui.card.classList.add('done');
        const next = seq[i + 1];
        if (next && ui.handoffEl) ui.handoffEl.innerHTML = '↓ hands off to ' + esc(next.name);
        logLine('', (a.name || 'agent') + ' → ' + esc((a.output || '').slice(0, 90)));
        await sleep(STEP * 0.35);
      }

      renderBrief(data);
      runBtn.disabled = false;
      runBtn.textContent = '▶ Run again';
    }

    runBtn.addEventListener('click', run);
    topicEl.addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') run(); });

    // Deep-link: /content.html#{"topic":...} auto-runs the engine.
    (function () {
      try {
        const h = location.hash && location.hash.length > 4 ? JSON.parse(decodeURIComponent(location.hash.slice(1))) : null;
        if (h && h.topic) {
          topicEl.value = String(h.topic).slice(0, 160);
          setTimeout(run, 350);
        } else if (h && h.runId && histSel) {
          histSel.value = String(h.runId).slice(0, 64);
          setTimeout(function () { replay(histSel.value); }, 350);
        }
      } catch (e) {}
    })();
  </script>
</Base>