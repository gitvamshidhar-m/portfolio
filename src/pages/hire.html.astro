---
import Base from '../layouts/Base.astro';

const op = {
  title: "Hire Me — Personalized Pitch Generator | Vamshidhar Reddy",
  description: "Paste a job description or answer a quick quiz and get a personalized outreach email plus a first-30-days plan from Vamshidhar, an AI-augmented performance marketer.",
  canonical: "https://vamshidharm.vercel.app/hire.html",
  ogImage: "",
  variant: 'sub',
  active: 'hire.html',
};
const body = `
<section>
  <div class="wrap">
    <div class="sec-head reveal"><span class="tag">Hire me · build your pitch</span><h1>Paste the JD. I write your reach-out email.</h1></div>
    <p class="reveal" style="text-align:center;max-width:760px;margin:0 auto 20px;color:var(--muted)">I don't send the same CV everywhere. Three steps — paste a real job description or answer a quick quiz — and this tool drafts a tailored email plus a concrete first-30-days plan grounded in my real results.</p>

    <div class="stepbar reveal" id="stepbar">
      <div class="stepbar-item on" data-s="1"><span class="sb-n">1</span>How we pitch</div>
      <div class="stepbar-item" data-s="2"><span class="sb-n">2</span>Details</div>
      <div class="stepbar-item" data-s="3"><span class="sb-n">3</span>Generate &amp; send</div>
      <span class="sb-prog" id="sbProg"></span>
    </div>

    <div class="reveal" style="max-width:820px;margin:0 auto">
      <form id="hireForm" style="display:grid;gap:14px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;margin-top:14px">
        <label class="hp" aria-hidden="true">Website <input name="hp_three" type="text" tabindex="-1" autocomplete="off"></label>

        <div data-pane="mode">
          <p style="margin:0 0 10px;color:var(--muted);font-size:14px">How do you want to build it?</p>
          <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px">
            <label class="qcard"><input type="radio" name="mode" value="jd" checked> 📋 I have a job description</label>
            <label class="qcard"><input type="radio" name="mode" value="quiz"> ⚡ Quick quiz instead</label>
          </div>
        </div>

        <div data-pane="jd" hidden>
          <input name="company" placeholder="Company you're applying to (optional)">
          <textarea name="jd" rows="6" style="width:100%;box-sizing:border-box;font:inherit;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--txt)" placeholder="Paste the full job description here… (title, requirements, what the team runs)"></textarea>
        </div>

        <div data-pane="quiz" hidden>
          <select name="focus"><option value="ppc">Paid Media / PPC</option><option value="seo">SEO &amp; Content</option><option value="ai">AI Automation</option><option value="growth">Full-funnel Growth</option></select>
          <select name="stage"><option value="startup">Startup — one owner of demand</option><option value="scale">Scale-up — channel discipline needed</option><option value="enterprise">Enterprise — heavy tooling &amp; approvals</option></select>
          <select name="kpi"><option value="roas">KPI: ROAS / ad efficiency</option><option value="cpl">KPI: Cost-per-lead</option><option value="leads">KPI: Lead volume</option><option value="traffic">KPI: Organic traffic</option><option value="retention">KPI: Retention / LTV</option></select>
        </div>

        <div data-pane="review" hidden>
          <b>Ready to draft.</b> The generator reads my real track record (ROAS 3.2x→5.5x, CPL −30%, +15% organic traffic, 3 solo AI products) and your inputs, then writes a tailored email + a 30-day plan. Takes ~15s, costs nothing.
        </div>

        <div style="display:flex;gap:10px;justify-content:space-between;flex-wrap:wrap">
          <button class="btn" type="button" id="backBtn" hidden>← Back</button>
          <span style="display:flex;gap:10px;margin-left:auto">
            <button class="btn primary" type="button" id="nextBtn">Continue →</button>
            <button class="btn primary" type="submit" id="genBtn" hidden>Generate my pitch →</button>
          </span>
        </div>
        <p id="hmsg" class="formmsg" hidden></p>
      </form>

      <div id="hout" hidden style="margin-top:18px;display:grid;gap:14px">
        <div style="background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
            <b id="hsubj"></b>
            <span style="display:flex;gap:8px;flex-wrap:wrap">
              <button type="button" class="btn" id="hcopy">Copy email</button>
              <a class="btn" id="hmail" target="_blank" rel="noopener noreferrer">Send via Gmail →</a>
              <a class="btn" id="hplanCard" target="_blank" rel="noopener noreferrer">Plan card ↗</a>
              <button type="button" class="btn" id="hplanDl">Plan card PNG</button>
            </span>
          </div>
          <pre id="hbody" style="white-space:pre-wrap;font-family:inherit;margin:12px 0 0;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:14px;font-size:14px;line-height:1.7"></pre>
        </div>
        <div style="background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px">
          <b>My first-30-days plan</b>
          <ol id="hplan" style="margin:10px 0 0 18px;color:var(--muted);display:grid;gap:8px"></ol>
          <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
            <button type="button" class="btn" id="hAts">Download my CV for your ATS (.txt)</button>
            <button type="button" class="btn" id="hAtsJson">ATS JSON</button>
          </div>
        </div>
      </div>

      
      <div class="compass reveal">
        <b>🧭 The compass — my honest ask</b>
        <p style="margin:6px 0 12px;font-size:13px;color:var(--muted)">Pick what fits and get a real number. I'd rather shortlist ourselves than waste your time.</p>
        <select id="compStage"><option value="startup">Company: startup / seed</option><option value="growth">Company: growth / funded</option><option value="enterprise">Company: enterprise</option></select>
        <select id="compCity"><option value="remote-in">Remote (anywhere in India)</option><option value="hyderabad">Hyderabad (hybrid)</option><option value="remote-global">Remote (global hours overlap)</option></select>
        <select id="compEquity"><option value="0">Base only</option><option value="mix">Base + meaningful equity / ESOPs</option><option value="equity">Stock-heavy (early stage)</option></select>
        <button class="btn primary" type="button" id="compGo">Show my ask →</button>
        <p class="comp-out" id="compOut"></p>
      </div>


      
      <div class="jdmatch reveal">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
          <b>🎯 JD-match score — before you apply, know the gap</b>
          <span class="jm-score" id="jmScore">—</span>
        </div>
        <p style="margin:6px 0 12px;font-size:13px;color:var(--muted)">Paste the job description. It's compared against my real skills &amp; track record — you'll see exactly which keywords I hit and which to address in the cover note.</p>
        <textarea id="jmJd" rows="6" style="width:100%;box-sizing:border-box;font:inherit;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--txt)" placeholder="Paste the JD here — same one as above works"></textarea>
        <div style="display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-top:10px">
          <button class="btn primary" type="button" id="jmGo">Score my fit →</button>
          <span style="font-size:12px;color:var(--muted)" id="jmNote"></span>
        </div>
        <div class="jm-out" id="jmOut" hidden>
          <div class="jm-bar"><i id="jmBar" style="width:0%"></i></div>
          <div class="jm-row"><b>Covered</b><span id="jmHit"></span></div>
          <div class="jm-row"><b>Gaps to address</b><span id="jmMiss"></span></div>
        </div>
      </div>



      <p class="reveal" style="margin-top:22px;color:var(--muted);font-size:13px;text-align:center">Generated from my real track record — no invented numbers. AI via Groq when available, smart template as fallback.</p>
    </div>
  </div>
\n  <div class=\"wrap\" style=\"text-align:center;margin-top:6px\"><a class=\"btn\" href=\"https://wa.me/917981719085?text=Hi%20Vamshidhar%2C%20I%20saw%20your%20pitch%20generator\" target=\"_blank\" rel=\"noopener noreferrer\">💬 WhatsApp</a> · <a class=\"btn\" href=\"tel:+917981719085\">📞 Call</a></div></section>
`;
---
<Base {...op}>
  <Fragment set:html={body} />
  <script is:inline>
    (function () {
      var bar = document.getElementById('stepbar');
      var prog = document.getElementById('sbProg');
      var nextBtn = document.getElementById('nextBtn');
      var backBtn = document.getElementById('backBtn');
      var genBtn = document.getElementById('genBtn');
      var f = document.getElementById('hireForm');
      if (!bar || !f) return;
      var step = 1;
      function getMode() { var on = f.querySelector('input[name=mode]:checked'); return on ? on.value : 'jd'; }
      function render() {
        var active = step >= 2 ? (step === 3 ? 'review' : (getMode() === 'quiz' ? 'quiz' : 'jd')) : 'mode';
        f.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.getAttribute('data-pane') !== active; });
        genBtn.hidden = step !== 3;
        nextBtn.hidden = step === 3;
        backBtn.hidden = step === 1;
        bar.querySelectorAll('.stepbar-item').forEach(function (b) { b.classList.toggle('on', +b.dataset.s <= step); });
        prog.style.width = (step * 33.2) + '%';
      }
      nextBtn.addEventListener('click', function () {
        if (step === 1) { step = 2; }
        else if (step === 2) {
          if (getMode() === 'jd') {
            var jd = f.querySelector('[name=jd]');
            if (!String(jd.value || '').trim()) { jd.focus(); return; }
          }
          step = 3;
        }
        render();
      });
      backBtn.addEventListener('click', function () { if (step > 1) step--; render(); });
      f.querySelectorAll('.qcard input').forEach(function (i) { i.addEventListener('change', function () { if (step === 2) render(); }); });

      var msg = document.getElementById('hmsg');
      var out = document.getElementById('hout');
      var subj = document.getElementById('hsubj'), hbody = document.getElementById('hbody'), hplan = document.getElementById('hplan');
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        genBtn.disabled = true; genBtn.textContent = 'Drafting — ~15s…';
        var body = {};
        new FormData(f).forEach(function (v, k) { if (v) body[k] = v; });
        body.mode = getMode();
        fetch('/api/coverletter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            subj.textContent = j.subject || 'Your pitch';
            hbody.textContent = j.email || j.error || '';
            hplan.innerHTML = (j.plan || []).map(function (p) { return '<li>' + String(p).replace(/&/g, '&amp;') + '</li>'; }).join('');
            var sm = encodeURIComponent(j.subject || ''), bd = encodeURIComponent((j.email || '') + '\n\n---\nFirst 30 days:\n' + (j.plan || []).map(function (p) { return '• ' + p; }).join('\n'));
            var g = document.getElementById('hmail');
            g.href = 'https://mail.google.com/mail/?view=cm&fs=1&to=&su=' + sm + '&body=' + bd;
            try { var mt2 = String(body.jd || '').match(/[^\n\r]{0,80}(?:marketing|growth|digital|seo|performance|paid)[^\n\r]{0,60}/i); var g2 = mt2 ? mt2[0].trim().slice(0, 90) : ''; } catch (e) { var g2 = ''; }
            window.__hireSaved = { jc: body.company || '', jt: g2 || '', subject: j.subject || '', email: j.email || '', plan: j.plan || [] };
            planCard();
            out.hidden = false;
            out.scrollIntoView({ behavior: 'smooth', block: 'start' });
            try { if (window.va) window.va('event', { name: 'hire_generated', label: getMode() }); } catch (e) {}
          })
          .catch(function () { msg.hidden = false; msg.className = 'formmsg err'; msg.textContent = 'Could not draft right now — email geovamshidhar@gmail.com for a tailored pitch.'; })
          .then(function () { genBtn.disabled = false; genBtn.textContent = 'Generate my pitch →'; });
      });
      window.__hireSaved = null;
      var hcard = document.getElementById('hplanCard'), hAts = document.getElementById('hAts'), hAtsJson = document.getElementById('hAtsJson');
      var planCard = function () {
        var h = window.__hireSaved; if (!h || !(h.plan && h.plan.length)) return;
        var co = String(h.jc || 'THE COMPANY').replace(/[^a-zA-Z0-9 ]/g, ' ').trim() || 'THE COMPANY';
        var q = ['co=' + encodeURIComponent(co.toUpperCase())]
          .concat((h.plan || []).slice(0, 6).map(function (p, i) { return 'l' + (i + 1) + '=' + encodeURIComponent(String(p).slice(0, 66)); }));
        hcard.href = '/api/og?p=plan&' + q.join('&');
        hcard.classList.remove('dim');
      };
      if (hcard) hcard.addEventListener('click', function () { try { if (window.va) window.va('event', { name: 'file_download', label: 'plan_card' }); } catch (e) {} });
      var hdl = document.getElementById('hplanDl');
      if (hdl) hdl.addEventListener('click', function () {
        var url = hcard ? hcard.href : '';
        if (!url || url.indexOf('/api/og') !== 0) return;
        try { if (window.va) window.va('event', { name: 'file_download', label: 'plan_card_png' }); } catch (e) {}
        fetch(url).then(function (r) { return r.blob(); }).then(function (b) {
          var a = document.createElement('a');
          a.href = URL.createObjectURL(b); a.download = 'vamshidhar-first-30-days.png';
          document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 800);
        }).catch(function () {});
      });
      function dl(name, mime, text) {
        var b = new Blob([text], { type: mime });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(b); a.download = name;
        document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 800);
      }
      if (hAts) hAts.addEventListener('click', function () {
        var h = window.__hireSaved; var role = (h && (h.jt || h.role)) || 'growth marketer';
        var txt = 'ROLE: ' + role + '\n' + (h && h.jc ? 'COMPANY: ' + h.jc + '\n' : '')
          + (h && h.jsalary ? 'SALARY EXP.: ' + h.jsalary + '\n' : '') + '\n'
          + 'VAMSHIDHAR REDDY M\nDigital Marketing & Growth | SEO | AI pipelines\ngeovamshidhar@gmail.com | +91 7981719085 | linkedin.com/in/vamshidharreddym | Hyderabad, India\nTrack record: ROAS 3.2x->5.5x | CPL -30% | +15% organic traffic | 70+ qualified leads/mo\n\n'
          + '------- PITCH ------\n' + (h ? h.email : '') + '\n\n------ FIRST 30 DAYS -----\n'
          + ((h && h.plan) || []).map(function (x) { return '- ' + x; }).join('\n') + '\n\n\n';
        dl('Vamshidhar_Reddy_M_ATS.txt', 'text/plain', txt);
        try { if (window.va) window.va('event', { name: 'file_download', label: 'ats_txt' }); } catch (e) {}
      });
      if (hAtsJson) hAtsJson.addEventListener('click', function () {
        var h = window.__hireSaved || {};
        dl('Vamshidhar_Reddy_M_ATS.json', 'application/json', JSON.stringify({
          updatedAt: new Date().toISOString(),
          candidate: { name: 'Vamshidhar Reddy M', email: 'geovamshidhar@gmail.com', phone: '+91-7981719085', location: 'Hyderabad, India (remote-ready)' },
          targetRole: h.jt || 'Digital Marketing', targetCompany: h.jc || '',
          salary: h.jsalary || '',
          pitch: { subject: h.subject || '', body: h.email || '' },
          first30Days: (h.plan || []),
          source: 'vamshidhar-pitch-generator'
        }, null, 2));
        try { if (window.va) window.va('event', { name: 'file_download', label: 'ats_json' }); } catch (e) {}
      });
      var cs = document.getElementById('compStage'), cc = document.getElementById('compCity'), ce = document.getElementById('compEquity'), co = document.getElementById('compGo'), cout = document.getElementById('compOut');
      if (co) co.addEventListener('click', function () {
        var stage = { startup: 0.84, growth: 1, enterprise: 1.16 }[cs.value] || 1;
        var city = { 'remote-in': 1, hyderabad: 1.05, 'remote-global': 1.2 }[cc.value] || 1;
        var eq = { '0': 1, mix: 0.88, equity: 0.72 }[ce.value] || 1;
        var cash = Math.round(9.5 * stage * city * eq);
        var txt2 = '₹' + cash + ' LPA base';
        if (ce.value === 'mix') txt2 += ' + options that matter (I’ll put a risk-adjusted number on them in the interview, not vague “competitive”).';
        else if (ce.value === 'equity') txt2 += ' + ESOPs as the upside driver — I’m comfortable when the equity is real and the KPI is mine.';
        else txt2 += ' fixed. No negotiation theatre, no wasted calls.';
        cout.textContent = txt2; cout.classList.add('on');
        try { if (window.va) window.va('event', { name: 'hire_generated', label: 'salary_compass' }); } catch (e) {}
      });
      var cp = document.getElementById('hcopy');
      if (cp) cp.addEventListener('click', function () {
        navigator.clipboard.writeText(hbody.textContent).then(function () { cp.textContent = 'Copied ✓'; setTimeout(function () { cp.textContent = 'Copy email'; }, 1500); }).catch(function () {});
      });
      var jmIn = document.getElementById('jmJd'), jmGo = document.getElementById('jmGo'), jmScore = document.getElementById('jmScore'), jmOut = document.getElementById('jmOut'), jmBar = document.getElementById('jmBar'), jmHit = document.getElementById('jmHit'), jmMiss = document.getElementById('jmMiss'), jmNote = document.getElementById('jmNote');
      var RESUME_TERMS = ['seo','technical seo','on-page','off-page','keyword','content','ppc','google ads','linkedin ads','meta ads','paid media','cpc','cpl','roas','ctr','conversion','cro','a/b','ab testing','creative','landing page','ga4','analytics','looker','tableau','data studio','search console','screaming frog','ahrefs','semrush','automation','ai','artificial intelligence','groq','prompt','llm','chatgpt','agent','workflow','lead generation','funnel','email','smm','social media','retention','ltv','cac','budget','growth','strategy','audit','dashboard','reporting','b2b','b2c','ecommerce','saas','api','typescript','next.js','supabase','vercel','razorpay','qualitative','quantitative'];
      if (jmGo) jmGo.addEventListener('click', function () {
        var jd = String(jmIn.value || '').toLowerCase();
        if (!jd.trim()) { jmNote.textContent = 'Paste a JD first.'; return; }
        jmNote.textContent = '';
        var found = [], missing = [];
        RESUME_TERMS.forEach(function (t) {
          if (jd.indexOf(t) > -1) found.push(t); else missing.push(t);
        });
        var total = RESUME_TERMS.length;
        var pct = Math.round((found.length / total) * 100);
        jmScore.textContent = pct + '%';
        jmScore.style.color = pct >= 70 ? 'var(--accent2)' : (pct >= 45 ? 'var(--accent)' : '#ff6b6b');
        jmBar.style.width = pct + '%';
        var hitTxt = found.length ? found.join(', ') : 'none of the tracked terms appear verbatim';
        var missPick = missing.slice(0, 14);
        jmHit.textContent = hitTxt;
        jmMiss.textContent = missPick.length ? missPick.join(', ') + (missing.length > 14 ? '…' : '') : 'none — strong overlap';
        jmOut.hidden = false;
        try { if (window.va) window.va('event', { name: 'hire_generated', label: 'jd_match' }); } catch (e) {}
      });
      render();
    })();
  </script>
</Base>