---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';

const op = {
  title: "Grapevine — Autonomous Reputation & Social Listening | Vamshidhar Reddy",
  description: "Grapevine is an autonomous reputation team: it scans live search and social for brand mentions, classifies sentiment, scores crisis risk, drafts on-brand replies, and builds a human escalation queue.",
  canonical: "https://vamshidharm.vercel.app/grapevine.html",
  ogImage: "",
  variant: 'sub',
  active: '/grapevine.html',
};
const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "What is Grapevine?", acceptedAnswer: { "@type": "Answer", text: "Grapevine is an autonomous reputation & social-listening team. Give it a brand and seven agents get to work: the Monitor scans live search and social for mentions, the Classify agent tags sentiment and urgency, the Crisis agent scores the risk, the Respond agent drafts on-brand replies, the Escalate agent builds a queue of what a human must see first, the Concierge moves the worst escalations into a private rescue channel with an SLA, and the Prophet forecasts the risk 4 hours out." } },
    { "@type": "Question", name: "Is the demo real?", acceptedAnswer: { "@type": "Answer", text: "Yes. The Monitor agent runs a real live web search for the brand, the Classify agent runs a real lexicon-based sentiment classifier over the actual mentions it found, the Crisis agent computes a real 0-100 risk score, replies are drafted by a real LLM (Groq), the escalation queue is ranked from the actual classified mentions, the Concierge pulls the real P0/P1 items into a rescue channel, and the Prophet fits a real regression to your watch history to forecast the score. No keys set? It still runs the same real tools and falls back to a rule-based plan for the thinking." } },
    { "@type": "Question", name: "How is Grapevine different from a social listening tool?", acceptedAnswer: { "@type": "Answer", text: "Listening tools show dashboards and charts. Grapevine is agentic — it doesn't just surface mentions, it reasons about them: it classifies each one, decides whether a spike is turning into a crisis, drafts a reply in your brand voice, tells your team exactly which items need a human right now, quietly rescues the most sensitive items in a private channel, and forecasts whether the risk is rising or cooling. You approve the big calls; the agents handle the watching." } },
    { "@type": "Question", name: "Where does a human still need to step in?", acceptedAnswer: { "@type": "Answer", text: "On judgement calls that have real downside: approving any public reply that could read as tone-deaf, brand-safety on sensitive mentions, legal/compliance edges, anything in the P0 escalation queue, and deciding on rescue-channel outreach. Grapevine handles the ~95% of monitoring and triage; the human owns the high-stakes replies." } }
  ]
});
const body = `<section class="lpage-wrap">
  <div class="wrap">
    <div class="ag-hero">
      <div class="ag-hero-copy">
        <span class="tag">Grapevine · Reputation AI</span>
        <h1>Grapevine — the reputation team that never sleeps</h1>
        <p style="color:var(--muted)">Social listening tells you what happened. <b style="color:var(--accent2)">Grapevine decides what to do about it.</b> Seven autonomous agents scan the web for your brand, classify every mention, detect a storm before it compounds, draft the replies, escalate what a human must see — then <b style="color:var(--accent2)">rescue the worst in a private channel</b> and <b style="color:var(--accent2)">forecast where the risk is heading</b>.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn primary btn-lg" href="#demo">▶ Run Grapevine</a>
          <a class="btn link-secondary" href="/agentic-ai.html">See Hive, the campaign agent →</a>
        </div>
      </div>
      <div class="ag-orbit" aria-hidden="true">
        <svg class="ag-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
          <line data-agent="monitor" x1="50" y1="50" x2="24" y2="14"></line>
          <line data-agent="classify" x1="50" y1="50" x2="74" y2="11"></line>
          <line data-agent="crisis" x1="50" y1="50" x2="9" y2="46"></line>
          <line data-agent="respond" x1="50" y1="50" x2="90" y2="44"></line>
          <line data-agent="escalate" x1="50" y1="50" x2="50" y2="84"></line>
          <line data-agent="concierge" x1="50" y1="50" x2="24" y2="84"></line>
          <line data-agent="prophet" x1="50" y1="50" x2="50" y2="22"></line>
        </svg>
        <div class="ag-core"><span>BRAND</span><i></i></div>
        <span class="ag-sat" data-agent="monitor" style="top:14%;left:24%;--agc:#49b6ff">📡</span>
        <span class="ag-sat" data-agent="classify" style="top:11%;left:74%;--agc:#8b7bff">🧠</span>
        <span class="ag-sat" data-agent="crisis" style="top:46%;left:9%;--agc:#ff6f6f">🚨</span>
        <span class="ag-sat" data-agent="respond" style="top:44%;left:90%;--agc:#ff9e5c">💬</span>
        <span class="ag-sat" data-agent="escalate" style="top:84%;left:50%;--agc:#ffd479">🛎</span>
        <span class="ag-sat" data-agent="concierge" style="top:84%;left:24%;--agc:#6ee7b7">🎧</span>
        <span class="ag-sat" data-agent="prophet" style="top:22%;left:50%;--agc:#c084fc">🔮</span>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">The team</span><h2 style="font-size:clamp(20px,3vw,26px)">Seven agents. One brand. Zero blind spots.</h2></div>
    <div class="ab-grid">
      <div class="ab-variant"><b>📡 Monitor Agent</b><span class="ag-persona">The Eavesdropper</span><p>Scans live search and social for every mention of your brand, everywhere it's discussed.</p></div>
      <div class="ab-variant"><b>🧠 Classify Agent</b><span class="ag-persona">The Judge</span><p>Tags each mention by sentiment, urgency and platform — so you see the signal, not the noise.</p></div>
      <div class="ab-variant"><b>🚨 Crisis Agent</b><span class="ag-persona">The Firefighter</span><p>Scores negative share, volume and severity into a 0-100 risk — and catches a storm early.</p></div>
      <div class="ab-variant"><b>💬 Respond Agent</b><span class="ag-persona">The Voice</span><p>Drafts warm, on-brand replies to the loudest mentions, positive and negative.</p></div>
      <div class="ab-variant"><b>🛎 Escalate Agent</b><span class="ag-persona">The Captain</span><p>Ranks what only a human should touch into a P0/P1/P2 queue.</p></div>
      <div class="ab-variant"><b>🎧 Concierge Agent</b><span class="ag-persona">The De-escalator</span><p>Moves the heaviest escalations into a private rescue channel with an SLA — quietly, before they blow up.</p></div>
      <div class="ab-variant"><b>🔮 Prophet Agent</b><span class="ag-persona">The Forecaster</span><p>Fits a trend line to your real watch history and forecasts the crisis score 4 hours out — with confidence.</p></div>
    </div>
  </div>

  <div class="wrap" id="demo" style="margin-top:44px;scroll-margin-top:90px">
    <div class="sec-head" style="margin-bottom:18px"><span class="tag">Live demo · Grapevine + live SERP</span><h2 style="font-size:clamp(22px,3.4vw,30px)">Put Grapevine on watch</h2>
    <p style="color:var(--muted);max-width:680px">Type a brand. The agents will scan live search, classify the mentions, score the risk, draft replies, build your escalation queue, rescue the worst items in a private channel and forecast the trajectory. Runs on Groq — no account, nothing stored beyond an anonymous counter.</p></div>
    <div class="ag-console">
        <div class="ag-input">
         <label for="brandInput">Your brand</label>
         <input id="brandInput" type="text" placeholder="e.g. an Indian D2C skincare brand" />
         <div class="ag-row">
           <label for="vsInput" style="font-size:12px;color:var(--muted)">vs (competitor)</label>
           <input id="vsInput" type="text" placeholder="optional: a rival brand to compare share of voice" />
         </div>
         <div class="ag-row">
           <select id="platformSel" multiple aria-label="Focus platform" title="Focus platform (Ctrl/Cmd to pick several; blank = site sweep)" size="2" style="width:100%;max-width:260px">
             <option value="" disabled>— site sweep —</option>
             <option value="reddit">Reddit</option>
             <option value="twitter">X / Twitter</option>
             <option value="facebook">Facebook</option>
             <option value="instagram">Instagram</option>
             <option value="youtube">YouTube</option>
             <option value="trustpilot">Trustpilot</option>
             <option value="glassdoor">Glassdoor</option>
           </select>
         </div>
         <div class="ag-runrow">
           <button id="runBtn" class="btn primary btn-lg" type="button">▶ Run Grapevine</button>
           <label class="ag-schedule" style="font-size:12px;color:var(--muted);align-items:center"><input type="checkbox" id="scheduleChk" style="margin-right:6px">Set daily watch</label>
           <span id="agMode" class="ag-mode" hidden></span>
           <span id="agSerp" class="ag-mode serp" hidden></span>
           <span id="histWrap" class="ag-histwrap" hidden>
             <label for="histSel">↻ Past watches</label>
             <select id="histSel" aria-label="Replay a past watch"><option value="">—</option></select>
           </span>
           <span class="ag-hint">Try: “an Indian D2C skincare brand” or “a SaaS project management tool”.</span>
         </div>
       </div>
      <div class="ag-stage" id="agStage" hidden>
        <div class="ag-orch" id="agOrch"></div>
        <div class="ag-agents" id="agAgents"></div>
        <div class="ag-log" id="agLog"></div>
      </div>
      <div class="ag-brief" id="agBrief" hidden></div>
      <div class="ag-share-row" id="agShareRow" hidden>
        <button type="button" class="btn" id="agCopyBtn">⧉ Copy briefing</button>
        <button type="button" class="btn" id="agShareBtn">🔗 Share</button>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:44px">
    <div class="ag-proof">
      <div class="ag-proof-copy">
        <span class="tag">Why Grapevine exists</span>
        <h2 style="font-size:clamp(20px,3vw,26px)">Reputation is decided before you see it</h2>
        <p style="color:var(--muted);max-width:640px">By the time a brand team opens the dashboard, the thread has already gone viral. Grapevine watches in real time, classifies instantly, and hands your team a drafted reply and a ranked queue — so the response time is minutes, not a crisis post-mortem.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn primary" href="/hire.html">Want this on your brand? Let's talk →</a>
          <a class="btn link-secondary" href="/agentic-ai.html">Meet Hive, the campaign agent</a>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:40px">
    <span class="tag">Common questions</span>
    <div style="display:grid;gap:10px;margin-top:16px;max-width:820px">
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">What exactly does each agent do?</summary><p style="color:var(--muted);margin-top:8px">Monitor scans live search + social for brand mentions; Classify tags sentiment/urgency/platform; Crisis scores the risk 0-100 and flags a storm early; Respond drafts on-brand replies; Escalate ranks what a human must see into a P0/P1/P2 queue; Concierge moves the worst escalations into a private rescue channel with an SLA; Prophet fits a regression to your watch history and forecasts the crisis score with confidence.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Can Grapevine reply on my real accounts?</summary><p style="color:var(--muted);margin-top:8px">Yes — that's the build. Behind the guardrails it connects to your social inboxes and review platforms, drafts replies, and a human approves before anything posts. This page is the safe, read-only showcase of the orchestration.</p></details>
      <details style="border:1px solid var(--border,#ffffff22);border-radius:12px;padding:14px"><summary style="font-weight:600;cursor:pointer">Where does agentic AI still need a human?</summary><p style="color:var(--muted);margin-top:8px">On brand-safety and tone: no agent posts a reply that could read as tone-deaf. Legal/compliance edges and any P0 escalation are human-owned. Grapevine handles the watching and triage; a person owns the high-stakes replies.</p></details>
    </div>
  </div>
</section>`;
---

<Base {...op}>
  <Fragment set:html={body} />
  <script type="application/ld+json" is:inline set:html={faqLd} />
  <LeadForm service="ai" serviceLabel="Reputation AI" promise="Want Grapevine watching your brand? I'll scope a guardrailed reputation team for your socials and review platforms — monitor to rescue, plus a crisis-forecast — and show you the first live briefing." />
  <script>
    const AGENT_META = {
      monitor: { icon: '📡', color: '#49b6ff', persona: 'The Eavesdropper' },
      classify: { icon: '🧠', color: '#8b7bff', persona: 'The Judge' },
      crisis: { icon: '🚨', color: '#ff6f6f', persona: 'The Firefighter' },
      respond: { icon: '💬', color: '#ff9e5c', persona: 'The Voice' },
      escalate: { icon: '🛎', color: '#ffd479', persona: 'The Captain' },
      concierge: { icon: '🎧', color: '#6ee7b7', persona: 'The De-escalator' },
      prophet: { icon: '🔮', color: '#c084fc', persona: 'The Forecaster' }
    };
    const STEP = 560, THINK = 560;
    const ALERT_SCORE = 60;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const $ = (id) => document.getElementById(id);

    async function type(el, text) {
      if (!el) return;
      if (reduce) { el.textContent = text; return; }
      el.textContent = '';
      for (let i = 0; i < text.length; i++) {
        el.textContent += text[i];
        await sleep(12);
      }
    }

    const runBtn = $('runBtn'), brandEl = $('brandInput'), vsEl = $('vsInput'), platformSel = $('platformSel'), scheduleChk = $('scheduleChk');
    const stage = $('agStage'), orch = $('agOrch'), agents = $('agAgents'), log = $('agLog'), brief = $('agBrief'), shareRow = $('agShareRow');
    const modeEl = $('agMode'), serpEl = $('agSerp'), histWrap = $('histWrap'), histSel = $('histSel');
    let tel = null, data = null, lastBrand = '';

    function telLine(t) {
      if (!t) return 'no LLM calls metered';
      const tok = ((t.prompt || 0) + (t.completion || 0));
      const toolN = (t.tools && t.tools.calls) || 0;
      const toolMs = (t.tools && t.tools.ms) || 0;
      return (t.prompt ? (t.calls + ' LLM calls · ' + tok.toLocaleString('en-IN') + ' tokens') : ('0 LLM calls')) + ' · ' + t.ms + 'ms LLM · ' + toolN + ' tools ' + toolMs + 'ms · ≈$' + ((t.cost || 0).toFixed(4)) + ' (est)';
    }

    function logLine(cls, html) {
      const d = document.createElement('div');
      d.className = 'ln';
      const t = new Date().toLocaleTimeString('en-IN', { hour12: false });
      d.innerHTML = '<span class="t">' + t + '</span> ' + (cls ? '<span class="' + cls + '">' + html + '</span>' : html);
      log.appendChild(d);
      log.scrollTop = log.scrollHeight;
    }

    function makeCard(a) {
      const card = document.createElement('div');
      card.className = 'ag-card';
      const id = (a.id || '').toLowerCase();
      card.setAttribute('data-agent', id);
      const meta = AGENT_META[id] || {};
      const icon = meta.icon || '🛰';
      if (meta.color) card.style.setProperty('--agc', meta.color);
      card.innerHTML =
        '<div class="ag-card-head">' +
          '<span class="ag-ico">' + icon + '</span>' +
          '<div><div class="ag-name">' + esc(a.name || 'Agent') + '</div><div class="ag-role">' + esc(a.role || '') + '</div>' + (meta.persona ? '<span class="ag-persona">' + esc(meta.persona) + '</span>' : '') + '</div>' +
          '<span class="ag-status">queued</span>' +
        '</div>' +
        '<div class="ag-live"></div>' +
        '<div class="ag-tools">' + (Array.isArray(a.tools) ? a.tools.map((t) => '<span>' + esc(t) + '</span>').join('') : '') + '</div>' +
        '<div class="ag-field think"><span class="k">Thinking</span><p></p></div>' +
        '<div class="ag-field act"><span class="k">Action</span><p></p></div>' +
        '<div class="ag-field out"><span class="k">Output</span><p></p></div>' +
        '<div class="ag-call"></div>' +
        '<div class="ag-handoff"></div>';
      const status = card.querySelector('.ag-status');
      const thinkP = card.querySelector('.ag-field.think p');
      const actP = card.querySelector('.ag-field.act p');
      const outP = card.querySelector('.ag-field.out p');
      const liveEl = card.querySelector('.ag-live');
      const callEl = card.querySelector('.ag-call');
      const handoffEl = card.querySelector('.ag-handoff');
      return { card, status, thinkP, actP, outP, liveEl, callEl, handoffEl };
    }

    // Compact offline fallback so the page still demos if the API is unreachable.
    function clientFallback(brand) {
      const b = String(brand || 'the brand').trim();
      const core = b.charAt(0).toUpperCase() + b.slice(1);
      const ag = (id, thinking, action, output, live, call, result) => ({ id, name: AGENT_META[id].name, persona: AGENT_META[id].persona, role: '', tools: [call], thinking, action, output, live, call, result, status: 'done' });
      return {
        mode: 'offline', brand: b,
        orchestrator: 'Monitor sweeps live search + social for "' + core + '", Classify tags every mention, Crisis scores the risk, Respond drafts replies, Escalate builds the human queue, Concierge rescues the worst in a private channel, Prophet forecasts the risk trajectory.',
        agents: [
          ag('monitor', 'Sweeps live search and social for every mention of "' + core + '".', 'Queries SERP for brand + review/complaint variants.', 'Mentions surfaced across the web — handed to Classify.', 'Scanning live mentions…', 'grapevine.scan', 'live mentions across platforms'),
          ag('classify', 'Tags each mention by sentiment, urgency and platform.', 'Runs the lexicon classifier over every scanned mention.', 'Sentiment split + urgent items tallied — handed to Crisis.', 'Tagging sentiment + urgency…', 'grapevine.sentiment', 'positive/negative/neutral split'),
          ag('crisis', 'Watches for a negative spike before it compounds.', 'Scores negative share, volume and severity into a 0-100 risk.', 'Risk level computed from the tally — handed to Respond.', 'Scoring the crisis level…', 'grapevine.crisis', 'risk score + level'),
          ag('respond', 'Answers the loudest mentions in the brand voice.', 'Drafts a warm public reply for the top positive + negative mentions.', 'Drafted replies queued — handed to Escalate.', 'Drafting on-brand replies…', 'grapevine.respond', 'drafted replies'),
          ag('escalate', 'Decides what only a human should touch.', 'Ranks negatives into a P0/P1/P2 action queue by urgency.', 'Escalation queue built for the team — Grapevine stands by.', 'Building the human queue…', 'grapevine.escalate', 'P0/P1/P2 escalation queue'),
          ag('concierge', 'Moves the worst escalations somewhere quiet before they compound.', 'Pulls P0/P1 items into a private rescue channel with an SLA.', 'Rescue channel opened — affected users DMed privately.', 'Rescuing heavy escalations…', 'grapevine.rescue', 'private rescue channel + SLA'),
          ag('prophet', 'Forecasts where the risk is heading next.', 'Fits a regression to the real watch history and projects the score.', 'Trend + confidence projected from past risk points.', 'Forecasting the crisis…', 'grapevine.predict', 'crisis forecast + confidence')
        ],
        briefing: 'Grapevine is now watching "' + core + '". It scanned mentions, classified sentiment, scored the crisis level, drafted replies, built a human escalation queue, opened a private rescue channel for the worst items and forecast where the risk is heading — so a brand-team can react in minutes, not days.',
        nextSteps: ['Approve the drafted replies for the top mentions', 'Assign the P0/P1 escalations to a human owner', 'Act on the Prophet forecast if the trend is rising', 'Set daily SERP watch on "' + core + '"'],
        mentions: [{ text: 'sample mention — "worst experience, terrible support"', platform: 'Reddit', sentiment: 'negative', urgency: 'high' }],
        crisis: { score: 45, level: 'elevated', negative: 1, total: 3 },
        topics: { top: [{ topic: 'refund', n: 1 }] },
        queue: [{ text: 'sample mention — "worst experience, terrible support"', platform: 'Reddit', priority: 'P1' }],
        drafts: [{ text: 'sample mention', platform: 'Reddit', sentiment: 'negative', reply: 'We hear you — DM us your details and we\'ll make it right today.', critic: { ready: 'post', risk: 'low', reason: '' } }],
        rescues: [{ text: 'sample mention — "worst experience, terrible support"', platform: 'Reddit', priority: 'P1', channel: 'DM', reason: 'Negative + high urgency → private de-escalation', sla: '4h' }],
        forecast: { ok: true, trend: 'rising', slope: 4.2, r2: 87, from: 45, horizon: [{ at: Date.now(), label: 'today', score: 45 }, { at: Date.now() + 86400000, label: 'day +1', score: 50 }, { at: Date.now() + 2 * 86400000, label: 'day +2', score: 56 }, { at: Date.now() + 3 * 86400000, label: 'day +3', score: 62 }], reference: { score: 50, level: 'elevated' } },
        telemetry: { calls: 0, ms: 0, cost: 0, tools: { calls: 0, ms: 0 } }
      };
    }

    function sentiBadge(s) {
      const c = s === 'negative' ? '#ff6f6f' : (s === 'positive' ? '#8affc1' : '#9aa0c0');
      return '<span class="ag-senti" style="color:' + c + ';border-color:' + c + '55">' + esc(s) + '</span>';
    }

    // Platform breakdown: tally mentions by platform into top rows with bars.
    function platformRows(mentions) {
      const map = {};
      (mentions || []).forEach(function (m) {
        const p = String(m.platform || 'Web');
        map[p] = (map[p] || 0) + 1;
      });
      const entries = Object.keys(map).map(function (p) { return { p: p, n: map[p] }; })
        .sort(function (a, b) { return b.n - a.n; }).slice(0, 7);
      const max = entries.length ? entries[0].n : 1;
      if (!entries.length) return '<div class="ag-hint">no mentions yet</div>';
      return entries.map(function (e) {
        return '<div class="ag-platrow"><span class="ag-platname">' + esc(e.p) + '</span><span class="ag-platbar"><i style="width:' + Math.max(8, Math.round((e.n / max) * 100)) + '%"></i></span><span class="ag-platn">' + e.n + '</span></div>';
      }).join('');
    }

    // Trend sparkline from the KV-persisted history series.
    function sparkline(history) {
      const pts = (history || []).filter(function (h) { return h && typeof h.score === 'number'; }).slice(-12);
      if (pts.length < 2) return '';
      const W = 120, H = 28, pad = 3;
      const lo = Math.min.apply(Math, pts.map(function (p) { return p.score; }));
      const hi = Math.max.apply(Math, pts.map(function (p) { return p.score; }));
      const rng = (hi - lo) || 1;
      const step = (W - pad * 2) / (pts.length - 1);
      const co = pts.map(function (p, i) {
        const x = pad + i * step;
        const y = H - pad - ((p.score - lo) / rng) * (H - pad * 2);
        return x.toFixed(1) + ',' + y.toFixed(1);
      });
      const last = pts[pts.length - 1].score;
      const col = last >= 60 ? '#ff6f6f' : (last >= 30 ? '#ffd479' : '#8affc1');
      return '<svg class="ag-spark" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="sentiment trend"><polyline points="' + co.join(' ') + '" fill="none" stroke="' + col + '" stroke-width="2"/></svg>';
    }

    function trendHtml(d) {
      const tr = d.trend || null;
      const hist = d.history || [];
      const spark = sparkline(hist);
      // Current watch readout so the block never looks empty on the first run.
      let now = '';
      const crisis = d.crisis || {};
      if (typeof crisis.score === 'number') {
        const col = crisis.score >= 60 ? '#ff6f6f' : (crisis.score >= 30 ? '#ffd479' : '#8affc1');
        now = '<div class="ag-trendnow"><span style="color:' + col + '">' + (crisis.score) + '/100</span> · ' + esc(crisis.level || 'normal') + '</div>';
      }
      let delta = '';
      if (tr && typeof tr.delta === 'number') {
        const up = tr.delta >= 0;
        if (tr.prevScore != null) {
          delta = '<div class="ag-trenddelta" style="color:' + (up ? '#ff6f6f' : '#8affc1') + '">' + (up ? '▲ ' : '▼ ') + 'crisis ' + (up ? '+' : '') + Math.abs(tr.delta) + ' pts vs last watch (' + tr.prevScore + ' → ' + (tr.prevScore + tr.delta) + ')</div>';
        }
      }
      const hint = (!spark && !delta)
        ? '<div class="ag-hint">run again to build history — trend appears after 2 watches' + (d.historySeeded ? '' : ' (persists when KV is configured)') + '</div>'
        : '<div class="ag-hint">' + (hist.length || 0) + ' watch' + ((hist.length || 0) === 1 ? '' : 'es') + ' recorded</div>';
      return now + spark + delta + hint;
    }

    function renderBrief(d) {
      const tally = d.tally || {};
      const total = tally.positive + tally.negative + tally.neutral || (d.mentions || []).length || 1;
      const crisis = d.crisis || {};
      const level = crisis.level || 'normal';
      const lvlColor = level === 'critical' ? '#ff6f6f' : (level === 'elevated' ? '#ffd479' : (level === 'watch' ? '#ff9e5c' : '#8affc1'));
      const bar = (n, c) => '<div style="height:10px;border-radius:6px;background:var(--bg2);overflow:hidden;margin-top:6px"><div style="height:100%;width:' + Math.min(100, Math.round((n / Math.max(total, 1)) * 100)) + '%;background:' + c + '"></div></div>';
      const mentions = (d.mentions || []).slice(0, 8).map((m) =>
        '<li>' + (m.platform ? '<b style="color:var(--muted)">' + esc(m.platform) + '</b> · ' : '') + sentiBadge(m.sentiment || 'neutral') + (m.urgency === 'high' ? ' <span class="ag-senti" style="color:#ff6f6f;border-color:#ff6f6f55">urgent</span>' : '') + '<p class="ag-brieftxt">' + esc(m.text || '') + '</p></li>'
      ).join('');
      // Topic/intent tags (LLM-classified) grouped by count.
      const topicsBlock = d.topics && (d.topics.top || []).length
        ? '<div class="blk"><b>Topics</b><div class="ag-topics">' + (d.topics.top || []).map((t) => '<span class="ag-topic">' + esc(t.topic) + ' ×' + t.n + '</span>').join('') + '</div></div>'
        : '';
      // Critic verdict badge per draft reply (ready-to-post / review / flagged).
      const critTag = (dd) => {
        const cr = dd.critic || null;
        if (!cr) return '';
        if (cr.ready === 'flagged') return ' <span class="ag-crit flag" title="' + esc(cr.reason || '') + '">⚠ flagged</span>';
        if (cr.ready === 'review') return ' <span class="ag-crit review" title="' + esc(cr.reason || '') + '">review</span>';
        return ' <span class="ag-crit post">ready</span>';
      };
      const approveBtn = (i, dd) => {
        const cr = dd.critic || {};
        const canApprove = cr.ready === 'post' || cr.ready === 'review';
        if (!d.runId) return '';
        const base = '<button type="button" class="btn ag-approve" data-reply="' + i + '" data-brand="' + esc(d.brand || '') + '" data-run="' + esc(d.runId || '') + '" title="send human verdict to KV">';
        return base + '✓ Approve</button>' + (canApprove ? '' : '<span class="ag-crit flag" style="margin-left:6px">hold — human review first</span>');
      };
      const drafts = (d.drafts || []).slice(0, 4).map((dd, i) =>
        '<li class="ag-draftli"><div class="ag-draftrow"><span class="ag-draft-senti">' + sentiBadge(dd.sentiment || 'neutral') + '</span><span class="ag-hint">' + esc(dd.platform || '') + '</span>' + critTag(dd) + approveBtn(i, dd) + '</div>' +
        '<textarea class="ag-draftta' + (dd.critic && dd.critic.ready !== 'post' ? ' ag-draftta-warn' : '') + '" rows="2" data-reply="' + i + '" placeholder="edit this draft reply…">' + esc(dd.reply || '') + '</textarea>' +
        '<button type="button" class="btn ag-draftcopy" data-reply="' + i + '">⧉ Copy reply</button></li>'
      ).join('');
      const queue = (d.queue || []).slice(0, 4).map((q) =>
        '<li><span class="ag-pri" style="color:' + (q.priority === 'P0' ? '#ff6f6f' : (q.priority === 'P1' ? '#ffd479' : '#9aa0c0')) + '">' + esc(q.priority || 'P2') + '</span> <b style="color:var(--muted)">' + esc(q.platform || '') + '</b> — ' + esc((q.text || '').slice(0, 120)) + '</li>'
      ).join('');
      // Meaningful empty states: a quiet conversation means NO escalations, not a broken block.
      const queueBody = (d.queue || []).length
        ? (queue || '<li>—</li>')
        : '<li class="ag-ok">No negative mentions flagged — nothing needs a human right now.</li>';
      // Concierge rescue block: the P0/P1 items pulled into a private channel with an SLA.
      const rescues = (d.rescues || []).slice(0, 4).map((r) =>
        '<li><span class="ag-pri" style="color:' + (r.priority === 'P0' ? '#ff6f6f' : '#ffd479') + '">' + esc(r.priority || 'P2') + '</span> <b style="color:var(--muted)">' + esc(r.platform || '') + '</b> → <span class="ag-hint">' + esc(r.channel || 'DM') + '</span> — ' + esc((r.dm || r.text || '').slice(0, 100)) + (r.sla ? ' <span class="ag-pri" style="color:#6ee7b7">⏱ ' + esc(r.sla) + '</span>' : '') + '</li>'
      ).join('');
      const rescueBlock = (d.rescues || []).length
        ? '<div class="blk ag-rescue"><b>🎧 Concierge · private rescues</b><ul class="ag-queue">' + rescues + '</ul><div class="ag-hint" style="margin-top:6px">Heavy escalations moved off the public feed to a private channel with an SLA — de-escalate before they compound.</div></div>'
        : '';
      // Prophet forecast block: real regression on watch history + projected horizon.
      let prophetBlock = '';
      if (d.forecast && d.forecast.trend) {
        const f = d.forecast, rising = f.trend === 'rising';
        const pts = Array.isArray(f.horizon) ? f.horizon : [];
        const next = pts.length ? pts[pts.length - 1].score : null;
        prophetBlock = '<div class="blk ag-prophet"><b>🔮 Prophet · crisis forecast</b>' +
          '<div class="ag-forecast"><span class="ag-fscur" style="color:' + lvlColor + '">' + (f.from != null ? f.from : '—') + '</span><i>→</i><span class="ag-fsnext" style="color:' + (rising ? '#ff6f6f' : '#6ee7b7') + '">' + (next != null ? next : '—') + '</span></div>' +
          '<div class="ag-fbar"><i style="width:' + Math.max(4, Math.min(100, (f.from || 0))) + '%"></i><u style="left:' + Math.max(4, Math.min(100, (next || 0))) + '%"></u></div>' +
          '<div class="ag-fdays"><span>today</span><span>day +1</span><span>day +2</span><span>day +3</span></div>' +
          '<div class="ag-hint" style="margin-top:6px">' + (rising ? '▲ trending up' : (f.trend === 'cooling' ? '▼ cooling' : '— steady')) + ' ' + (f.slope || 0) + ' pts/check · r² ' + (f.r2 != null ? f.r2 : '?') + '% confidence' + (f.reference ? ' · nearest past episode ' + (f.reference.score != null ? f.reference.score : '?') : '') + '</div></div>';
      }
      const platRows = platformRows(d.mentions || []);
      const trendB = '<div class="blk"><b>Momentum · last runs</b>' + trendHtml(d) + '</div>';
      // Competitor vs block: share of voice bar + negative split.
      const vsB = (d.vs && d.vs.competitor)
        ? '<div class="blk"><b>Share of voice vs ' + esc(d.vs.competitor) + '</b>' +
          '<div class="ag-vsbar"><i style="width:' + d.vs.sov + '%"></i></div>' +
          '<div class="ag-hint" style="margin-top:6px">' + d.vs.brand.mentions + ' mentions ' + (d.brand || '') + ' · ' + d.vs.rival.mentions + ' ' + esc(d.vs.competitor) + ' · ' + d.vs.brand.negative + ' vs ' + d.vs.rival.negative + ' negatives</div></div>'
        : '';
      // Storm drift banner + "what changed" delta line from the AI layer.
      let stormBanner = '';
      if (d.storm && d.storm.forming) {
        stormBanner = '<div class="ag-storm"><b>🚨 Storm forming</b> — crisis jumped ' + (d.storm.jump != null ? '+' + d.storm.jump : '') + ' pts (' + (d.storm.from != null ? d.storm.from : '?') + ' → ' + (d.storm.to != null ? d.storm.to : '?') + ')' + (d.storm.active ? ' · at critical level' : '') + '. Prioritise the P0 queue now.</div>';
      } else if (d.deltaText) {
        stormBanner = '<div class="ag-delta">📈 ' + esc(d.deltaText) + '</div>';
      }
      brief.innerHTML =
        '<div class="ag-plan-head"><h3>🛰 Grapevine briefing for: ' + esc(d.brand || '') + '</h3>' +
        '<div class="ag-actions"><button type="button" class="btn" id="agPdfBtn">⬇ PDF</button><button type="button" class="btn" id="agCsvBtn">⬇ CSV</button><button type="button" class="btn" id="agTtsBtn">🔊 Hear briefing</button></div></div>' +
        stormBanner +
        '<div class="grid">' +
          '<div class="blk"><b>Sentiment</b>' +
            '<div style="font-size:12px;margin-top:4px"><span style="color:#8affc1">▲ ' + (tally.positive || 0) + ' positive</span></div>' + bar(tally.positive || 0, '#2ff3c0') +
            '<div style="font-size:12px;margin-top:6px"><span style="color:#ff6f6f">▼ ' + (tally.negative || 0) + ' negative</span></div>' + bar(tally.negative || 0, '#ff6f6f') +
            '<div style="font-size:12px;margin-top:6px"><span style="color:#9aa0c0">— ' + (tally.neutral || 0) + ' neutral</span></div>' + bar(tally.neutral || 0, '#9aa0c0') +
            '<div class="ag-hint" style="margin-top:8px">' + (d.serpCount || 0) + ' live mentions scanned</div></div>' +
          '<div class="blk"><b>Crisis score</b><div class="ag-gauge" style="--aglv:' + lvlColor + '">' + (crisis.score != null ? crisis.score : '—') + '<i style="background:' + lvlColor + '">' + esc(level) + '</i></div>' +
            (crisis.negative != null ? '<div class="ag-hint" style="margin-top:8px">' + crisis.negative + '/' + crisis.total + ' mentions negative · volume ' + esc(crisis.vol || '') + '</div>' : '') + '</div>' +
          '<div class="blk"><b>Top platforms</b><div class="ag-plats">' + platRows + '</div></div>' +
          '<div class="blk"><b>Mentions</b><ul class="ag-mentions">' + (mentions || '<li>—</li>') + '</ul></div>' +
          '<div class="blk"><b>Drafted replies</b><ul class="ag-drafts">' + (drafts || '<li>—</li>') + '</ul></div>' +
          topicsBlock +
          '<div class="blk"><b>Human escalation queue</b><ul class="ag-queue">' + queueBody + '</ul></div>' +
          rescueBlock +
          prophetBlock +
          trendB +
          vsB +
        '</div>' +
        (d.briefing ? '<div class="ag-summary">' + esc(d.briefing) + '</div>' : '') +
        ((d.nextSteps || []).length ? '<div class="ag-summary"><b>Next steps:</b> ' + (d.nextSteps || []).map(function (s) { return '<span class="ag-hint">' + esc(s) + '</span>'; }).join(' &nbsp;→&nbsp; ') + '</div>' : '') +
        (d.telemetry ? '<div class="ag-tel"><b>Run telemetry:</b> ' + esc(telLine(d.telemetry)) + '</div>' : '');
      brief.hidden = false;
      shareRow.hidden = false;
      // Editable drafts: per-reply copy reads the (possibly edited) textarea value.
      Array.prototype.slice.call(document.querySelectorAll('.ag-draftcopy')).forEach(function (btn) {
        btn.addEventListener('click', function () {
          const ta = document.querySelector('.ag-draftta[data-reply="' + btn.getAttribute('data-reply') + '"]');
          copyText((ta && ta.value) ? ta.value : '').then(function () { btn.textContent = '✓ Copied'; setTimeout(function () { btn.textContent = '⧉ Copy reply'; }, 1600); }).catch(function () { btn.textContent = 'Copy failed'; });
        });
      });
      Array.prototype.slice.call(document.querySelectorAll('.ag-approve')).forEach(function (btn) {
        btn.addEventListener('click', function () {
          const ta = document.querySelector('.ag-draftta[data-reply="' + btn.getAttribute('data-reply') + '"]');
          const reply = (ta && ta.value) ? ta.value : '';
          const brand = btn.getAttribute('data-brand');
          const run = btn.getAttribute('data-run');
          const idx = btn.getAttribute('data-reply');
          fetch('/api/grapevine?sub=approve', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ brand: brand, runId: run, index: idx, reply: reply, verdict: 'approved' }) })
            .then(function (r) { return r.json(); })
            .then(function (j) { btn.textContent = j && j.ok ? '✓ Approved' : 'approval failed'; })
            .catch(function () { btn.textContent = 'approval failed'; });
        });
      });
      const copyBtn = $('agCopyBtn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          copyText(briefToText(d)).then(function () { copyBtn.textContent = '✓ Copied'; setTimeout(function () { copyBtn.textContent = '⧉ Copy briefing'; }, 1800); }).catch(function () { copyBtn.textContent = 'Copy failed'; });
        });
      }
      const shareBtn = $('agShareBtn');
      if (shareBtn) {
        shareBtn.addEventListener('click', function () {
          const h = '#{"brand":"' + encodeURIComponent(d.brand || '') + '"}';
          copyText(location.origin + location.pathname + h).then(function () { shareBtn.textContent = '✓ Link copied'; setTimeout(function () { shareBtn.textContent = '🔗 Share'; }, 1800); }).catch(function () { shareBtn.textContent = 'Copy failed'; });
        });
      }
      const pdfBtn = $('agPdfBtn');
      if (pdfBtn && d.runId) {
        pdfBtn.addEventListener('click', function () {
          pdfBtn.textContent = '⏳ Building…';
          fetch('/api/agentic/pdf', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ runId: d.runId }) })
            .then(function (r) {
              if (!r.ok) throw new Error('bad');
              return r.blob();
            }).then(function (blob) {
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a'); a.href = url; a.download = 'grapevine-briefing.pdf';
              document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
              pdfBtn.textContent = '⬇ PDF';
            }).catch(function () { pdfBtn.textContent = 'PDF failed'; });
        });
      }
      const ttsBtn = $('agTtsBtn');
      if (ttsBtn) {
        ttsBtn.addEventListener('click', async function () {
          const text = 'Grapevine briefing for ' + (d.brand || '') + '. ' + (d.briefing || '');
          ttsBtn.disabled = true;
          ttsBtn.textContent = '⏳ Preparing…';
          try {
            const r = await fetch('/api/agentic/tts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: text.slice(0, 1200), lang: 'en' }) });
            if (!r.ok) throw new Error('bad');
            const blob = await r.blob();
            const url = URL.createObjectURL(blob);
            const au = new Audio(url);
            const reset = function () { URL.revokeObjectURL(url); ttsBtn.disabled = false; ttsBtn.textContent = '🔊 Hear briefing'; };
            au.onended = reset;
            au.onerror = reset;
            ttsBtn.textContent = '🔈 Playing…';
            au.play();
          } catch (e) {
            ttsBtn.disabled = false;
            ttsBtn.textContent = '🔊 Hear briefing';
          }
        });
      }
      const csvBtn = $('agCsvBtn');
      if (csvBtn) {
        csvBtn.addEventListener('click', function () {
          const csv = briefCsv(d);
          const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'grapevine-briefing-' + String(d.brand || 'brand').replace(/[^\w-]+/g, '-').toLowerCase().slice(0, 40) + '.csv';
          document.body.appendChild(a); a.click(); document.body.removeChild(a);
          URL.revokeObjectURL(a.href);
        });
      }
      populateHist(d.brand);
    }

    function briefToText(d) {
      const L = [];
      L.push('SENTINEL BRIEFING: ' + (d.brand || ''));
      L.push('');
      (d.agents || []).forEach(function (a) {
        L.push('• ' + (a.name || 'Agent'));
        if (a.thinking) L.push('   thinking: ' + a.thinking);
        if (a.action) L.push('   action:   ' + a.action);
        if (a.output) L.push('   output:   ' + a.output);
        if (a.call) L.push('   tool:     ' + a.call + (a.result ? (' → ' + a.result) : ''));
      });
      L.push('');
      if (d.storm && d.storm.forming) L.push('STORM: crisis jumped ' + (d.storm.jump != null ? '+' + d.storm.jump : '') + ' pts — treat as forming crisis.');
      if (d.deltaText) L.push('DELTA: ' + d.deltaText);
      if (d.topics && d.topics.top) L.push('TOPICS: ' + (d.topics.top || []).map((t) => t.topic + ' ×' + t.n).join(', '));
      if (d.crisis) L.push('CRISIS: ' + (d.crisis.score != null ? d.crisis.score + '/100 ' : '') + (d.crisis.level || ''));
      (d.mentions || []).forEach(function (m) { L.push('MENTION [' + (m.platform || 'web') + '] (' + (m.sentiment || '') + '): ' + (m.text || '')); });
      (d.drafts || []).forEach(function (dd) { L.push('REPLY [' + (dd.sentiment || '') + ']' + (dd.critic ? ' {' + dd.critic.ready + (dd.critic.reason ? ': ' + dd.critic.reason : '') + '}' : '') + ': ' + (dd.reply || '')); });
      (d.queue || []).forEach(function (q) { L.push('ESCALATE (' + (q.priority || '') + '): ' + (q.text || '')); });
      (d.rescues || []).forEach(function (r) { L.push('RESCUE (' + (r.priority || '') + ' → ' + (r.channel || 'DM') + '): ' + (r.dm || r.text || '') + (r.sla ? ' (SLA ' + r.sla + ')' : '')); });
      if (d.forecast && d.forecast.trend) {
        const fpt = Array.isArray(d.forecast.horizon) ? d.forecast.horizon : [];
        const fnext = fpt.length ? fpt[fpt.length - 1].score : null;
        L.push('FORECAST: crisis ' + (d.forecast.trend === 'rising' ? 'rising' : (d.forecast.trend === 'cooling' ? 'cooling' : 'steady')) + ' ' + (d.forecast.from != null ? d.forecast.from + ' → ' : '') + (fnext != null ? fnext : '—') + ' · ' + (d.forecast.slope || 0) + ' pts/check · r² ' + (d.forecast.r2 != null ? d.forecast.r2 + '%' : '?'));
      }
      L.push('');
      if (d.briefing) L.push('BRIEFING: ' + d.briefing);
      return L.join('\n');
    }

    function briefCsv(d) {
      const csv = [];
      const escCell = (v) => { const s = String(v == null ? '' : v); return /\n|,|"/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
      const row = (...c) => csv.push(c.map(escCell).join(','));
      row('brand', d.brand || '');
      row('runId', d.runId || '');
      row('mode', d.mode || '');
      row('serp', (d.serpCount || 0) + ' live mentions');
      if (d.storm && d.storm.forming) row('storm', 'forming (+' + d.storm.jump + ' pts)');
      if (d.deltaText) row('delta', d.deltaText);
      if (d.topics && d.topics.top) row('topics', (d.topics.top || []).map((t) => t.topic + '=x' + t.n).join(' '));
      if (d.crisis) row('crisis_score', d.crisis.score != null ? d.crisis.score : '', 'crisis_level', d.crisis.level || '');
      if (d.tally) row('sentiment', 'positive=' + (d.tally.positive || 0), 'negative=' + (d.tally.negative || 0), 'neutral=' + (d.tally.neutral || 0));
      csv.push('');
      row('MENTIONS');
      row('platform', 'sentiment', 'urgency', 'topic', 'text');
      (d.mentions || []).forEach((m) => row(m.platform || 'web', m.sentiment || '', m.urgency || '', m.topic || '', m.text || ''));
      csv.push('');
      row('DRAFT REPLIES');
      row('sentiment', 'platform', 'critic', 'reply');
      (d.drafts || []).forEach((dd) => row(dd.sentiment || '', dd.platform || '', (dd.critic ? dd.critic.ready : '') || '', dd.reply || ''));
      csv.push('');
      row('ESCALATION QUEUE');
      row('priority', 'platform', 'text');
      (d.queue || []).forEach((q) => row(q.priority || '', q.platform || '', q.text || ''));
      csv.push('');
      if ((d.rescues || []).length) {
        row('CONCIERGE RESCUES');
        row('priority', 'platform', 'channel', 'sla', 'text');
        (d.rescues || []).forEach((r) => row(r.priority || '', r.platform || '', r.channel || 'DM', r.sla || '', r.text || ''));
        csv.push('');
      }
      if (d.forecast && d.forecast.trend) {
        const fpt = Array.isArray(d.forecast.horizon) ? d.forecast.horizon : [];
        const fnext = fpt.length ? fpt[fpt.length - 1].score : '';
        row('PROPHET FORECAST', 'trend', d.forecast.trend, 'from', d.forecast.from != null ? d.forecast.from : '', 'to_day3', fnext, 'slope', d.forecast.slope || 0, 'r2', d.forecast.r2 != null ? d.forecast.r2 : '');
      }
      csv.push('');
      if (d.briefing) row('BRIEFING', d.briefing);
      (d.nextSteps || []).forEach((s2, i) => row('next_step_' + (i + 1), s2));
      return '\uFEFF' + csv.join('\n');
    }

    // Populate the "past watches" dropdown for a brand from KV history.
    async function populateHist(brand) {
      if (!brand || !histWrap || !histSel) return;
      try {
        const r = await fetch('/api/grapevine?brand=' + encodeURIComponent(brand) + '&recent=1');
        if (!r.ok) throw new Error('bad');
        const j = await r.json();
        const runs = (j && j.runs) || [];
        histSel.innerHTML = '<option value="">—</option>';
        runs.forEach(function (run) {
          const when = new Date(run.at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', hour12: false });
          histSel.insertAdjacentHTML('beforeend', '<option value="' + esc(run.runId) + '">' + esc(when) + (run.runId === data.runId ? ' · current' : '') + '</option>');
        });
        histWrap.hidden = runs.length < 1;
        histSel.disabled = false;
      } catch (e) {
        histWrap.hidden = true;
      }
    }

    // Replay a stored run: /api/grapevine?run=<id> returns the full briefing JSON.
    async function replay(runId) {
      runBtn.disabled = true;
      runBtn.textContent = '⏳ Loading past watch…';
      try {
        const r = await fetch('/api/grapevine?run=' + encodeURIComponent(runId), { cache: 'no-store' });
        if (!r.ok) throw new Error('bad');
        const j = await r.json();
        if (!j || !Array.isArray(j.agents)) throw new Error('bad');
        data = j;
        if (modeEl) { modeEl.hidden = false; modeEl.className = 'ag-mode ai'; modeEl.textContent = '● REPLAYED WATCH'; }
        serpEl.hidden = true;
        logLine('a', 'replayed stored watch ' + runId);
        orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator:</b> ' + esc(j.orchestrator || 'Watching ' + (j.brand || 'the brand') + '…') + '</span>';
        renderBrief(j);
        populateHist(j.brand);
      } catch (e2) {
        logLine('a', 'replay failed — stored watch may have expired');
      } finally {
        runBtn.disabled = false;
        runBtn.textContent = '▶ Run again';
      }
    }

    if (histSel) histSel.addEventListener('change', function () {
      if (histSel.value) replay(histSel.value);
    });

    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(text);
      return new Promise(function (resolve, reject) {
        try {
          const ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          document.execCommand('copy'); document.body.removeChild(ta); resolve();
        } catch (e) { reject(e); }
      });
    }

    function reset() {
      agents.innerHTML = '';
      log.innerHTML = '';
      orch.innerHTML = '';
      brief.hidden = true;
      shareRow.hidden = true;
      if (modeEl) modeEl.hidden = true;
      if (serpEl) serpEl.hidden = true;
      if (histWrap) histWrap.hidden = true;
    }

    async function run() {
      const b = brandEl.value.trim();
      if (!b) { brandEl.focus(); brandEl.style.borderColor = 'var(--accent)'; return; }
      brandEl.style.borderColor = '';
      runBtn.disabled = true;
      runBtn.textContent = '⏳ Grapevine watching…';
      stage.hidden = false;
      reset();
      data = null;
      const platforms = platformSel && platformSel.selectedOptions ? Array.prototype.slice.call(platformSel.selectedOptions).filter(function (o) { return o.value; }).map(function (o) { return o.value; }) : (platformSel && platformSel.value ? [platformSel.value] : []);
      const vs = vsEl ? String(vsEl.value || '').trim().slice(0, 120) : '';
      const scheduleOn = scheduleChk ? !!scheduleChk.checked : false;
      try {
        const res = await fetch('/api/grapevine', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ brand: b, vs: vs || undefined, platform: platforms, stream: true })
        });
        if (!res.ok) throw new Error('bad');
        const reader = res.body.getReader();
        const dec = new TextDecoder();
        let buf = '';
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buf += dec.decode(value, { stream: true });
          let idx;
          while ((idx = buf.indexOf('\n')) >= 0) {
            const line = buf.slice(0, idx); buf = buf.slice(idx + 1);
            if (!line.trim()) continue;
            let ev = null;
            try { ev = JSON.parse(line); } catch (e) { continue; }
            if (ev.event === 'tool') {
              const ok = ev.exec && ev.exec.ok;
              logLine(ok ? 't' : 'a', (AGENT_META[ev.id] ? (AGENT_META[ev.id].icon + ' ') : '🛰 ') + '<b>' + esc(ev.tool || 'tool') + '</b> ' + (ok ? 'executed in ' + ev.exec.ms + 'ms' : 'failed — fallback used'));
            } else if (ev.event === 'serp') {
              if (ev.used) logLine('t', 'monitor grounded in live SERP (' + ev.count + ' results)');
            } else if (ev.event === 'metrics') {
              tel = ev.telemetry || null;
              logLine('m', 'metrics · ' + telLine(ev.telemetry));
            } else if (ev.event === 'orch') {
              if (ev.text) {
                orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator composing:</b> <span class="ag-orch-txt">' + esc(ev.text.slice(-360)) + '</span><span class="ag-orch-dims">…</span></span>';
                orch.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
              }
            } else if (ev.event === 'reflect') {
              logLine('t', (AGENT_META[ev.id] ? AGENT_META[ev.id].icon + ' ' : '') + 'observed real tool result — handoff updated');
            } else if (ev.event === 'plan' && ev.data && Array.isArray(ev.data.agents) && ev.data.agents.length) {
              data = ev.data;
            }
          }
        }
        if (!data) throw new Error('empty');
      } catch (e) {
        data = clientFallback(b);
        logLine('a', 'live API unreachable — using built-in planner');
      }

      if (modeEl) {
        modeEl.hidden = false;
        modeEl.className = 'ag-mode ' + (data.mode === 'ai' ? 'ai' : 'template');
        modeEl.textContent = data.mode === 'ai' ? '● LIVE LLM' : (data.mode === 'offline' ? '● OFFLINE DEMO' : '● RULE-BASED FALLBACK');
      }
      if (serpEl) {
        if (data.serpUsed) {
          serpEl.hidden = false;
          serpEl.textContent = '🔎 LIVE SERP · ' + (data.serpCount || 0) + ' results';
        } else {
          serpEl.hidden = true;
        }
      }

      orch.innerHTML = '<span class="ag-spark"></span><span><b>Orchestrator:</b> ' + esc(data.orchestrator || 'Watching ' + (data.brand || 'the brand') + '…') + '</span>';
      logLine('a', 'orchestrator: ' + esc(data.orchestrator || 'starting'));

      const seq = data.agents;
      for (let i = 0; i < seq.length; i++) {
        const a = seq[i];
        const id = (a.id || '').toLowerCase();
        const ui = makeCard(a);
        agents.appendChild(ui.card);
        requestAnimationFrame(() => ui.card.classList.add('show'));
        const sat = document.querySelector('.ag-sat[data-agent="' + id + '"]');
        const line = document.querySelector('.ag-lines line[data-agent="' + id + '"]');
        if (sat) sat.classList.add('on');
        if (line) line.classList.add('on');
        ui.status.textContent = 'thinking'; ui.status.className = 'ag-status thinking';
        ui.card.classList.add('active');
        const liveTxt = a.live || ((a.name || 'Agent') + ' working');
        logLine('a', (a.name || 'agent') + ' — ' + liveTxt);
        await type(ui.liveEl, liveTxt + '…');
        await sleep(THINK);
        ui.thinkP.textContent = '';
        await type(ui.thinkP, a.thinking || '');
        await sleep(STEP);
        ui.actP.textContent = a.action || '';
        ui.outP.textContent = a.output || '';
        ui.liveEl.textContent = liveTxt;
        ui.liveEl.classList.add('done');
        if (a.call && ui.callEl) {
          const exec = a.exec || null;
          const toolName = esc(a.call || (exec && exec.tool));
          if (exec && exec.ok) {
            ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + '</span><span class="ag-callres real">' + esc(a.result || '') + '</span><span class="ag-callms">' + exec.ms + 'ms</span>';
          } else if (exec && !exec.ok) {
            ui.callEl.innerHTML = '<span class="ag-calltool">⚙ ' + toolName + '</span><span class="ag-callres err">' + esc((exec.error || 'tool failed')) + '</span>';
          } else {
            ui.callEl.innerHTML = '<span class="ag-calltool">' + toolName + '</span> <span class="ag-callres">' + esc(a.result || '') + '</span>';
          }
        }
        ui.status.textContent = 'done'; ui.status.className = 'ag-status done';
        ui.card.classList.remove('active'); ui.card.classList.add('done');
        const next = seq[i + 1];
        if (next && ui.handoffEl) ui.handoffEl.innerHTML = '↓ hands off to ' + esc(next.name);
        logLine('', (a.name || 'agent') + ' → ' + esc((a.output || '').slice(0, 90)));
        await sleep(STEP * 0.35);
      }

      renderBrief(data);
      if (scheduleOn && vsEl) {
        try {
          const sr = await fetch('/api/grapevine?sub=schedule', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ brand: b, hours: 24 }) });
          const sj = await sr.json();
          logLine('a', sj && sj.scheduled ? ('daily watch scheduled for "' + b + '" — alert threshold: ' + ALERT_SCORE + ' or flagged draft') : 'schedule toggle skipped');
        } catch (e) { logLine('a', 'daily watch schedule failed'); }
      }
      runBtn.disabled = false;
      runBtn.textContent = '▶ Run again';
    }

    runBtn.addEventListener('click', run);
    brandEl.addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') run(); });

    // Deep-link: /grapevine.html#{"brand":...} auto-runs Grapevine; #{"runId":...} replays a stored watch.
    (function () {
      try {
        const h = location.hash && location.hash.length > 4 ? JSON.parse(decodeURIComponent(location.hash.slice(1))) : null;
        if (h && h.brand) {
          brandEl.value = String(h.brand).slice(0, 120);
          setTimeout(run, 350);
        } else if (h && h.runId && histSel) {
          histSel.value = String(h.runId).slice(0, 64);
          setTimeout(function () { replay(histSel.value); }, 350);
        }
      } catch (e) {}
    })();
  </script>
</Base>
